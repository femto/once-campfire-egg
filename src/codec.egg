// Encodings Rails and HTTP use: Base64 (strict and URL-safe), hex, form
// decoding, and Rack's escaping of cookie values.
uses alloc

const B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const HEX = "0123456789abcdef"

// Base64 with padding (Ruby's strict_encode64), at the end of out.
fn base64_encode(a: Allocator, inout out: Buf(u8), s: []u8) void {
    var i = 0
    while (i + 2 < @len(s)) {
        const n = (@as(i64, s[i]) << 16) | (@as(i64, s[i + 1]) << 8) | @as(i64, s[i + 2])
        a.push(&out, B64[(n >> 18) & 63])
        a.push(&out, B64[(n >> 12) & 63])
        a.push(&out, B64[(n >> 6) & 63])
        a.push(&out, B64[n & 63])
        i = i + 3
    }
    const rest = @len(s) - i
    if (rest == 1) {
        const n = @as(i64, s[i]) << 16
        a.push(&out, B64[(n >> 18) & 63])
        a.push(&out, B64[(n >> 12) & 63])
        a.append_str(&out, "==")
    } else if (rest == 2) {
        const n = (@as(i64, s[i]) << 16) | (@as(i64, s[i + 1]) << 8)
        a.push(&out, B64[(n >> 18) & 63])
        a.push(&out, B64[(n >> 12) & 63])
        a.push(&out, B64[(n >> 6) & 63])
        a.push(&out, '=')
    }
}

// The value of one Base64 character, either alphabet, or -1.
fn b64_value(c: u8) i64 {
    if (c >= 'A' and c <= 'Z') {
        return @as(i64, c - 'A')
    }
    if (c >= 'a' and c <= 'z') {
        return @as(i64, c - 'a') + 26
    }
    if (c >= '0' and c <= '9') {
        return @as(i64, c - '0') + 52
    }
    if (c == '+' or c == '-') {
        return 62
    }
    if (c == '/' or c == '_') {
        return 63
    }
    return -1
}

// Base64 in either alphabet, padded or not, at the end of out: false if s
// is not Base64.
fn base64_decode(a: Allocator, inout out: Buf(u8), s: []u8) bool {
    var n = @len(s)
    while (n > 0 and s[n - 1] == '=') {
        n = n - 1
    }
    if (@len(s) - n > 2 or n % 4 == 1) {
        return false
    }
    var acc = 0
    var bits = 0
    for (s[0..n]) |c| {
        const v = b64_value(c)
        if (v < 0) {
            return false
        }
        acc = ((acc << 6) | v) & 0xFFFFFF
        bits = bits + 6
        if (bits >= 8) {
            bits = bits - 8
            a.push(&out, @as(u8, (acc >> bits) & 255))
        }
    }
    return true
}

fn hex_encode(a: Allocator, inout out: Buf(u8), s: []u8) void {
    for (s) |c| {
        a.push(&out, HEX[@as(i64, c >> 4)])
        a.push(&out, HEX[@as(i64, c & 15)])
    }
}

fn hex_value(c: u8) i64 {
    if (c >= '0' and c <= '9') {
        return @as(i64, c - '0')
    }
    if (c >= 'a' and c <= 'f') {
        return @as(i64, c - 'a') + 10
    }
    if (c >= 'A' and c <= 'F') {
        return @as(i64, c - 'A') + 10
    }
    return -1
}

// application/x-www-form-urlencoded and cookie unescaping: + is a space and
// %XX a byte; a malformed % stays as it is.
fn unescape(a: Allocator, inout out: Buf(u8), s: []u8) void {
    var i = 0
    while (i < @len(s)) {
        const c = s[i]
        if (c == '+') {
            a.push(&out, ' ')
        } else if (c == '%' and i + 2 < @len(s) and hex_value(s[i + 1]) >= 0 and hex_value(s[i + 2]) >= 0) {
            a.push(&out, @as(u8, hex_value(s[i + 1]) * 16 + hex_value(s[i + 2])))
            i = i + 2
        } else {
            a.push(&out, c)
        }
        i = i + 1
    }
}

// Rack::Utils.escape (URI.encode_www_form_component): letters, digits and
// *-._ stay, a space is +, anything else %XX.
fn escape(a: Allocator, inout out: Buf(u8), s: []u8) void {
    for (s) |c| {
        if ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '*' or c == '-' or c == '.' or c == '_') {
            a.push(&out, c)
        } else if (c == ' ') {
            a.push(&out, '+')
        } else {
            a.push(&out, '%')
            a.push(&out, "0123456789ABCDEF"[@as(i64, c >> 4)])
            a.push(&out, "0123456789ABCDEF"[@as(i64, c & 15)])
        }
    }
}

// The value of name in a form body or a query string, decoded, or null.
fn form_value(a: Allocator, form: []u8, name: str) ?Buf(u8) {
    var i = 0
    while (i < @len(form)) {
        var end = i
        while (end < @len(form) and form[end] != '&') {
            end = end + 1
        }
        var eq = i
        while (eq < end and form[eq] != '=') {
            eq = eq + 1
        }
        var key: Buf(u8) = .empty
        unescape(a, &key, form[i..eq])
        const found = key == name
        a.free(key)
        if (found) {
            var v: Buf(u8) = .empty
            if (eq < end) {
                unescape(a, &v, form[eq + 1..end])
            }
            return v
        }
        i = end + 1
    }
    return null
}

// The raw value of the cookie called name in a Cookie header, or null.
fn cookie_value(a: Allocator, header: []u8, name: str) ?Buf(u8) {
    var i = 0
    while (i < @len(header)) {
        while (i < @len(header) and (header[i] == ' ' or header[i] == ';')) {
            i = i + 1
        }
        var end = i
        while (end < @len(header) and header[end] != ';') {
            end = end + 1
        }
        var eq = i
        while (eq < end and header[eq] != '=') {
            eq = eq + 1
        }
        if (eq < end and header[i..eq] == name) {
            var v: Buf(u8) = .empty
            unescape(a, &v, header[eq + 1..end])
            return v
        }
        i = end + 1
    }
    return null
}

// Equal bytes, taking as long whatever differs: for comparing a MAC.
fn same_secret(x: []u8, y: []u8) bool {
    if (@len(x) != @len(y)) {
        return false
    }
    var diff: u8 = 0
    var i = 0
    while (i < @len(x)) {
        diff = diff | (x[i] ^ y[i])
        i = i + 1
    }
    return diff == 0
}
