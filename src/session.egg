// Signing in: the users table, bcrypt, a new sessions row, and the signed
// session_token cookie that names it (Authentication in the Rails app).
uses alloc, rand, time

const sqlite = @import("sqlite.egg")
const codec = @import("codec.egg")
const crypto = @import("crypto.egg")
const cookie = @import("cookie.egg")
const tf = @import("timefmt.egg")

// has_secure_token's alphabet: SecureRandom.base58.
const BASE58 = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
const TOKEN_LENGTH = 24
// A real bcrypt digest (of nothing anyone uses), checked when there is no
// such user; once-campfire-rust uses the same one.
const DUMMY_DIGEST = "$2a$12$FiKmSp4UhLvSB4Sd/ZUjQunyKP6.NjDRHdr5LnKUVk.BUn4Mq12WS"

fn allow_login(db: sqlite.Db, clock: Clock, ip: []u8) !bool {
    const now = clock.now()
    var prune = try db.prepare("DELETE FROM egg_login_limits WHERE expires_at <= ?")
    defer prune.finalize()
    try prune.bind_int(1, now)
    while (try prune.next()) {}
    var st = try db.prepare("INSERT INTO egg_login_limits (ip, attempts, expires_at) VALUES (?, 1, ?) ON CONFLICT(ip) DO UPDATE SET attempts = MIN(attempts + 1, 11) RETURNING attempts")
    defer st.finalize()
    try st.bind(1, ip)
    try st.bind_int(2, now + 180 * tf.NS_PER_SEC)
    if (!try st.next()) { return error.Sql }
    const allowed = st.int(0) <= 10
    while (try st.next()) {}
    return allowed
}

// n random base58 characters, each from a byte below 232 (4 * 58), so all
// are equally likely.
fn base58(a: Allocator, rng: Random, n: i64) Buf(u8) {
    var out: Buf(u8) = .empty
    var bytes: Buf(u8) = a.alloc(64, 0)
    defer a.free(bytes)
    while (@len(out) < n) {
        rng.fill(&bytes)
        for (bytes) |b| {
            if (b < 232 and @len(out) < n) {
                a.push(&out, BASE58[@as(i64, b % 58)])
            }
        }
    }
    return out
}

// The active user with this email and password, or null. A missing user
// costs a bcrypt check too, as in Rails, so it takes as long as a wrong
// password.
fn authenticate(a: Allocator, db: sqlite.Db, email: []u8, password: []u8) !?i64 {
    if (@len(password) == 0) {
        return null
    }
    var st = try db.prepare("SELECT id, password_digest FROM users WHERE status = 0 AND email_address = ? LIMIT 1")
    defer st.finalize()
    try st.bind(1, email)
    if (!try st.next()) {
        _ = crypto.bcrypt_matches(a, password, DUMMY_DIGEST)
        return null
    }
    const digest = st.text(a, 1)
    defer a.free(digest)
    if (!crypto.bcrypt_matches(a, password, digest)) {
        return null
    }
    return st.int(0)
}

// A new session for the user: its token.
fn start(a: Allocator, db: sqlite.Db, clock: Clock, rng: Random, user: i64, ip: []u8, user_agent: []u8) !Buf(u8) {
    const token = base58(a, rng, TOKEN_LENGTH)
    errdefer a.free(token)
    var now: Buf(u8) = .empty
    defer a.free(now)
    tf.db_time(a, &now, clock.now())
    var st = try db.prepare("INSERT INTO sessions (created_at, ip_address, last_active_at, token, updated_at, user_agent, user_id) VALUES (?, ?, ?, ?, ?, ?, ?)")
    defer st.finalize()
    try st.bind(1, now)
    try st.bind(2, ip)
    try st.bind(3, now)
    try st.bind(4, token)
    try st.bind(5, now)
    try st.bind(6, user_agent)
    try st.bind_int(7, user)
    while (try st.next()) {}
    return token
}

// The Set-Cookie header for a session: cookies.signed.permanent, which
// expires in 20 years, HttpOnly, SameSite=Lax.
fn set_cookie(a: Allocator, inout out: Buf(u8), key: []u8, clock: Clock, token: []u8) void {
    const expires = tf.add_years(clock.now(), 20)
    const value = cookie.sign(a, key, "session_token", token, expires)
    defer a.free(value)
    a.append_str(&out, "Set-Cookie: session_token=")
    a.append_str(&out, value)
    a.append_str(&out, "; path=/; expires=")
    tf.http_date(a, &out, expires)
    a.append_str(&out, "; httponly; samesite=lax\r\n")
}

fn terminate(a: Allocator, db: sqlite.Db, key: []u8, clock: Clock, header: []u8, user: i64, endpoint: []u8) !void {
    const raw = codec.cookie_value(a, header, "session_token") orelse { return }
    defer a.free(raw)
    const token = cookie.verify(a, key, "session_token", raw, clock.now()) orelse { return }
    defer a.free(token)
    var st = try db.prepare("DELETE FROM sessions WHERE token = ? AND user_id = ?")
    defer st.finalize()
    try st.bind(1, token)
    try st.bind_int(2, user)
    while (try st.next()) {}
    if (@len(endpoint) > 0) {
        var subscription = try db.prepare("DELETE FROM push_subscriptions WHERE endpoint = ? AND user_id = ?")
        defer subscription.finalize()
        try subscription.bind(1, endpoint)
        try subscription.bind_int(2, user)
        while (try subscription.next()) {}
    }
}

// ApplicationCable::Connection's current_user: the user of the session the
// Cookie header names, whatever the user's status; null if none.
fn cable_user(a: Allocator, db: sqlite.Db, key: []u8, clock: Clock, header: []u8) !?i64 {
    const raw = codec.cookie_value(a, header, "session_token") orelse {
        return null
    }
    defer a.free(raw)
    const token = cookie.verify(a, key, "session_token", raw, clock.now()) orelse {
        return null
    }
    defer a.free(token)
    var st = try db.prepare("SELECT users.id FROM sessions JOIN users ON users.id = sessions.user_id WHERE sessions.token = ? LIMIT 1")
    defer st.finalize()
    try st.bind(1, token)
    if (try st.next()) {
        return st.int(0)
    }
    return null
}

// The user whose session the Cookie header names, or null.
fn current_user(a: Allocator, db: sqlite.Db, key: []u8, clock: Clock, header: []u8) !?i64 {
    const raw = codec.cookie_value(a, header, "session_token") orelse {
        return null
    }
    defer a.free(raw)
    const token = cookie.verify(a, key, "session_token", raw, clock.now()) orelse {
        return null
    }
    defer a.free(token)
    var st = try db.prepare("SELECT users.id FROM sessions JOIN users ON users.id = sessions.user_id WHERE sessions.token = ? AND users.status = 0 LIMIT 1")
    defer st.finalize()
    try st.bind(1, token)
    if (try st.next()) {
        return st.int(0)
    }
    return null
}
