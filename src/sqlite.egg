// SQLite bindings: the C API stays in this unsafe file, and the rest of the
// app gets Db and Stmt, which hold no pointer it can touch. Started from
// egg's examples/ffi/sqlite.
//
// Handles (sqlite3 *, sqlite3_stmt *) are opaque, so they cross as *u8.
// Text goes in by pointer and length, and comes out the same way.
uses alloc
allow unsafe
link "sqlite3"

extern fn sqlite3_open_v2(path: *u8, db: **u8, flags: i32, vfs: *u8) i32
extern fn sqlite3_close_v2(db: *u8) i32
extern fn sqlite3_busy_timeout(db: *u8, ms: i32) i32
extern fn sqlite3_prepare_v3(db: *u8, sql: *u8, n: i32, flags: u32, stmt: **u8, tail: **u8) i32
extern fn sqlite3_bind_text(stmt: *u8, i: i32, text: *u8, n: i32, destructor: *u8) i32
extern fn sqlite3_bind_int64(stmt: *u8, i: i32, v: i64) i32
extern fn sqlite3_bind_null(stmt: *u8, i: i32) i32
extern fn sqlite3_step(stmt: *u8) i32
extern fn sqlite3_reset(stmt: *u8) i32
extern fn sqlite3_clear_bindings(stmt: *u8) i32
extern fn sqlite3_finalize(stmt: *u8) i32
extern fn sqlite3_column_int64(stmt: *u8, i: i32) i64
extern fn sqlite3_column_text(stmt: *u8, i: i32) *u8
extern fn sqlite3_column_bytes(stmt: *u8, i: i32) i32
extern fn sqlite3_column_type(stmt: *u8, i: i32) i32
extern fn sqlite3_last_insert_rowid(db: *u8) i64
extern fn sqlite3_changes(db: *u8) i32
extern fn sqlite3_errmsg(db: *u8) *u8

const OK: i32 = 0
const ROW: i32 = 100
const DONE: i32 = 101
const NULL_TYPE: i32 = 5
// SQLITE_OPEN_READWRITE | SQLITE_OPEN_NOMUTEX: one connection per thread,
// so SQLite need not lock it.
const OPEN_FLAGS: i32 = 0x2 | 0x8000
// SQLITE_PREPARE_PERSISTENT: the statement is kept for many runs.
const PREPARE_PERSISTENT: u32 = 0x1

// A statement prepare made, kept for the next time the same text comes:
// the program's SQL is string literals, so their addresses name them. The
// entries live as long as the connection's thread (a.create memory is not
// freed); there is one per literal.
const Entry = struct {
    key: i64
    len: i64
    stmt: *u8
    // In use by a Stmt not yet finalized; the same SQL run inside its own
    // loop then gets a statement of its own.
    busy: bool
    next: *Entry
}

const Cache = struct {
    a: Allocator
    first: *Entry
}

const Db = owned struct {
    handle: *u8
    cache: *Cache

    fn close(sink self: Db) void {
        var e = self.cache.*.first
        while (e != null) {
            _ = sqlite3_finalize(e.*.stmt)
            e = e.*.next
        }
        _ = sqlite3_close_v2(self.handle)
        @forget(self)
    }

    // A statement for sql, to bind and step; finalize hands it back, reset,
    // for the next prepare of the same text.
    fn prepare(self: Db, sql: str) !Stmt {
        const key = @as(i64, @intFromPtr(@strPtr(sql)))
        var e = self.cache.*.first
        while (e != null) {
            if (e.*.key == key and e.*.len == @len(sql)) {
                if (e.*.busy) {
                    break
                }
                e.*.busy = true
                return Stmt{ .handle = e.*.stmt, .entry = e }
            }
            e = e.*.next
        }
        var st: *u8 = null
        if (sqlite3_prepare_v3(self.handle, @strPtr(sql), @as(i32, @len(sql)), PREPARE_PERSISTENT, &st, null) != OK) {
            return error.Sql
        }
        if (e != null) {
            // Already in use: this one is finalized when done.
            return Stmt{ .handle = st, .entry = null }
        }
        const fresh = self.cache.*.a.create(Entry{ .key = key, .len = @len(sql), .stmt = st, .busy = true, .next = self.cache.*.first })
        self.cache.*.first = fresh
        return Stmt{ .handle = st, .entry = fresh }
    }

    // prepare for SQL the program built.
    fn prepare_text(self: Db, sql: []u8) !Stmt {
        var st: *u8 = null
        if (sqlite3_prepare_v3(self.handle, @strPtr(sql), @as(i32, @len(sql)), 0, &st, null) != OK) {
            return error.Sql
        }
        return Stmt{ .handle = st, .entry = null }
    }

    // Run sql that returns no rows (PRAGMA, BEGIN, ...).
    fn exec(self: Db, sql: str) !void {
        var st = try self.prepare(sql)
        defer st.finalize()
        while (try st.next()) {}
    }

    fn last_id(self: Db) i64 {
        return sqlite3_last_insert_rowid(self.handle)
    }

    fn changes(self: Db) i64 {
        return @as(i64, sqlite3_changes(self.handle))
    }

    // The last error, as SQLite words it.
    fn errmsg(self: Db, a: Allocator) Buf(u8) {
        return a.str_from_c(sqlite3_errmsg(self.handle))
    }
}

const Stmt = owned struct {
    handle: *u8
    // The cache's entry, or null for a statement of its own.
    entry: *Entry

    // Bind text to parameter i (from 1). SQLite copies it
    // (SQLITE_TRANSIENT, the destructor -1).
    fn bind(inout self: Stmt, i: i32, s: []u8) !void {
        const transient = @ptrFromInt(*u8, 18446744073709551615)
        if (sqlite3_bind_text(self.handle, i, @strPtr(s), @as(i32, @len(s)), transient) != OK) {
            return error.Sql
        }
    }

    fn bind_int(inout self: Stmt, i: i32, v: i64) !void {
        if (sqlite3_bind_int64(self.handle, i, v) != OK) {
            return error.Sql
        }
    }

    fn bind_null(inout self: Stmt, i: i32) !void {
        if (sqlite3_bind_null(self.handle, i) != OK) {
            return error.Sql
        }
    }

    // Move to the next row: true if there is one, false when done.
    fn next(inout self: Stmt) !bool {
        const rc = sqlite3_step(self.handle)
        if (rc == ROW) {
            return true
        }
        if (rc != DONE) {
            return error.Sql
        }
        return false
    }

    // Ready to run again, with no parameters bound.
    fn reset(inout self: Stmt) void {
        _ = sqlite3_reset(self.handle)
        _ = sqlite3_clear_bindings(self.handle)
    }

    // Column i (from 0) of the current row.
    fn int(self: Stmt, i: i32) i64 {
        return sqlite3_column_int64(self.handle, i)
    }

    fn is_null(self: Stmt, i: i32) bool {
        return sqlite3_column_type(self.handle, i) == NULL_TYPE
    }

    // Column i as text, at the end of out. NULL adds nothing. SQLite's
    // bytes last only until the next step, so they are copied.
    fn append_text(self: Stmt, a: Allocator, inout out: Buf(u8), i: i32) void {
        const p = sqlite3_column_text(self.handle, i)
        const n = @as(i64, sqlite3_column_bytes(self.handle, i))
        if (p != null and n > 0) {
            a.append_str(&out, @sliceFromPtr(p, n))
        }
    }

    // Column i as text, copied. NULL reads as "".
    fn text(self: Stmt, a: Allocator, i: i32) Buf(u8) {
        var out: Buf(u8) = .empty
        self.append_text(a, &out, i)
        return out
    }

    fn finalize(sink self: Stmt) void {
        if (self.entry != null) {
            _ = sqlite3_reset(self.handle)
            _ = sqlite3_clear_bindings(self.handle)
            self.entry.*.busy = false
        } else {
            _ = sqlite3_finalize(self.handle)
        }
        @forget(self)
    }
}

// Open the database at path, read-write, waiting up to 5 s on a lock
// another connection holds.
fn open(a: Allocator, path: []u8) !Db {
    const name = a.concat(path, "\0")
    defer a.free(name)
    var h: *u8 = null
    const rc = sqlite3_open_v2(@strPtr(name), &h, OPEN_FLAGS, null)
    if (rc != OK) {
        _ = sqlite3_close_v2(h)
        return error.Open
    }
    _ = sqlite3_busy_timeout(h, 5000)
    return Db{ .handle = h, .cache = a.create(Cache{ .a = a, .first = null }) }
}
