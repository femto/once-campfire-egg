// ONCE Campfire in Egg. A fixed pool of worker threads takes connections
// from a queue; each worker has its own SQLite connection, since threads
// share nothing.
uses alloc, args, fs, net, rand, thread, time, io

const text = @import("std/text")
const http = @import("http.egg")
const app = @import("app.egg")
const sqlite = @import("sqlite.egg")
const setup = @import("setup.egg")
const cable = @import("cable.egg")
const turbo = @import("turbo.egg")
const push = @import("push.egg")
const crypto = @import("crypto.egg")
const codec = @import("codec.egg")
const sys = @import("sys.egg")

const Worker = owned struct {
    t: Thread

    fn deinit(sink self: Worker) void {
        self.t.join()
        @forget(self)
    }
}

fn serve(c: TcpConn, a: Allocator, inout ctx: app.Context) !void {
    var served = 0
    while (true) {
        const req = (http.read_request(c, a, served) catch |e| {
            if (e == error.BodyTooLarge) { return http.write_response(c, a, "413 Payload Too Large", "Content-Type: text/plain\r\n", "Uploads are limited to 32 MB", false) }
            if (e == error.BadRequest) { return http.write_response(c, a, "400 Bad Request", "", "", false) }
            return e
        }) orelse { return }
        defer req.deinit(a)
        served = served + 1
        if (!try app.handle(c, a, &ctx, req) or !req.keep) {
            return
        }
    }
}

fn work(sink jobs: Receiver(TcpConn), sink lock_rx: Receiver(bool), sink lock_tx: Sender(bool), sink cable_tx: Sender(cable.Upgrade), sink hub_tx: Sender(cable.Cmd), io: Io, a: Allocator, clock: Clock, rng: Random, files: Fs, cfg: app.Config) void {
    defer jobs.close()
    var ctx = app.open(a, cfg, clock, rng, files, lock_rx, lock_tx, cable_tx, hub_tx) catch |e| {
        io.eprint("cannot open ", cfg.db_path, ": ", @errorName(e))
        return
    }
    defer ctx.close(a)
    while (jobs.recv()) |c| {
        defer c.close()
        serve(c, a, &ctx) catch |e| {
            // A peer closing its connection is no news; anything else is.
            if (e != error.Closed and e != error.IoFailed and e != error.ConnectionReset) {
                io.eprint("request failed: ", @errorName(e))
            }
            continue
        }
    }
}

// WAL checkpoints, off the writers' path (they no longer checkpoint on
// commit): a PASSIVE one every 100 ms, which copies what it can while
// writes go on, and once the WAL holds 10,000 pages (about 40 MB), a
// RESTART one at the write lock, so the WAL starts over; as the Rust app's
// checkpointer and writer do.
fn checkpointer(sink lock_rx: Receiver(bool), sink lock_tx: Sender(bool), io: Io, a: Allocator, threads: Threads, db_path: str) void {
    defer lock_rx.close()
    defer lock_tx.close()
    const db = sqlite.open(a, db_path) catch |e| {
        io.eprint("cannot open the checkpointer's connection: ", @errorName(e))
        return
    }
    defer db.close()
    const pause = threads.channel(bool, 1)
    defer pause.close()
    const awake = pause.sender()
    defer awake.close()
    while (true) {
        _ = pause.recv_timeout(100)
        const pages = sqlite.checkpoint_passive(db) catch |e| {
            io.eprint("checkpoint failed: ", @errorName(e))
            continue
        }
        if (pages >= 10000) {
            _ = lock_rx.recv()
            sqlite.checkpoint_restart(db) catch |e| { io.eprint("checkpoint failed: ", @errorName(e)) }
            lock_tx.send(true)
        }
    }
}

// Isolated background HTTP delivery; its own DB connection and caches.
fn webhook_work(sink lock_rx: Receiver(bool), sink lock_tx: Sender(bool), sink cable_tx: Sender(cable.Upgrade), sink hub_tx: Sender(cable.Cmd), io: Io, a: Allocator, threads: Threads, clock: Clock, rng: Random, files: Fs, cfg: app.Config) void {
    var ctx = app.open(a, cfg, clock, rng, files, lock_rx, lock_tx, cable_tx, hub_tx) catch |e| {
        io.eprint("cannot open webhook worker: ", @errorName(e))
        return
    }
    defer ctx.close(a)
    const pause = threads.channel(bool, 1)
    defer pause.close()
    const awake = pause.sender()
    defer awake.close()
    while (true) {
        const delivered = app.deliver_webhook(a, &ctx) catch |e| {
            io.eprint("webhook delivery failed: ", @errorName(e))
            _ = pause.recv_timeout(1000)
            continue
        }
        const pushed = app.deliver_push(a, &ctx) catch |e| {
            io.eprint("push delivery failed: ", @errorName(e))
            _ = pause.recv_timeout(1000)
            continue
        }
        if (!delivered and !pushed) { _ = pause.recv_timeout(100) }
    }
}

// The database's directory and file if there are none, and the schema in
// it (see setup).
fn prepare_database(a: Allocator, files: Fs, clock: Clock, path: str) !void {
    var dir_end = @len(path)
    while (dir_end > 0 and path[dir_end - 1] != '/') {
        dir_end = dir_end - 1
    }
    if (dir_end > 1) {
        make_dirs(files, path[0..dir_end - 1])
    }
    const db = try sqlite.create(a, path)
    defer db.close()
    try setup.prepare(a, db, clock)
}

// mkdir -p: each directory of path that is missing.
fn make_dirs(files: Fs, path: []u8) void {
    var i = 1
    while (i <= @len(path)) {
        if (i == @len(path) or path[i] == '/') {
            files.make_dir(path[0..i]) catch {}
        }
        i = i + 1
    }
}

fn main(io: Io, args: Args, net: Net, a: Allocator, threads: Threads, clock: Clock, rng: Random, files: Fs) !void {
    const port_text = args.env("HTTP_PORT") orelse "3000"
    const port = text.parse_int(port_text) orelse -1
    if (port < 0 or port > 65535) {
        io.eprint("bad HTTP_PORT: ", port_text)
        return
    }
    const workers = text.parse_int(args.env("CAMPFIRE_WORKERS") orelse "32") orelse 32
    const storage = args.env("CAMPFIRE_STORAGE_PATH") orelse "storage"
    const default_db = a.concat(storage, "/db/production.sqlite3")
    const db_path = args.env("CAMPFIRE_DATABASE_PATH") orelse a.leak(default_db)
    a.free(default_db)
    const secret = args.env("SECRET_KEY_BASE") orelse {
        io.eprint("SECRET_KEY_BASE is not set")
        return
    }
    // Active Storage's files, as the benchmark mounts them beside the db.
    const default_files = a.concat(storage, "/files")
    const files_dir = args.env("CAMPFIRE_FILES_PATH") orelse a.leak(default_files)
    a.free(default_files)
    // db:prepare: a fresh install starts from an empty database.
    prepare_database(a, files, clock, db_path) catch |e| {
        io.eprint("cannot prepare ", db_path, ": ", @errorName(e))
        return
    }
    var private_key: Buf(u8) = .empty
    defer a.free(private_key)
    if (args.env("VAPID_PRIVATE_KEY")) |encoded| {
        if (!codec.base64_decode(a, &private_key, encoded)) { return error.InvalidVapid }
    } else { a.free(@replace(&private_key, crypto.derive_key(a, secret, "campfire/vapid", 32))) }
    const public_key = try push.public_key(a, private_key)
    defer a.free(public_key)
    // The configured key may be Base64 in either alphabet, padded or not;
    // pages show it as given, as Rails and Rust do.
    var shown = a.concat(public_key, "")
    defer a.free(shown)
    if (args.env("VAPID_PUBLIC_KEY")) |configured| {
        var ours: Buf(u8) = .empty
        defer a.free(ours)
        var theirs: Buf(u8) = .empty
        defer a.free(theirs)
        if (!codec.base64_decode(a, &ours, public_key) or !codec.base64_decode(a, &theirs, configured) or ours != theirs) { return error.InvalidVapid }
        a.free(@replace(&shown, a.concat(configured, "")))
    }
    const cfg = app.Config{
        .db_path = db_path,
        .secret = secret,
        .vapid = a.leak(shown),
        .push_private = a.leak(private_key),
        .push_subject = args.env("VAPID_SUBJECT") orelse "mailto:admin@example.com",
        .push_allow_local = (args.env("CAMPFIRE_PUSH_ALLOW_LOCAL") orelse "0") == "1",
        .files = files_dir,
        .assets = args.env("CAMPFIRE_ASSETS_PATH") orelse "build/assets",
        .cache = (args.env("CAMPFIRE_CACHE") orelse "1") != "0",
        .response_cache = (args.env("CAMPFIRE_RESPONSE_CACHE") orelse "1") != "0",
    }
    const open_files = sys.raise_open_files()
    const listener = try net.tcp_listen("0.0.0.0", port)
    defer listener.close()
    io.eprint("campfire listening on ", listener.port(), " with ", workers, " workers", if (!cfg.cache) "" else if (cfg.response_cache) ", caching responses" else ", caching messages", "; open files: ", open_files)

    // The database's writers take turns through this one token, rather than
    // wait on SQLite's lock, which lets some wait for seconds under load.
    const lock = threads.channel(bool, 1)
    const lock_tx = lock.sender()
    lock_tx.send(true)
    // WebSockets, once signed in, go to cable's event loops
    // (CAMPFIRE_CABLE_LOOPS of them, 4 if not set).
    const upgrades = threads.channel(cable.Upgrade, 64)
    const cable_tx = upgrades.sender()
    const cmds = threads.channel(cable.Cmd, 1024)
    const hub_tx = cmds.sender()
    // 1 to 62: the hub keeps a bit for each loop.
    const loops = text.parse_int(args.env("CAMPFIRE_CABLE_LOOPS") orelse "4") orelse 4
    threads.spawn(cable.run, upgrades, cmds, hub_tx.clone(), lock.clone(), lock_tx.clone(), turbo.key(a, cfg.secret), io, net, a, threads, clock, cfg.db_path, if (loops < 1) 1 else if (loops > 62) 62 else loops).detach()
    threads.spawn(checkpointer, lock.clone(), lock_tx.clone(), io, a, threads, cfg.db_path).detach()
    threads.spawn(webhook_work, lock.clone(), lock_tx.clone(), cable_tx.clone(), hub_tx.clone(), io, a, threads, clock, rng, files, cfg).detach()
    const jobs = threads.channel(TcpConn, 64)
    const queue = jobs.sender()
    var pool: Buf(Worker) = .empty
    defer a.free(pool)       // joins them
    defer queue.close()      // first: they finish what is queued, and stop
    var i = 0
    while (i < workers) {
        a.push(&pool, Worker{ .t = threads.spawn(work, jobs.clone(), lock.clone(), lock_tx.clone(), cable_tx.clone(), hub_tx.clone(), io, a, clock, rng, files, cfg) })
        i = i + 1
    }
    jobs.close()
    lock.close()
    lock_tx.close()
    cable_tx.close()
    hub_tx.close()
    // A connection that cannot be taken (out of descriptors, say) is
    // logged, and the next tried a moment later; the server goes on.
    const pause = threads.channel(bool, 1)
    defer pause.close()
    const awake = pause.sender()
    defer awake.close()
    while (true) {
        const c = listener.accept() catch |e| {
            io.eprint("accept failed: ", @errorName(e))
            _ = pause.recv_timeout(100)
            continue
        }
        queue.send(c)
    }
}
