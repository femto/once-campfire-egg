// Dates from Unix time in nanoseconds (clock.now()), UTC, in the forms
// Rails and HTTP write them. Days to dates after Howard Hinnant's
// civil_from_days.
uses alloc

const NS_PER_SEC = 1000000000
const SECS_PER_DAY = 86400

const Civil = struct {
    year: i64
    month: i64
    day: i64
    hour: i64
    minute: i64
    second: i64
    nanos: i64
    weekday: i64     // 0 is Sunday
}

fn floor_div(x: i64, y: i64) i64 {
    const q = x / y
    return if ((x % y != 0) and ((x < 0) != (y < 0))) q - 1 else q
}

fn civil(ns: i64) Civil {
    const secs = floor_div(ns, NS_PER_SEC)
    const days = floor_div(secs, SECS_PER_DAY)
    const rest = secs - days * SECS_PER_DAY
    const z = days + 719468
    const era = floor_div(z, 146097)
    const doe = z - era * 146097
    const yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    const doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    const mp = (5 * doy + 2) / 153
    const d = doy - (153 * mp + 2) / 5 + 1
    const m = if (mp < 10) mp + 3 else mp - 9
    const y = yoe + era * 400 + (if (m <= 2) 1 else 0)
    return Civil{
        .year = y,
        .month = m,
        .day = d,
        .hour = rest / 3600,
        .minute = rest / 60 % 60,
        .second = rest % 60,
        .nanos = ns - secs * NS_PER_SEC,
        .weekday = days + 4 - floor_div(days + 4, 7) * 7,
    }
}

// Days since 1970-01-01 of a date.
fn days_from_civil(year: i64, month: i64, day: i64) i64 {
    const y = if (month <= 2) year - 1 else year
    const era = floor_div(y, 400)
    const yoe = y - era * 400
    const mp = if (month > 2) month - 3 else month + 9
    const doy = (153 * mp + 2) / 5 + day - 1
    const doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

fn leap(year: i64) bool {
    return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
}

// ns moved n calendar years on, as Ruby's n.years.from_now: February 29
// becomes the 28th in a year that has none.
fn add_years(ns: i64, n: i64) i64 {
    const c = civil(ns)
    const year = c.year + n
    const day = if (c.month == 2 and c.day == 29 and !leap(year)) 28 else c.day
    const secs = days_from_civil(year, c.month, day) * SECS_PER_DAY + c.hour * 3600 + c.minute * 60 + c.second
    return secs * NS_PER_SEC + c.nanos
}

fn digits(a: Allocator, inout out: Buf(u8), n: i64, width: i64) void {
    var div = 1
    var i = 1
    while (i < width) {
        div = div * 10
        i = i + 1
    }
    const v = n
    while (div > 0) {
        a.push(&out, @as(u8, v / div % 10) + '0')
        div = div / 10
    }
}

fn date_time(a: Allocator, inout out: Buf(u8), c: Civil, sep: u8) void {
    digits(a, &out, c.year, 4)
    a.push(&out, '-')
    digits(a, &out, c.month, 2)
    a.push(&out, '-')
    digits(a, &out, c.day, 2)
    a.push(&out, sep)
    digits(a, &out, c.hour, 2)
    a.push(&out, ':')
    digits(a, &out, c.minute, 2)
    a.push(&out, ':')
    digits(a, &out, c.second, 2)
}

// How Rails writes a datetime(6) column: "2026-11-03 10:00:00", and
// ".123456" after it unless the microseconds are 0.
fn db_time(a: Allocator, inout out: Buf(u8), ns: i64) void {
    const c = civil(ns)
    date_time(a, &out, c, ' ')
    const us = c.nanos / 1000
    if (us != 0) {
        a.push(&out, '.')
        digits(a, &out, us, 6)
    }
}

// Time#iso8601(3) in UTC: "2046-11-03T10:00:00.000Z", the fraction cut,
// not rounded.
fn iso8601_ms(a: Allocator, inout out: Buf(u8), ns: i64) void {
    const c = civil(ns)
    date_time(a, &out, c, 'T')
    a.push(&out, '.')
    digits(a, &out, c.nanos / 1000000, 3)
    a.push(&out, 'Z')
}

// An HTTP date: "Sat, 03 Nov 2046 10:00:00 GMT".
fn http_date(a: Allocator, inout out: Buf(u8), ns: i64) void {
    const c = civil(ns)
    const days = "SunMonTueWedThuFriSat"
    const months = "JanFebMarAprMayJunJulAugSepOctNovDec"
    a.append_str(&out, days[c.weekday * 3..c.weekday * 3 + 3])
    a.append_str(&out, ", ")
    digits(a, &out, c.day, 2)
    a.push(&out, ' ')
    a.append_str(&out, months[(c.month - 1) * 3..c.month * 3])
    a.push(&out, ' ')
    digits(a, &out, c.year, 4)
    a.push(&out, ' ')
    digits(a, &out, c.hour, 2)
    a.push(&out, ':')
    digits(a, &out, c.minute, 2)
    a.push(&out, ':')
    digits(a, &out, c.second, 2)
    a.append_str(&out, " GMT")
}

fn number(s: []u8) ?i64 {
    var n = 0
    for (s) |c| {
        if (c < '0' or c > '9') {
            return null
        }
        n = n * 10 + @as(i64, c - '0')
    }
    return n
}

// A datetime(6) column as Rails writes it ("2026-11-03 10:00:00" with an
// optional fraction), or SQLite's strftime('%Y-%m-%d %H:%M:%f'), as
// nanoseconds; null if it is neither.
fn parse_db(s: []u8) ?i64 {
    if (@len(s) < 19 or s[4] != '-' or s[7] != '-' or (s[10] != ' ' and s[10] != 'T') or s[13] != ':' or s[16] != ':') {
        return null
    }
    const year = number(s[0..4]) orelse -1
    const month = number(s[5..7]) orelse -1
    const day = number(s[8..10]) orelse -1
    const hour = number(s[11..13]) orelse -1
    const minute = number(s[14..16]) orelse -1
    const second = number(s[17..19]) orelse -1
    if (year < 0 or month < 1 or month > 12 or day < 1 or day > 31 or hour < 0 or hour > 23 or minute < 0 or minute > 59 or second < 0 or second > 60) {
        return null
    }
    var nanos = 0
    if (@len(s) > 19) {
        if (s[19] != '.' or @len(s) == 20 or @len(s) > 29) {
            return null
        }
        const frac = s[20..]
        nanos = number(frac) orelse -1
        if (nanos < 0) {
            return null
        }
        var k = @len(frac)
        while (k < 9) {
            nanos = nanos * 10
            k = k + 1
        }
    }
    const secs = days_from_civil(year, month, day) * SECS_PER_DAY + hour * 3600 + minute * 60 + second
    return secs * NS_PER_SEC + nanos
}

// Time#iso8601 in UTC, whole seconds: "2026-02-28T19:05:00Z".
fn iso8601(a: Allocator, inout out: Buf(u8), ns: i64) void {
    date_time(a, &out, civil(ns), 'T')
    a.push(&out, 'Z')
}

// Time#to_fs(:number), as the ?v= of avatar and logo URLs: "20260102160000".
fn number_stamp(a: Allocator, inout out: Buf(u8), ns: i64) void {
    const c = civil(ns)
    digits(a, &out, c.year, 4)
    digits(a, &out, c.month, 2)
    digits(a, &out, c.day, 2)
    digits(a, &out, c.hour, 2)
    digits(a, &out, c.minute, 2)
    digits(a, &out, c.second, 2)
}

// Milliseconds since 1970, as data-message-timestamp writes them.
fn epoch_ms(ns: i64) i64 {
    return floor_div(ns, 1000000)
}
