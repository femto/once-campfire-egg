// What the pages show, read from SQLite: rooms, a page of messages with
// their creators, bodies and boosts. Times stay as nanoseconds; text is
// copied out of SQLite as it is.
uses alloc, rand, time

const text = @import("std/text")
const sqlite = @import("sqlite.egg")
const tf = @import("timefmt.egg")
const signed_id = @import("signed_id.egg")
const emoji = @import("emoji.egg")
const richtext = @import("richtext.egg")

const PAGE_SIZE = 40

const UserView = owned struct {
    id: i64
    name: Buf(u8)
    // "Name – bio", or the name: the avatar's and author's title.
    title: Buf(u8)
    // /users/<signed id>/avatar?v=<updated_at>
    avatar: Buf(u8)

    fn deinit(sink self: UserView, a: Allocator) void {
        a.free(self.name)
        a.free(self.title)
        a.free(self.avatar)
        @forget(self)
    }
}

const BoostView = owned struct {
    id: i64
    content: Buf(u8)
    all_emoji: bool
    booster: UserView

    fn deinit(sink self: BoostView, a: Allocator) void {
        a.free(self.content)
        self.booster.deinit(a)
        @forget(self)
    }
}

const MessageView = owned struct {
    id: i64
    client_id: Buf(u8)
    room_id: i64
    created_ns: i64
    updated_ns: i64
    creator: UserView
    body: Buf(u8)
    all_emoji: bool
    // Its room's name, as anyone sees it.
    room_name: Buf(u8)
    boosts: Buf(BoostView)

    fn deinit(sink self: MessageView, a: Allocator) void {
        a.free(self.client_id)
        self.creator.deinit(a)
        a.free(self.body)
        a.free(self.room_name)
        a.free(self.boosts)
        @forget(self)
    }
}

const RoomView = owned struct {
    id: i64
    name: Buf(u8)
    // "closed", "open" or "direct", from Rooms::Closed and the rest.
    kind: Buf(u8)
    // The name, or for a direct room its other members' names.
    display: Buf(u8)
    updated_ns: i64

    fn deinit(sink self: RoomView, a: Allocator) void {
        a.free(self.name)
        a.free(self.display)
        a.free(self.kind)
        @forget(self)
    }
}

// A user, from columns i (id), i+1 (name), i+2 (bio), i+3 (updated_at) of st.
fn user_from(a: Allocator, st: sqlite.Stmt, i: i32, sid_key: []u8) UserView {
    const id = st.int(i)
    const name = st.text(a, i + 1)
    var title: Buf(u8) = .empty
    a.append_str(&title, name)
    if (!st.is_null(i + 2)) {
        const bio = st.text(a, i + 2)
        defer a.free(bio)
        if (@len(bio) > 0) {
            a.append_str(&title, " – ")
            a.append_str(&title, bio)
        }
    }
    var avatar: Buf(u8) = .empty
    a.append_str(&avatar, "/users/")
    signed_id.generate(a, &avatar, sid_key, id, "user/avatar")
    a.append_str(&avatar, "/avatar?v=")
    const updated = st.text(a, i + 3)
    defer a.free(updated)
    tf.number_stamp(a, &avatar, tf.parse_db(updated) orelse 0)
    return UserView{ .id = id, .name = name, .title = title, .avatar = avatar }
}

// The room, if the user is a member of it.
fn room_for(a: Allocator, db: sqlite.Db, user: i64, room: i64) !?RoomView {
    var st = try db.prepare("SELECT rooms.id, rooms.name, rooms.type, rooms.updated_at FROM rooms JOIN memberships ON memberships.room_id = rooms.id WHERE rooms.id = ? AND memberships.user_id = ? LIMIT 1")
    defer st.finalize()
    try st.bind_int(1, room)
    try st.bind_int(2, user)
    if (!try st.next()) {
        return null
    }
    const kind_text = st.text(a, 2)
    defer a.free(kind_text)
    const kind = if (kind_text == "Rooms::Closed") a.concat("closed", "") else if (kind_text == "Rooms::Direct") a.concat("direct", "") else a.concat("open", "")
    errdefer a.free(kind)
    const name = if (st.is_null(1)) a.concat("", "") else st.text(a, 1)
    errdefer a.free(name)
    const display = try display_name(a, db, st.int(0), kind == "direct", name, user)
    return RoomView{ .id = st.int(0), .name = name, .kind = kind, .display = display, .updated_ns = ns_column(a, st, 3) }
}

fn ns_column(a: Allocator, st: sqlite.Stmt, i: i32) i64 {
    const t = st.text(a, i)
    defer a.free(t)
    return tf.parse_db(t) orelse 0
}

// The newest PAGE_SIZE messages of the room, or those before the message
// before (an id, or 0 for none), oldest first.
// The messages st finds (m.id, m.client_message_id, m.room_id, m.created_at,
// m.updated_at, t.body, u.id, u.name, u.bio, u.updated_at; newest first), oldest first, with
// their boosts. room_name is each one's room's name, or empty to look them up.
fn read_messages(a: Allocator, db: sqlite.Db, sid_key: []u8, inout st: sqlite.Stmt, room_name: []u8) !Buf(MessageView) {
    var newest_first: Buf(MessageView) = .empty
    defer a.free(newest_first)
    while (try st.next()) {
        const body = st.text(a, 5)
        const all_emoji = emoji.all_emoji_html(body)
        a.push(&newest_first, MessageView{
            .id = st.int(0),
            .client_id = st.text(a, 1),
            .room_id = st.int(2),
            .created_ns = ns_column(a, st, 3),
            .updated_ns = ns_column(a, st, 4),
            .body = body,
            .all_emoji = all_emoji,
            .room_name = a.concat(room_name, ""),
            .creator = user_from(a, st, 6, sid_key),
            .boosts = .empty,
        })
    }
    var out: Buf(MessageView) = .empty
    errdefer a.free(out)
    while (a.pop(&newest_first)) |m| {
        a.push(&out, m)
    }
    try add_boosts(a, db, sid_key, &out)
    return out
}

// The newest PAGE_SIZE messages of the room, or those before the message
// before (an id, or 0 for none), oldest first.
// room.messages.page_created_since(since): the first page of messages
// created after since (a database time), oldest first.
fn page_created_since(a: Allocator, db: sqlite.Db, sid_key: []u8, room: i64, since: []u8, room_name: []u8) !Buf(MessageView) {
    var st = try db.prepare("SELECT m.id, m.client_message_id, m.room_id, m.created_at, m.updated_at, t.body, u.id, u.name, u.bio, u.updated_at FROM messages m JOIN users u ON u.id = m.creator_id LEFT JOIN action_text_rich_texts t ON t.record_type = 'Message' AND t.record_id = m.id AND t.name = 'body' WHERE m.id IN (SELECT id FROM messages WHERE room_id = ? AND created_at > ? ORDER BY created_at ASC LIMIT 40) ORDER BY m.created_at DESC, m.id DESC")
    defer st.finalize()
    try st.bind_int(1, room)
    try st.bind(2, since)
    return read_messages(a, db, sid_key, &st, room_name)
}

// room.messages.without(those created since).page_updated_since(since): the
// last page of messages updated after since that were made before, oldest
// first.
fn page_updated_since(a: Allocator, db: sqlite.Db, sid_key: []u8, room: i64, since: []u8, room_name: []u8) !Buf(MessageView) {
    var st = try db.prepare("SELECT m.id, m.client_message_id, m.room_id, m.created_at, m.updated_at, t.body, u.id, u.name, u.bio, u.updated_at FROM messages m JOIN users u ON u.id = m.creator_id LEFT JOIN action_text_rich_texts t ON t.record_type = 'Message' AND t.record_id = m.id AND t.name = 'body' WHERE m.room_id = ? AND m.id NOT IN (SELECT id FROM messages WHERE room_id = ? AND created_at > ? ORDER BY created_at ASC LIMIT 40) AND m.updated_at > ? ORDER BY m.created_at DESC, m.id DESC LIMIT 40")
    defer st.finalize()
    try st.bind_int(1, room)
    try st.bind_int(2, room)
    try st.bind(3, since)
    try st.bind(4, since)
    return read_messages(a, db, sid_key, &st, room_name)
}

fn page(a: Allocator, db: sqlite.Db, sid_key: []u8, room: i64, before: i64, room_name: []u8) !Buf(MessageView) {
    const sql = if (before == 0) "SELECT m.id, m.client_message_id, m.room_id, m.created_at, m.updated_at, t.body, u.id, u.name, u.bio, u.updated_at FROM messages m JOIN users u ON u.id = m.creator_id LEFT JOIN action_text_rich_texts t ON t.record_type = 'Message' AND t.record_id = m.id AND t.name = 'body' WHERE m.room_id = ? ORDER BY m.created_at DESC, m.id DESC LIMIT 40" else "SELECT m.id, m.client_message_id, m.room_id, m.created_at, m.updated_at, t.body, u.id, u.name, u.bio, u.updated_at FROM messages m JOIN users u ON u.id = m.creator_id LEFT JOIN action_text_rich_texts t ON t.record_type = 'Message' AND t.record_id = m.id AND t.name = 'body' WHERE m.room_id = ? AND m.created_at < (SELECT created_at FROM messages WHERE id = ?) ORDER BY m.created_at DESC, m.id DESC LIMIT 40"
    var st = try db.prepare(sql)
    defer st.finalize()
    try st.bind_int(1, room)
    if (before != 0) {
        try st.bind_int(2, before)
    }
    return read_messages(a, db, sid_key, &st, room_name)
}

// The newest 100 messages in the user's rooms matching the words of query
// (each an FTS5 string, so none is read as syntax), oldest first.
fn search(a: Allocator, db: sqlite.Db, sid_key: []u8, user: i64, query: []u8) !Buf(MessageView) {
    var terms: Buf(u8) = .empty
    defer a.free(terms)
    var i = 0
    while (i < @len(query)) {
        while (i < @len(query) and text.is_space(query[i])) {
            i = i + 1
        }
        var end = i
        while (end < @len(query) and !text.is_space(query[end])) {
            end = end + 1
        }
        if (end > i) {
            if (@len(terms) > 0) {
                a.push(&terms, ' ')
            }
            a.push(&terms, '"')
            for (query[i..end]) |c| {
                if (c == '"') {
                    a.push(&terms, '"')
                }
                a.push(&terms, c)
            }
            a.push(&terms, '"')
        }
        i = end
    }
    if (@len(terms) == 0) {
        return .empty
    }
    var st = try db.prepare("SELECT m.id, m.client_message_id, m.room_id, m.created_at, m.updated_at, t.body, u.id, u.name, u.bio, u.updated_at FROM messages m INNER JOIN rooms r ON m.room_id = r.id INNER JOIN memberships mm ON r.id = mm.room_id JOIN message_search_index idx ON m.id = idx.rowid JOIN users u ON u.id = m.creator_id LEFT JOIN action_text_rich_texts t ON t.record_type = 'Message' AND t.record_id = m.id AND t.name = 'body' WHERE mm.user_id = ? AND (idx.body MATCH ?) ORDER BY m.id DESC LIMIT 100")
    defer st.finalize()
    try st.bind_int(1, user)
    try st.bind(2, terms)
    var out = try read_messages(a, db, sid_key, &st, "")
    errdefer a.free(out)
    // Each room's name, looked up once.
    var k = 0
    while (k < @len(out)) {
        var j = 0
        while (j < k and out[j].room_id != out[k].room_id) {
            j = j + 1
        }
        if (j < k) {
            const copy = a.concat(out[j].room_name[0..], "")
            a.free(@replace(&out[k].room_name, copy))
        } else {
            var rs = try db.prepare("SELECT type = 'Rooms::Direct', name FROM rooms WHERE id = ?")
            defer rs.finalize()
            try rs.bind_int(1, out[k].room_id)
            if (try rs.next()) {
                const name = if (rs.is_null(1)) a.concat("", "") else rs.text(a, 1)
                defer a.free(name)
                const display = try display_name(a, db, out[k].room_id, rs.int(0) != 0, name, 0)
                defer a.free(display)
                a.append_str(&out[k].room_name, display)
            }
        }
        k = k + 1
    }
    return out
}

// The user's recent searches, newest first.
fn recent_searches(a: Allocator, db: sqlite.Db, user: i64) !Buf(Buf(u8)) {
    var out: Buf(Buf(u8)) = .empty
    errdefer a.free(out)
    var st = try db.prepare("SELECT query FROM searches WHERE user_id = ? ORDER BY updated_at DESC")
    defer st.finalize()
    try st.bind_int(1, user)
    while (try st.next()) {
        a.push(&out, st.text(a, 0))
    }
    return out
}

// Where the search page's exit goes: the last room visited, if the user is
// still in it, else the user's first room; 0 if none.
fn return_room(db: sqlite.Db, user: i64, last_room: i64) !i64 {
    if (last_room > 0) {
        var st = try db.prepare("SELECT rooms.id FROM rooms INNER JOIN memberships ON rooms.id = memberships.room_id WHERE memberships.user_id = ? AND rooms.id = ? LIMIT 1")
        defer st.finalize()
        try st.bind_int(1, user)
        try st.bind_int(2, last_room)
        if (try st.next()) {
            return st.int(0)
        }
    }
    var st = try db.prepare("SELECT rooms.id FROM rooms INNER JOIN memberships ON rooms.id = memberships.room_id WHERE memberships.user_id = ? ORDER BY rooms.created_at ASC LIMIT 1")
    defer st.finalize()
    try st.bind_int(1, user)
    if (try st.next()) {
        return st.int(0)
    }
    return 0
}

// Each message's boosts, oldest first, in one query.
fn add_boosts(a: Allocator, db: sqlite.Db, sid_key: []u8, inout messages: Buf(MessageView)) !void {
    if (@len(messages) == 0) {
        return
    }
    var sql: Buf(u8) = .empty
    defer a.free(sql)
    a.append_str(&sql, "SELECT b.message_id, b.id, b.content, u.id, u.name, u.bio, u.updated_at FROM boosts b JOIN users u ON u.id = b.booster_id WHERE b.message_id IN (")
    var i = 0
    while (i < @len(messages)) {
        if (i > 0) {
            a.append_str(&sql, ",")
        }
        a.append_int(&sql, messages[i].id)
        i = i + 1
    }
    a.append_str(&sql, ") ORDER BY b.created_at, b.id")
    var st = try db.prepare_text(sql)
    defer st.finalize()
    while (try st.next()) {
        const message = st.int(0)
        var k = 0
        while (k < @len(messages)) {
            if (messages[k].id == message) {
                const content = st.text(a, 2)
                const all_emoji = emoji.all_emoji(content)
                a.push(&messages[k].boosts, BoostView{ .id = st.int(1), .content = content, .all_emoji = all_emoji, .booster = user_from(a, st, 3, sid_key) })
                k = @len(messages)
            }
            k = k + 1
        }
    }
}

// The user, for the page's own meta tags and message template.
fn find_user(a: Allocator, db: sqlite.Db, sid_key: []u8, id: i64) !?UserView {
    var st = try db.prepare("SELECT id, name, bio, updated_at FROM users WHERE id = ? LIMIT 1")
    defer st.finalize()
    try st.bind_int(1, id)
    if (!try st.next()) {
        return null
    }
    return user_from(a, st, 0, sid_key)
}

// Whether the message is in the room.
fn in_room(db: sqlite.Db, room: i64, message: i64) !bool {
    var st = try db.prepare("SELECT 1 FROM messages WHERE id = ? AND room_id = ?")
    defer st.finalize()
    try st.bind_int(1, message)
    try st.bind_int(2, room)
    return try st.next()
}

// A direct room in the sidebar: its members but the user (or the user, if
// alone), newest room first.
const SidebarDirect = owned struct {
    room_id: i64
    unread: bool
    updated_ns: i64
    members: Buf(UserView)

    fn deinit(sink self: SidebarDirect, a: Allocator) void {
        a.free(self.members)
        @forget(self)
    }
}

// An open or closed room in the sidebar.
const SidebarRoom = owned struct {
    id: i64
    // "open" or "closed"
    kind: Buf(u8)
    name: Buf(u8)
    unread: bool

    fn deinit(sink self: SidebarRoom, a: Allocator) void {
        a.free(self.kind)
        a.free(self.name)
        @forget(self)
    }
}

const Sidebar = owned struct {
    directs: Buf(SidebarDirect)
    rooms: Buf(SidebarRoom)
    // Users to start a direct room with.
    placeholders: Buf(UserView)

    fn deinit(sink self: Sidebar, a: Allocator) void {
        a.free(self.directs)
        a.free(self.rooms)
        a.free(self.placeholders)
        @forget(self)
    }
}

const DIRECT_PLACEHOLDERS = 20

// The user's visible rooms, as Users::SidebarsController#show finds them.
fn sidebar(a: Allocator, db: sqlite.Db, sid_key: []u8, user: i64) !Sidebar {
    var directs: Buf(SidebarDirect) = .empty
    errdefer a.free(directs)
    var rooms: Buf(SidebarRoom) = .empty
    errdefer a.free(rooms)
    var st = try db.prepare("SELECT memberships.unread_at IS NOT NULL, rooms.id, rooms.name, rooms.type, rooms.updated_at FROM memberships INNER JOIN rooms ON rooms.id = memberships.room_id WHERE memberships.user_id = ? AND memberships.involvement != 'invisible' ORDER BY LOWER(rooms.name)")
    defer st.finalize()
    try st.bind_int(1, user)
    while (try st.next()) {
        const kind = st.text(a, 3)
        defer a.free(kind)
        if (kind == "Rooms::Direct") {
            a.push(&directs, SidebarDirect{ .room_id = st.int(1), .unread = st.int(0) != 0, .updated_ns = ns_column(a, st, 4), .members = .empty })
        } else {
            const short = if (kind == "Rooms::Closed") a.concat("closed", "") else a.concat("open", "")
            a.push(&rooms, SidebarRoom{ .id = st.int(1), .kind = short, .name = if (st.is_null(2)) a.concat("", "") else st.text(a, 2), .unread = st.int(0) != 0 })
        }
    }
    // sort_by updated_at, then reverse: stable, so rooms updated together
    // come out in the reverse of the name order.
    var i = 1
    while (i < @len(directs)) {
        var k = i
        while (k > 0 and directs[k - 1].updated_ns > directs[k].updated_ns) {
            @swap(&directs, k - 1, k)
            k = k - 1
        }
        i = i + 1
    }
    var lo = 0
    var hi = @len(directs) - 1
    while (lo < hi) {
        @swap(&directs, lo, hi)
        lo = lo + 1
        hi = hi - 1
    }
    var m = 0
    while (m < @len(directs)) {
        try add_members(a, db, sid_key, user, &directs[m])
        m = m + 1
    }
    const placeholders = try direct_placeholders(a, db, sid_key, user)
    return Sidebar{ .directs = directs, .rooms = rooms, .placeholders = placeholders }
}

// room.users.without(user).presence || [ user ], in the order SQLite gives.
fn add_members(a: Allocator, db: sqlite.Db, sid_key: []u8, user: i64, inout d: SidebarDirect) !void {
    var st = try db.prepare("SELECT users.id, users.name, users.bio, users.updated_at FROM users INNER JOIN memberships ON users.id = memberships.user_id WHERE memberships.room_id = ?")
    defer st.finalize()
    try st.bind_int(1, d.room_id)
    while (try st.next()) {
        if (st.int(0) != user) {
            a.push(&d.members, user_from(a, st, 0, sid_key))
        }
    }
    if (@len(d.members) == 0) {
        if (try find_user(a, db, sid_key, user)) |u| {
            a.push(&d.members, u)
        }
    }
}

// find_direct_placeholder_users: active users in no direct room with the
// user, oldest first, DIRECT_PLACEHOLDERS less those left out (the user
// counted twice, as Rails' `including` does).
fn direct_placeholders(a: Allocator, db: sqlite.Db, sid_key: []u8, user: i64) !Buf(UserView) {
    var exclude: Buf(i64) = .empty
    defer a.free(exclude)
    var st = try db.prepare("SELECT DISTINCT m2.user_id FROM memberships m1 JOIN rooms r ON r.id = m1.room_id AND r.type = 'Rooms::Direct' JOIN memberships m2 ON m2.room_id = r.id WHERE m1.user_id = ?")
    defer st.finalize()
    try st.bind_int(1, user)
    while (try st.next()) {
        a.push(&exclude, st.int(0))
    }
    a.push(&exclude, user)
    var out: Buf(UserView) = .empty
    errdefer a.free(out)
    const limit = DIRECT_PLACEHOLDERS - @len(exclude)
    if (limit <= 0) {
        return out
    }
    var sql: Buf(u8) = .empty
    defer a.free(sql)
    a.append_str(&sql, "SELECT id, name, bio, updated_at FROM users WHERE status = 0 AND id NOT IN (")
    var i = 0
    while (i < @len(exclude)) {
        if (i > 0) {
            a.append_str(&sql, ",")
        }
        a.append_int(&sql, exclude[i])
        i = i + 1
    }
    a.append_str(&sql, ") ORDER BY created_at ASC LIMIT ")
    a.append_int(&sql, limit)
    var us = try db.prepare_text(sql)
    defer us.finalize()
    while (try us.next()) {
        a.push(&out, user_from(a, us, 0, sid_key))
    }
    return out
}

// Whether the account lets only administrators create rooms.
fn rooms_restricted(a: Allocator, db: sqlite.Db) !bool {
    var st = try db.prepare("SELECT settings FROM accounts ORDER BY id LIMIT 1")
    defer st.finalize()
    if (!try st.next() or st.is_null(0)) {
        return false
    }
    const settings = st.text(a, 0)
    defer a.free(settings)
    return text.contains(settings, "\"restrict_room_creation_to_administrators\":true")
}

// room_display_name: a room's name, or for a direct room the names of its
// members but for_user (0 for none) as a sentence ("A and B", "A, B, and C"),
// or for_user's own name when it is alone.
fn display_name(a: Allocator, db: sqlite.Db, room: i64, direct: bool, name: []u8, for_user: i64) !Buf(u8) {
    var out: Buf(u8) = .empty
    if (!direct) {
        a.append_str(&out, name)
        return out
    }
    errdefer a.free(out)
    var names: Buf(Buf(u8)) = .empty
    defer a.free(names)
    var own: Buf(u8) = .empty
    defer a.free(own)
    var st = try db.prepare("SELECT users.id, users.name FROM users INNER JOIN memberships ON users.id = memberships.user_id WHERE memberships.room_id = ?")
    defer st.finalize()
    try st.bind_int(1, room)
    while (try st.next()) {
        if (st.int(0) == for_user) {
            a.free(@replace(&own, st.text(a, 1)))
        } else {
            a.push(&names, st.text(a, 1))
        }
    }
    var i = 0
    while (i < @len(names)) {
        if (i > 0) {
            if (@len(names) == 2) {
                a.append_str(&out, " and ")
            } else if (i == @len(names) - 1) {
                a.append_str(&out, ", and ")
            } else {
                a.append_str(&out, ", ")
            }
        }
        a.append_str(&out, names[i])
        i = i + 1
    }
    const blank = text.trim(a, out)
    defer a.free(blank)
    if (@len(blank) == 0) {
        a.free(@replace(&out, a.concat(own, "")))
    }
    return out
}

// A random UUID (version 4), as SecureRandom.uuid, for a message posted
// without a client id.
fn uuid(a: Allocator, rng: Random) Buf(u8) {
    var b: Buf(u8) = .empty
    defer a.free(b)
    a.resize(&b, 16, 0)
    rng.fill(&b)
    b[6] = (b[6] & 0x0F) | 0x40
    b[8] = (b[8] & 0x3F) | 0x80
    var out: Buf(u8) = .empty
    var i = 0
    while (i < 16) {
        if (i == 4 or i == 6 or i == 8 or i == 10) {
            a.push(&out, '-')
        }
        a.push(&out, "0123456789abcdef"[@as(i64, b[i] >> 4)])
        a.push(&out, "0123456789abcdef"[@as(i64, b[i] & 15)])
        i = i + 1
    }
    return out
}

fn db_now(a: Allocator, inout out: Buf(u8), clock: Clock) i64 {
    const ns = clock.now()
    a.resize(&out, 0, 0)
    tf.db_time(a, &out, ns)
    return ns
}

// room.messages.create!(body:, client_message_id:) by user (has_body false
// for no body): the message, its body (which touches it), the room's touch,
// and what Rails does after the commit (the search index, the other
// members' unread marks), in one transaction: one turn at the write lock.
// The new message's id.
fn create_message(a: Allocator, db: sqlite.Db, clock: Clock, rng: Random, room: i64, user: i64, has_body: bool, body: []u8, client_id: []u8) !i64 {
    const client = if (@len(client_id) > 0) a.concat(client_id, "") else uuid(a, rng)
    defer a.free(client)
    try db.exec("BEGIN IMMEDIATE")
    const id = write_message(a, db, clock, room, user, has_body, body, client) catch |e| {
        db.exec("ROLLBACK") catch {}
        return e
    }
    try db.exec("COMMIT")
    return id
}

fn write_message(a: Allocator, db: sqlite.Db, clock: Clock, room: i64, user: i64, has_body: bool, body: []u8, client: []u8) !i64 {
    var created: Buf(u8) = .empty
    defer a.free(created)
    var plain: Buf(u8) = .empty
    defer a.free(plain)
    const id = try insert_message(a, db, clock, room, user, has_body, body, client, &created, &plain)
    var ix = try db.prepare("INSERT INTO message_search_index(rowid, body) VALUES (?, ?)")
    defer ix.finalize()
    try ix.bind_int(1, id)
    try ix.bind(2, plain)
    while (try ix.next()) {}
    // Members not connected in the last minute have it unread.
    const now = clock.now()
    var cutoff: Buf(u8) = .empty
    defer a.free(cutoff)
    tf.db_time(a, &cutoff, now - 60 * tf.NS_PER_SEC)
    var stamp: Buf(u8) = .empty
    defer a.free(stamp)
    _ = db_now(a, &stamp, clock)
    var un = try db.prepare("UPDATE memberships SET unread_at = ?, updated_at = ? WHERE room_id = ? AND involvement != 'invisible' AND (connected_at IS NULL OR connected_at < ?) AND user_id != ?")
    defer un.finalize()
    try un.bind(1, created)
    try un.bind(2, stamp)
    try un.bind_int(3, room)
    try un.bind(4, cutoff)
    try un.bind_int(5, user)
    while (try un.next()) {}
    return id
}

fn insert_message(a: Allocator, db: sqlite.Db, clock: Clock, room: i64, user: i64, has_body: bool, body: []u8, client: []u8, inout created: Buf(u8), inout plain: Buf(u8)) !i64 {
    _ = db_now(a, &created, clock)
    var st = try db.prepare("INSERT INTO messages (client_message_id, created_at, creator_id, room_id, updated_at) VALUES (?, ?, ?, ?, ?)")
    defer st.finalize()
    try st.bind(1, client)
    try st.bind(2, created)
    try st.bind_int(3, user)
    try st.bind_int(4, room)
    try st.bind(5, created)
    while (try st.next()) {}
    const id = db.last_id()
    var stamp: Buf(u8) = .empty
    defer a.free(stamp)
    if (has_body) {
        const stored = richtext.canonical(a, body)
        defer a.free(stored)
        a.free(@replace(&plain, richtext.plain_text(a, stored)))
        _ = db_now(a, &stamp, clock)
        var rt = try db.prepare("INSERT INTO action_text_rich_texts (body, created_at, name, record_id, record_type, updated_at) VALUES (?, ?, 'body', ?, 'Message', ?)")
        defer rt.finalize()
        try rt.bind(1, stored)
        try rt.bind(2, stamp)
        try rt.bind_int(3, id)
        try rt.bind(4, stamp)
        while (try rt.next()) {}
        _ = db_now(a, &stamp, clock)
        var touch = try db.prepare("UPDATE messages SET updated_at = ? WHERE id = ?")
        defer touch.finalize()
        try touch.bind(1, stamp)
        try touch.bind_int(2, id)
        while (try touch.next()) {}
    }
    _ = db_now(a, &stamp, clock)
    var rs = try db.prepare("UPDATE rooms SET updated_at = ? WHERE id = ?")
    defer rs.finalize()
    try rs.bind(1, stamp)
    try rs.bind_int(2, room)
    while (try rs.next()) {}
    return id
}

// The message, as the room's pages show it.
fn find_message(a: Allocator, db: sqlite.Db, sid_key: []u8, id: i64, room_name: []u8) !Buf(MessageView) {
    var st = try db.prepare("SELECT m.id, m.client_message_id, m.room_id, m.created_at, m.updated_at, t.body, u.id, u.name, u.bio, u.updated_at FROM messages m JOIN users u ON u.id = m.creator_id LEFT JOIN action_text_rich_texts t ON t.record_type = 'Message' AND t.record_id = m.id AND t.name = 'body' WHERE m.id = ?")
    defer st.finalize()
    try st.bind_int(1, id)
    return read_messages(a, db, sid_key, &st, room_name)
}
