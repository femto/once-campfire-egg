// HTTP/1.1 requests and responses over a TcpConn, from egg's
// examples/http_server, with request bodies (Content-Length) and the
// headers Campfire reads.
uses alloc, net

const text = @import("std/text")

const MAX_LINE = 8192
const MAX_BODY = 1048576

const Request = owned struct {
    method: Buf(u8)
    path: Buf(u8)
    query: Buf(u8)
    cookie: Buf(u8)
    host: Buf(u8)
    // Origin and Sec-Fetch-Site, for forgery protection; empty if absent.
    origin: Buf(u8)
    fetch_site: Buf(u8)
    content_type: Buf(u8)
    body: Buf(u8)
    gzip: bool
    keep: bool

    fn deinit(sink self: Request, a: Allocator) void {
        a.free(self.method)
        a.free(self.path)
        a.free(self.query)
        a.free(self.cookie)
        a.free(self.host)
        a.free(self.origin)
        a.free(self.fetch_site)
        a.free(self.content_type)
        a.free(self.body)
        @forget(self)
    }
}

fn lower(c: u8) u8 {
    if (c >= 'A' and c <= 'Z') {
        return c + 32
    }
    return c
}

// Header names and the words of Connection have no case.
fn same(s: []u8, word: str) bool {
    if (@len(s) != @len(word)) {
        return false
    }
    var i = 0
    while (i < @len(s)) {
        if (lower(s[i]) != lower(word[i])) {
            return false
        }
        i = i + 1
    }
    return true
}

fn is_header(line: []u8, name: str) bool {
    const n = @len(name)
    return @len(line) > n and line[n] == ':' and same(line[0..n], name)
}

// The value of a header line, without the spaces around it.
fn value(a: Allocator, line: []u8, name: str) Buf(u8) {
    return text.trim(a, line[@len(name) + 1..])
}

// Is word one of the comma-separated words of list?
fn has_word(list: []u8, word: str) bool {
    var i = 0
    while (i <= @len(list)) {
        const end = text.find_from(list, ",", i) orelse @len(list)
        var lo = i
        var hi = end
        while (lo < hi and (list[lo] == ' ' or list[lo] == '\t')) {
            lo = lo + 1
        }
        // ;q=... after a coding
        const semi = text.find_from(list[0..hi], ";", lo) orelse hi
        hi = semi
        while (hi > lo and (list[hi - 1] == ' ' or list[hi - 1] == '\t')) {
            hi = hi - 1
        }
        if (same(list[lo..hi], word)) {
            return true
        }
        i = end + 1
    }
    return false
}

fn digits(s: []u8) ?i64 {
    if (@len(s) == 0 or @len(s) > 18) {
        return null
    }
    for (s) |c| {
        if (c < '0' or c > '9') {
            return null
        }
    }
    return text.parse_int(s)
}

// The next request on c, or null when the client is done. Fails on a
// request that cannot be read safely; the caller then closes.
fn read_request(c: TcpConn, a: Allocator, served: i64) !?Request {
    var line: Buf(u8) = .empty
    defer a.free(line)
    try c.set_timeout(5000)
    if (!try c.read_line_max(a, &line, MAX_LINE)) {
        return null
    }
    var header: Buf(u8) = .empty
    defer a.free(header)
    var cookie: Buf(u8) = .empty
    errdefer a.free(cookie)
    var content_type: Buf(u8) = .empty
    errdefer a.free(content_type)
    var host: Buf(u8) = .empty
    errdefer a.free(host)
    var origin: Buf(u8) = .empty
    errdefer a.free(origin)
    var fetch_site: Buf(u8) = .empty
    errdefer a.free(fetch_site)
    var length = 0
    var close = false
    var ask_keep = false
    var chunked = false
    var gzip = false
    while (true) {
        if (!try c.read_line_max(a, &header, MAX_LINE)) {
            return error.BadRequest
        }
        if (@len(header) == 0) {
            break
        }
        if (is_header(header, "Cookie")) {
            a.free(@replace(&cookie, value(a, header, "Cookie")))
        } else if (is_header(header, "Host")) {
            a.free(@replace(&host, value(a, header, "Host")))
        } else if (is_header(header, "Origin")) {
            a.free(@replace(&origin, value(a, header, "Origin")))
        } else if (is_header(header, "Sec-Fetch-Site")) {
            a.free(@replace(&fetch_site, value(a, header, "Sec-Fetch-Site")))
        } else if (is_header(header, "Content-Type")) {
            a.free(@replace(&content_type, value(a, header, "Content-Type")))
        } else if (is_header(header, "Connection")) {
            const v = header[@len("Connection:")..]
            close = close or has_word(v, "close")
            ask_keep = ask_keep or has_word(v, "keep-alive")
        } else if (is_header(header, "Accept-Encoding")) {
            gzip = has_word(header[@len("Accept-Encoding:")..], "gzip")
        } else if (is_header(header, "Content-Length")) {
            const v = value(a, header, "Content-Length")
            defer a.free(v)
            length = digits(v) orelse -1
        } else if (is_header(header, "Transfer-Encoding")) {
            chunked = true
        }
    }
    if (chunked or length < 0 or length > MAX_BODY) {
        return error.BadRequest
    }
    var body: Buf(u8) = .empty
    errdefer a.free(body)
    var chunk: Buf(u8) = .empty
    defer a.free(chunk)
    while (@len(body) < length) {
        if (try c.read(a, &chunk, length - @len(body)) == 0) {
            return error.BadRequest
        }
        a.append_str(&body, chunk)
    }
    const space = text.find(line, " ") orelse -1
    const end = if (space < 0) -1 else (text.find_from(line, " ", space + 1) orelse -1)
    if (end < 0) {
        return error.BadRequest
    }
    const q = text.find_from(line[0..end], "?", space + 1) orelse end
    const wanted = text.ends_with(line, " HTTP/1.1") or ask_keep
    return Request{
        .method = a.concat(line[0..space], ""),
        .path = a.concat(line[space + 1..q], ""),
        .query = if (q < end) a.concat(line[q + 1..end], "") else a.concat("", ""),
        .cookie = cookie,
        .host = host,
        .origin = origin,
        .fetch_site = fetch_site,
        .content_type = content_type,
        .body = body,
        .gzip = gzip,
        .keep = wanted and !close and served < 1000,
    }
}

// A response: the status line, headers (each ending in \r\n), and the body.
fn write_response(c: TcpConn, a: Allocator, status: str, headers: []u8, body: []u8, keep: bool) !void {
    var head: Buf(u8) = .empty
    defer a.free(head)
    a.append_str(&head, "HTTP/1.1 ")
    a.append_str(&head, status)
    a.append_str(&head, "\r\n")
    a.append_str(&head, headers)
    a.append_str(&head, "Content-Length: ")
    a.append_int(&head, @len(body))
    a.append_str(&head, if (keep) "\r\nConnection: keep-alive\r\n\r\n" else "\r\nConnection: close\r\n\r\n")
    a.append_str(&head, body)
    try c.write(head)
}
