// HTTP/1.1 for Campfire, on Egg's std/http: its requests (read whole,
// Content-Length or chunked, a connection's next request kept in its
// inbox), forms, uploads, validators and ranges. Here is what Campfire adds:
// gzip through zlib-ng where the Rust app (Rack::Deflater) would, the ETag
// of the body as sent, and a connection let go after 1000 requests.
uses alloc, net

const std = @import("std/http")
const gz = @import("gzip.egg")
const crypto = @import("crypto.egg")
const codec = @import("codec.egg")
const text = @import("std/text")

const MAX_BODY = 33554432
const MAX_HEAD = 65536
const READ_SIZE = 65536
// How many requests a connection makes before the next is answered with
// Connection: close.
const MAX_REQUESTS = 1000

const Request = std.Request
const Upload = std.Upload

// The next request on c, read into inbox (kept for the life of the
// connection, with what came after the request), or null when the client
// is done: it closed, or sent nothing more for 5 s. served is how many
// requests the connection has made. Fails with error.BadRequest,
// error.HeadTooLarge, error.BodyTooLarge or error.LengthRequired on a
// request that cannot be read safely; the caller then answers and closes.
//
// std.parse takes the request from inbox once it is whole; reading here
// bounds what inbox may hold meanwhile: no more than MAX_HEAD of empty
// lines before a request, a head of at most MAX_HEAD (std.parse), and a
// body of a Content-Length of at most MAX_BODY. A chunked body is refused,
// as Campfire always has (browsers do not send one): its framing would
// have no bound, and std.parse would scan it again with every read.
fn read_request(c: TcpConn, a: Allocator, inout inbox: Buf(u8), served: i64) !?Request {
    try c.set_timeout(5000)
    var chunk: Buf(u8) = .empty
    defer a.free(chunk)
    var framed = false
    while (true) {
        if (!framed) {
            framed = try not_chunked(inbox)
        }
        if (try std.parse(a, &inbox, MAX_BODY)) |got| {
            var req = got
            if (served >= MAX_REQUESTS) {
                std.close_after(&req)
            }
            return req
        }
        if (std.idle(inbox) and @len(inbox) > MAX_HEAD) {
            return error.BadRequest
        }
        const n = c.read(a, &chunk, READ_SIZE) catch |e| {
            if (e == error.TimedOut and std.idle(inbox)) {
                return null
            }
            return e
        }
        if (n == 0) {
            if (std.idle(inbox)) {
                return null
            }
            return error.BadRequest
        }
        a.append_str(&inbox, chunk)
    }
    return null
}

// Has inbox the whole head of its next request, without Transfer-Encoding?
// false while the head has not all come; error.LengthRequired for a
// Transfer-Encoding. Looks at no more than MAX_HEAD past the empty lines
// before the request; std.parse refuses a longer head.
fn not_chunked(inbox: []u8) !bool {
    var at = 0
    while (at < @len(inbox) and (inbox[at] == '\r' or inbox[at] == '\n')) {
        at = at + 1
    }
    const limit = at + MAX_HEAD
    while (at < @len(inbox) and at < limit) {
        const nl = text.find_from(inbox, "\n", at) orelse { return false }
        var end = nl
        if (end > at and inbox[end - 1] == '\r') {
            end = end - 1
        }
        if (end == at) {
            return true
        }
        if (end - at >= 18 and std.same(inbox[at..at + 18], "transfer-encoding:")) {
            return error.LengthRequired
        }
        at = nl + 1
    }
    return false
}

// A header's value, or empty if the request has none.
fn header(req: Request, name: []u8) []u8 from req {
    return req.header(name) orelse ""
}

fn user_agent(req: Request) []u8 from req {
    return req.header("User-Agent") orelse ""
}

// Origin and Sec-Fetch-Site, for forgery protection; empty if absent.
fn origin(req: Request) []u8 from req {
    return req.header("Origin") orelse ""
}

fn fetch_site(req: Request) []u8 from req {
    return req.header("Sec-Fetch-Site") orelse ""
}

// The WebSocket subprotocols asked for, from every Sec-WebSocket-Protocol
// header, comma-separated.
fn protocols(a: Allocator, req: Request) Buf(u8) {
    return std.header_list(a, req, "Sec-WebSocket-Protocol")
}

// Does the client take gzip?
fn gzip(req: Request) bool {
    return std.accepts(req, "gzip")
}

// A response with no request to answer (one that could not be read):
// the status line, headers (each ending in \r\n), and the body.
fn write_response(c: TcpConn, a: Allocator, status: []u8, headers: []u8, body: []u8, keep: bool) !void {
    return std.write_response(c, a, status, headers, body, keep)
}

// Whether the Rust app (Rack::Deflater's rules) compresses a body of this
// type: not images already compressed, audio or video.
fn compressible(headers: []u8) bool {
    const types = [_]str{ "Content-Type: image/png", "Content-Type: image/webp", "Content-Type: image/gif", "Content-Type: image/jp", "Content-Type: audio/", "Content-Type: video/" }
    for (types) |t| {
        if (text.contains(headers, t)) {
            return false
        }
    }
    return true
}

// A body as it goes out, with the headers that describe it.
const Encoded = owned struct {
    headers: Buf(u8)
    body: Buf(u8)

    fn deinit(sink self: Encoded, a: Allocator) void {
        a.free(self.headers)
        a.free(self.body)
        @forget(self)
    }
}

// The body, gzipped when the request accepts it and it is at least 1 KB of
// a compressible type.
fn encode(a: Allocator, req: Request, headers: []u8, body: []u8) Encoded {
    if (@len(body) >= 1024 and compressible(headers) and gzip(req)) {
        if (gz.compress(a, body)) |z| {
            return Encoded{ .headers = a.concat(headers, "Content-Encoding: gzip\r\nVary: Accept-Encoding\r\n"), .body = z }
        }
    }
    return Encoded{ .headers = a.concat(headers, ""), .body = a.concat(body, "") }
}

// The response to req, encoded; a 200 with its ETag (see conditional).
fn respond(c: TcpConn, a: Allocator, req: Request, status: []u8, headers: []u8, body: []u8) !void {
    const e = encode(a, req, headers, body)
    defer e.deinit(a)
    if (status == "200 OK") { return conditional(c, a, req, "", e.headers, e.body) }
    return std.respond(c, a, req, status, "", e.headers, e.body)
}

// A 200 tagged with the SHA-1 of the body as sent (gzipped or not), or 304
// Not Modified if a GET or HEAD has it (If-None-Match, compared weakly).
// own: the headers of this request (Set-Cookie), apart from those of the
// body, which a cache keeps with it.
fn conditional(c: TcpConn, a: Allocator, req: Request, own: []u8, headers: []u8, body: []u8) !void {
    const digest = crypto.sha1(a, body)
    defer a.free(digest)
    var tag: Buf(u8) = .empty
    defer a.free(tag)
    a.push(&tag, '"')
    codec.hex_encode(a, &tag, digest)
    a.push(&tag, '"')
    return std.conditional(c, a, req, tag, null, own, headers, body)
}

// A field of the request's form, urlencoded or multipart (a file's part is
// not a field here: see file); null if absent.
fn field(a: Allocator, req: Request, name: []u8) ?Buf(u8) {
    return std.field(a, req, name)
}

fn fields(a: Allocator, req: Request, name: []u8) Buf(Buf(u8)) {
    return std.fields(a, req, name)
}

fn file(a: Allocator, req: Request, name: []u8) ?Upload {
    return std.file(a, req, name)
}

// A stored file: whole (encoded, with its ETag) unless the request asks
// for one range of bytes, which it gets (206, or 416 for one not in it).
// A Range std.ranged would not honor (several ranges, another unit) goes
// the way no Range does, as does one with If-None-Match: the validator is
// then looked at first (RFC 9110 13.2.2), and the whole body is a fine
// answer to a Range.
fn file_response(c: TcpConn, a: Allocator, req: Request, headers: []u8, body: []u8) !void {
    const range = header(req, "Range")
    if (text.starts_with(range, "bytes=") and !text.contains(range, ",") and @len(header(req, "If-None-Match")) == 0) {
        return std.ranged(c, a, req, headers, body)
    }
    const ranged = a.concat(headers, "Accept-Ranges: bytes\r\n")
    defer a.free(ranged)
    return respond(c, a, req, "200 OK", ranged, body)
}
