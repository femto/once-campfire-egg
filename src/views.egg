// guest_top.html
fn guest_top(a: Allocator, inout out: Buf(u8), title: []u8, vapid: []u8, logo: []u8) void {
    a.append_str(&out, "<!DOCTYPE html>\n<html>\n  <head>\n    <title>")
    html.escape(a, &out, title)
    a.append_str(&out, "</title>\n\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no, interactive-widget=resizes-content\">\n    <meta name=\"view-transition\" content=\"same-origin\">\n    <meta name=\"color-scheme\" content=\"light dark\">\n    <meta name=\"theme-color\" content=\"#ffffff\" media=\"(prefers-color-scheme: light)\">\n    <meta name=\"theme-color\" content=\"#000000\" media=\"(prefers-color-scheme: dark)\">\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n    \n    <meta name=\"action-cable-url\" content=\"/cable\">\n\n    <meta name=\"vapid-public-key\" content=\"")
    html.escape(a, &out, vapid)
    a.append_str(&out, "\">\n    <meta name=\"turbo-prefetch\" content=\"true\">\n\n    <link rel=\"manifest\" href=\"/webmanifest.json\">\n    <link rel=\"icon\" href=\"")
    a.append_str(&out, logo)
    a.append_str(&out, "\" type=\"image/png\">\n    <link rel=\"apple-touch-icon\" href=\"")
    a.append_str(&out, logo)
    a.append_str(&out, "\">\n\n    ")
    a.append_str(&out, static_head.ASSETS)
}

// invite.html
fn invite_link(a: Allocator, inout out: Buf(u8), base: []u8, join_code: []u8, admin: bool) void {
    const url = a.concat(base, "/join/", join_code)
    defer a.free(url)
    var qr: Buf(u8) = .empty
    defer a.free(qr)
    codec.base64url_padded(a, &qr, url)
    a.append_str(&out, "<div class=\"flex flex-column align-center gap\">\n\n  <label class=\"flex flex-column gap full-width\" style=\"--row-gap: 0.5em\">\n    <strong id=\"invite_label\" class=\"invite-label\">Share to invite more people</strong>\n    <span class=\"flex align-center gap input input--actor fill-white\">\n      <img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/person-add-1432b76b.svg\" width=\"20\" height=\"20\" />\n      <input type=\"text\" class=\"input\" id=\"invite_url\" value=\"")
    html.escape(a, &out, url)
    a.append_str(&out, "\" aria-labelledby=\"invite_label\" readonly>\n    </span>\n  </label>\n\n  <div class=\"flex align-center gap\">\n    <a class=\"btn\" data-lightbox-target=\"image\" data-action=\"lightbox#open\" data-lightbox-url-value=\"/qr_code/")
    a.append_str(&out, qr)
    a.append_str(&out, "\" href=\"/qr_code/")
    a.append_str(&out, qr)
    a.append_str(&out, "\">\n      <span class=\"for-screen-reader\">Show join link QR code</span>\n      <img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/qr-code-dac3b273.svg\" width=\"20\" height=\"20\" />\n</a>\n    <button class=\"btn\" data-controller=\"copy-to-clipboard\" data-action=\"copy-to-clipboard#copy\" data-copy-to-clipboard-success-class=\"btn--success\" data-copy-to-clipboard-content-value=\"")
    html.escape(a, &out, url)
    a.append_str(&out, "\">\n      <span class=\"for-screen-reader\">Copy join link</span>\n      <img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/copy-paste-4c379063.svg\" width=\"20\" height=\"20\" />\n</button>\n    <button class=\"btn\" hidden=\"hidden\" data-controller=\"web-share\" data-action=\"web-share#share\" data-web-share-url-value=\"")
    html.escape(a, &out, url)
    a.append_str(&out, "\" data-web-share-text-value=\"Hit this link to join me in Campfire and start chatting.\" data-web-share-title-value=\"Link to join Campfire\">\n      <span class=\"for-screen-reader\">Share join link</span>\n      <img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/share-bf28da4f.svg\" width=\"20\" height=\"20\" />\n</button>\n")
    if (admin) {
    a.append_str(&out, "      <form class=\"button_to\" method=\"post\" action=\"/account/join_code\"><button class=\"btn btn--regenerate\" type=\"submit\">\n        <img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/refresh-249f0509.svg\" width=\"20\" height=\"20\" />\n        <span class=\"for-screen-reader\">Regenerate join link</span>\n</button></form>")
    }
    a.append_str(&out, "  </div>\n</div>\n")
}

// layout_bottom.html
fn layout_bottom(a: Allocator, inout out: Buf(u8)) void {
    a.append_str(&out, "    <dialog class=\"lightbox\" aria-label=\"Image Viewer (Press escape to close)\" data-lightbox-target=\"dialog\" data-action=\"close->lightbox#reset\">\n  <img src=\"\" class=\"lightbox__image\" data-lightbox-target=\"zoomedImage\" />\n\n  <form method=\"dialog\" class=\"lightbox__btn\">\n    <button class=\"btn\">\n      <img aria-hidden=\"true\" src=\"/assets/remove-0e7a045d.svg\" />\n      <span class=\"for-screen-reader\">Close image viewer</span>\n    </button>\n  </form>\n\n  <a href=\"\" class=\"lightbox__btn--download btn hide-in-ios-pwa\" data-lightbox-target=\"download\">\n    <img aria-hidden=\"true\" src=\"/assets/download-04029899.svg\" />\n    <span class=\"for-screen-reader\">Download file</span>\n  </a>\n\n  <button class=\"lightbox__btn--share btn\"\n      data-controller=\"web-share\"\n      data-action=\"web-share#share\"\n      data-web-share-files-value=\"\"\n      data-lightbox-target=\"share\">\n    <img aria-hidden=\"true\" src=\"/assets/share-bf28da4f.svg\" />\n    <span class=\"for-screen-reader\">Share file</span>\n  </button>\n</dialog>\n\n\n    <a href=\"https://once.com\" id=\"app-logo\" target=\"_blank\" aria-label=\"Once software from 37signals home page\">\n      <img alt=\"Campfire logo\" width=\"256\" height=\"216\" src=\"/assets/campfire-icon-3d9986c5.png\" />\n    </a>\n  </body>\n</html>\n")
}

// layout_top.html
fn layout_top(a: Allocator, inout out: Buf(u8), title: []u8, user: model.UserView, vapid: []u8, logo_v: []u8) void {
    a.append_str(&out, "<!DOCTYPE html>\n<html>\n  <head>\n    <title>")
    html.escape(a, &out, title)
    a.append_str(&out, "</title>\n\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no, interactive-widget=resizes-content\">\n    <meta name=\"view-transition\" content=\"same-origin\">\n    <meta name=\"color-scheme\" content=\"light dark\">\n    <meta name=\"theme-color\" content=\"#ffffff\" media=\"(prefers-color-scheme: light)\">\n    <meta name=\"theme-color\" content=\"#000000\" media=\"(prefers-color-scheme: dark)\">\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n    <meta name=\"current-user-id\" content=\"")
    a.append_int(&out, user.id)
    a.append_str(&out, "\" /><meta name=\"current-user-name\" content=\"")
    html.escape(a, &out, user.name)
    a.append_str(&out, "\" />\n    <meta name=\"action-cable-url\" content=\"/cable\">\n\n    <meta name=\"vapid-public-key\" content=\"")
    html.escape(a, &out, vapid)
    a.append_str(&out, "\">\n    <meta name=\"turbo-prefetch\" content=\"true\">\n\n    <link rel=\"manifest\" href=\"/webmanifest.json\">\n    <link rel=\"icon\" href=\"/account/logo?v=")
    a.append_str(&out, logo_v)
    a.append_str(&out, "\" type=\"image/png\">\n    <link rel=\"apple-touch-icon\" href=\"/account/logo?v=")
    a.append_str(&out, logo_v)
    a.append_str(&out, "\">\n\n    ")
    a.append_str(&out, static_head.ASSETS)
}

// manifest.html
fn manifest(a: Allocator, inout out: Buf(u8), name: []u8, small: []u8, large: []u8, base: []u8) void {
    a.append_str(&out, "{\n  \"name\": ")
    a.append_str(&out, name)
    a.append_str(&out, ",\n  \"icons\": [\n    {\n      \"src\": ")
    a.append_str(&out, small)
    a.append_str(&out, ",\n      \"type\": \"image/png\",\n      \"sizes\": \"192x192\"\n    },\n    {\n      \"src\": ")
    a.append_str(&out, large)
    a.append_str(&out, ",\n      \"type\": \"image/png\",\n      \"sizes\": \"512x512\"\n    },\n    {\n      \"src\": ")
    a.append_str(&out, large)
    a.append_str(&out, ",\n      \"type\": \"image/png\",\n      \"sizes\": \"512x512\",\n      \"purpose\": \"maskable\"\n    }\n  ],\n  \"start_url\": \"/\",\n  \"display\": \"standalone\",\n  \"scope\": \"/\",\n  \"description\": \"A chat app from the makers of Basecamp and HEY.\",\n  \"categories\": [\"social\", \"business\", \"productivity\"],\n  \"theme_color\": \"#ffffff\",\n  \"background_color\": \"#ffffff\",\n  \"shortcuts\": [\n    {\n      \"name\": \"New chat room\",\n      \"description\": \"Open Campfire and start a new chat room\",\n      \"url\": \"rooms/opens/new\",\n      \"icons\": [{ \"src\": \"")
    a.append_str(&out, base)
    a.append_str(&out, "/assets/add-f232d8a6.svg\", \"sizes\": \"any\" }]\n    },\n    {\n      \"name\": \"My profile\",\n      \"description\": \"Open Campfire and view your profile\",\n      \"url\": \"/users/me/profile\",\n      \"icons\": [{ \"src\": \"")
    a.append_str(&out, base)
    a.append_str(&out, "/assets/person-da193438.svg\", \"sizes\": \"any\" }]\n    }\n  ],\n  \"screenshots\": [\n    {\n      \"src\": \"")
    a.append_str(&out, base)
    a.append_str(&out, "/assets/screenshots/android-chat-f8b923c9.png\",\n      \"sizes\": \"1080x2400\",\n      \"form_factor\": \"narrow\",\n      \"label\": \"Campfire is an installable, self-hosted group chat system.\"\n    },\n    {\n      \"src\": \"")
    a.append_str(&out, base)
    a.append_str(&out, "/assets/screenshots/android-sidebar-e9d2b49f.png\",\n      \"sizes\": \"1080x2400\",\n      \"form_factor\": \"narrow\",\n      \"label\": \"Easily invite people. Make rooms. @mentions, DMs, and mobile support.\"\n    },\n    {\n      \"src\": \"")
    a.append_str(&out, base)
    a.append_str(&out, "/assets/screenshots/android-dark-mode-e43dcf59.png\",\n      \"sizes\": \"1080x2400\",\n      \"form_factor\": \"narrow\",\n      \"label\": \"Full support for dark mode, customizable to your brand.\"\n    }\n  ]\n}\n")
}

// message.html
fn message(a: Allocator, inout out: Buf(u8), m: model.MessageView) void {
    a.append_str(&out, "\n  <div id=\"message_")
    html.escape(a, &out, m.client_id)
    a.append_str(&out, "\" class=\"message ")
    if (m.all_emoji) {
    a.append_str(&out, "message--emoji")
    }
    a.append_str(&out, "\" data-controller=\"reply\" data-user-id=\"")
    a.append_int(&out, m.creator.id)
    a.append_str(&out, "\" data-message-id=\"")
    a.append_int(&out, m.id)
    a.append_str(&out, "\" data-message-timestamp=\"")
    a.append_int(&out, tf.epoch_ms(m.created_ns))
    a.append_str(&out, "\" data-message-updated-at=\"")
    a.append_int(&out, tf.epoch_ms(m.updated_ns))
    a.append_str(&out, "\" data-sort-value=\"")
    a.append_int(&out, tf.epoch_ms(m.created_ns))
    a.append_str(&out, "\" data-messages-target=\"message\" data-search-results-target=\"message\" data-refresh-room-target=\"message\" data-reply-composer-outlet=\"#composer\">\n    <h2 class=\"message__day-separator\"><time datetime=\"")
    tf.iso8601(a, &out, m.created_ns)
    a.append_str(&out, "\" data-local-time-target=\"date\"></time></h2>\n\n    <figure class=\"avatar message__avatar\">\n      <a title=\"")
    html.escape(a, &out, m.creator.title)
    a.append_str(&out, "\" class=\"btn avatar\" data-turbo-frame=\"_top\" href=\"/users/")
    a.append_int(&out, m.creator.id)
    a.append_str(&out, "\"><img aria-hidden=\"true\" src=\"")
    html.escape(a, &out, m.creator.avatar)
    a.append_str(&out, "\" width=\"48\" height=\"48\" /></a>\n    </figure>\n\n    <turbo-frame id=\"edit_message_")
    html.escape(a, &out, m.client_id)
    a.append_str(&out, "\">\n      <div class=\"message__body\">\n        <div class=\"message__body-content\">\n          <div class=\"message__meta\">\n            <h3 class=\"message__heading\">\n              <span class=\"message__author\" title=\"")
    html.escape(a, &out, m.creator.title)
    a.append_str(&out, "\">\n                <strong data-reply-target=\"author\">")
    html.escape(a, &out, m.creator.name)
    a.append_str(&out, "</strong>\n              </span>\n              <a target=\"_top\" class=\"message__permalink\" href=\"/rooms/")
    a.append_int(&out, m.room_id)
    a.append_str(&out, "/@")
    a.append_int(&out, m.id)
    a.append_str(&out, "\"><time class=\"message__timestamp\" datetime=\"")
    tf.iso8601(a, &out, m.created_ns)
    a.append_str(&out, "\" data-local-time-target=\"time\"></time></a>\n              <span class=\"message__room\">\n                <a target=\"_top\" data-reply-target=\"link\" href=\"/rooms/")
    a.append_int(&out, m.room_id)
    a.append_str(&out, "/@")
    a.append_int(&out, m.id)
    a.append_str(&out, "\">")
    html.escape(a, &out, m.room_name)
    a.append_str(&out, "</a>\n              </span>\n            </h3>\n            <div class=\"message__actions\" data-controller=\"soft-keyboard\">\n  <details class=\"position-relative\" data-controller=\"popup\" data-action=\"keydown.esc-&gt;popup#close toggle-&gt;popup#toggle click@document-&gt;popup#closeOnClickOutside\" data-popup-orientation-top-class=\"popup-orientation-top\">\n    <summary class=\"btn message__action-btn message__options-btn\">\n      <img class=\"colorize--black\" aria-hidden=\"true\" src=\"/assets/menu-dots-horizontal-f6a5d793.svg\" width=\"20\" height=\"20\" />\n      <span class=\"for-screen-reader\">Message options</span>\n    </summary>\n\n    <div class=\"message__actions-menu border shadow\" data-popup-target=\"menu\">\n      <div class=\"quick-boosts\">")
    quick_boosts(a, &out, m)
    a.append_str(&out, "\n\n        <a class=\"btn message__action-btn message__boost-btn\" data-turbo-frame=\"new_boost_message_")
    html.escape(a, &out, m.client_id)
    a.append_str(&out, "\" data-action=\"soft-keyboard#open popup#close\" href=\"/messages/")
    a.append_int(&out, m.id)
    a.append_str(&out, "/boosts/new\">\n          <img class=\"colorize--black\" aria-hidden=\"true\" src=\"/assets/boost-4a7bab66.svg\" width=\"20\" height=\"20\" />\n          <span class=\"for-screen-reader\">New boost</span>\n</a>      </div>\n\n      <div class=\"flex flex-wrap border-top margin-block-start-half pad-block-start-half message__actions-grid\">\n          <button class=\"btn message__action-btn center full-width\" data-action=\"reply#reply\" title=\"Reply\" aria-label=\"Reply\">\n            <img class=\"colorize--black\" aria-hidden=\"true\" src=\"/assets/reply-edb77e33.svg\" width=\"20\" height=\"20\" />\n</button>\n\n        <button class=\"btn message__action-btn center full-width\" title=\"Copy link\" aria-label=\"Copy link\" data-controller=\"copy-to-clipboard\" data-action=\"copy-to-clipboard#copy\" data-copy-to-clipboard-success-class=\"btn--success\" data-copy-to-clipboard-url-value=\"/rooms/")
    a.append_int(&out, m.room_id)
    a.append_str(&out, "/@")
    a.append_int(&out, m.id)
    a.append_str(&out, "\">\n          <img class=\"colorize--black\" aria-hidden=\"true\" src=\"/assets/link-e546a5df.svg\" width=\"20\" height=\"20\" />\n</button>\n        <a class=\"btn message__action-btn center full-width message__edit-btn\" data-turbo-frame=\"edit_message_")
    html.escape(a, &out, m.client_id)
    a.append_str(&out, "\" title=\"Edit\" aria-label=\"Edit\" href=\"/rooms/")
    a.append_int(&out, m.room_id)
    a.append_str(&out, "/messages/")
    a.append_int(&out, m.id)
    a.append_str(&out, "/edit\">\n          <img class=\"colorize--black\" aria-hidden=\"true\" src=\"/assets/pencil-cf9d28aa.svg\" width=\"20\" height=\"20\" />\n</a>      </div>\n    </div>\n</details></div>\n          </div>\n          <div id=\"presentation_message_")
    html.escape(a, &out, m.client_id)
    a.append_str(&out, "\" dir=\"auto\" data-reply-target=\"body\" data-messages-target=\"body\">\n  <div class=\"lexxy-content\">\n  ")
    a.append_str(&out, m.body)
    a.append_str(&out, "\n</div>\n\n</div>\n          <turbo-frame id=\"boosting_message_")
    html.escape(a, &out, m.client_id)
    a.append_str(&out, "\">\n  <div class=\"boosts flex flex-wrap align-center gap full-width\" style=\"--column-gap: 0.4ch; --row-gap: 0\"\n      data-controller=\"turbo-streaming\" data-action=\"turbo:submit-start->turbo-streaming#unsubscribe\">\n    <div class=\"flex-inline flex-wrap gap\" id=\"boosts_message_")
    html.escape(a, &out, m.client_id)
    a.append_str(&out, "\" data-turbo-streaming-target=\"container\">")
    for (m.boosts) |b| {
    boost(a, &out, b, m.id)
    }
    a.append_str(&out, "\n    </div>\n\n    <turbo-frame id=\"new_boost_message_")
    html.escape(a, &out, m.client_id)
    a.append_str(&out, "\">\n      <div class=\"flex-inline message__boost-inline\" data-controller=\"soft-keyboard\">\n        <a class=\"boost__action txt-small btn\" action=\"soft-keyboard#open\" href=\"/messages/")
    a.append_int(&out, m.id)
    a.append_str(&out, "/boosts/new\">\n          <img aria-hidden=\"true\" src=\"/assets/boost-4a7bab66.svg\" width=\"20\" height=\"20\" />\n          <span class=\"for-screen-reader\">Add a boost</span>\n</a>      </div>\n</turbo-frame>  </div>\n</turbo-frame>\n        </div>\n      </div>\n    </turbo-frame>\n</div>")
}

// message_edit.html
fn message_edit(a: Allocator, inout out: Buf(u8), m: model.MessageView, editable: []u8, base: []u8) void {
    a.append_str(&out, "<turbo-frame id=\"edit_message_")
    html.escape(a, &out, m.client_id)
    a.append_str(&out, "\">\n  <div class=\"message__body position-relative\" data-controller=\"scroll-into-view\">\n    <div class=\"message__body-content message__body-content--editing gap\">\n        <div class=\"composer--edit composer--rich-text\">\n          <form id=\"form_message_")
    html.escape(a, &out, m.client_id)
    a.append_str(&out, "\" data-controller=\"form\" data-action=\"lexxy:file-accept-&gt;form#preventAttachment keydown.esc-&gt;form#cancel keydown.ctrl+enter-&gt;form#submit:prevent keydown.meta+enter-&gt;form#submit:prevent\" action=\"/rooms/")
    a.append_int(&out, m.room_id)
    a.append_str(&out, "/messages/")
    a.append_int(&out, m.id)
    a.append_str(&out, "\" accept-charset=\"UTF-8\" method=\"post\"><input type=\"hidden\" name=\"_method\" value=\"patch\" />\n            <div class=\"full-width input input--actor min-width fill-white\">\n              <lexxy-editor rows=\"1\" class=\"input lexxy-content\" aria-multiline=\"true\" aria-label=\"Edit message\" autofocus=\"autofocus\" permitted-attachment-types=\"application/vnd.campfire.mention application/vnd.actiontext.opengraph-embed\" data-action=\"lexxy:change-&gt;typing-notifications#start keydown-&gt;composer#submitByKeyboard:capture\" data-direct-upload-url=\"")
    a.append_str(&out, base)
    a.append_str(&out, "/rails/active_storage/direct_uploads\" data-blob-url-template=\"")
    a.append_str(&out, base)
    a.append_str(&out, "/rails/active_storage/blobs/redirect/:signed_id/:filename\" id=\"message_body\" input=\"message_body_trix_input_message_")
    html.escape(a, &out, m.client_id)
    a.append_str(&out, "\" name=\"message[body]\" value=\"")
    html.escape(a, &out, editable)
    a.append_str(&out, "\">\n                <lexxy-prompt trigger=\"@\" name=\"mention\" src=\"/autocompletable/users?room_id=")
    a.append_int(&out, m.room_id)
    a.append_str(&out, "\" remote-filtering=\"true\" empty-results=\"No matches\"></lexxy-prompt>\n</lexxy-editor>            </div>\n\n            <a data-form-target=\"cancel\" hidden=\"hidden\" href=\"/rooms/")
    a.append_int(&out, m.room_id)
    a.append_str(&out, "/messages/")
    a.append_int(&out, m.id)
    a.append_str(&out, "\">Close editor and discard changes</a>\n\n            <div class=\"message__edit-btns flex align-center justify-space-between gap full-width pad-block-start-half\">\n              <button name=\"button\" type=\"submit\" class=\"btn btn--reversed\">\n                <img aria-hidden=\"true\" src=\"/assets/check-7897ff7e.svg\" />\n                <span class=\"for-screen-reader\">Save changes</span>\n</button>\n              <button name=\"button\" type=\"submit\" class=\"btn btn--negative\" form=\"delete_form_message_")
    html.escape(a, &out, m.client_id)
    a.append_str(&out, "\" data-turbo-confirm=\"Are you sure you want to delete this message?\">\n                <img aria-hidden=\"true\" src=\"/assets/trash-708c7eb2.svg\" />\n                <span class=\"for-screen-reader\">Delete message</span>\n</button>            </div>\n</form>        </div>\n    </div>\n\n    <div class=\"message__actions flex flex-wrap\">\n      <a class=\"message__action-btn message__edit-close-btn txt-small btn btn--borderless\" href=\"/rooms/")
    a.append_int(&out, m.room_id)
    a.append_str(&out, "/messages/")
    a.append_int(&out, m.id)
    a.append_str(&out, "\">\n        <img class=\"colorize--black\" aria-hidden=\"true\" src=\"/assets/remove-0e7a045d.svg\" />\n        <span class=\"for-screen-reader\">Close editor and discard changes</span>\n</a>    </div>\n\n    <form id=\"delete_form_message_")
    html.escape(a, &out, m.client_id)
    a.append_str(&out, "\" data-turbo-frame=\"edit_message_")
    html.escape(a, &out, m.client_id)
    a.append_str(&out, "\" action=\"/rooms/")
    a.append_int(&out, m.room_id)
    a.append_str(&out, "/messages/")
    a.append_int(&out, m.id)
    a.append_str(&out, "\" accept-charset=\"UTF-8\" method=\"post\"><input type=\"hidden\" name=\"_method\" value=\"delete\" />\n  </div>\n</turbo-frame>\n")
}

// messages.html
fn messages_index(a: Allocator, inout out: Buf(u8), messages: Buf(model.MessageView), inout frags: fragcache.Cache, inout cuts: Buf(i64)) void {
    for (messages) |m| {
    a.append_str(&out, "\n")
    cached_message(a, &out, &frags, &cuts, m)
    }
}

// presentation.html
fn presentation(a: Allocator, inout out: Buf(u8), m: model.MessageView) void {
    a.append_str(&out, "<div id=\"presentation_message_")
    html.escape(a, &out, m.client_id)
    a.append_str(&out, "\" dir=\"auto\" data-reply-target=\"body\" data-messages-target=\"body\">\n  <div class=\"lexxy-content\">\n  ")
    a.append_str(&out, m.body)
    a.append_str(&out, "\n</div>\n\n</div>\n")
}

// quick_boost.html
fn quick_boost(a: Allocator, inout out: Buf(u8), m: model.MessageView, ch: []u8, name: []u8) void {
    a.append_str(&out, "\n          <form data-turbo-frame=\"boosting_message_")
    html.escape(a, &out, m.client_id)
    a.append_str(&out, "\" data-action=\"popup#close\" action=\"/messages/")
    a.append_int(&out, m.id)
    a.append_str(&out, "/boosts\" accept-charset=\"UTF-8\" method=\"post\">\n            <input type=\"hidden\" name=\"boost[content]\" id=\"boost_content\" value=\"")
    a.append_str(&out, ch)
    a.append_str(&out, "\" />\n            <button name=\"button\" type=\"submit\" title=\"")
    a.append_str(&out, name)
    a.append_str(&out, "\" class=\"btn message__action-btn\" data-emoji=\"")
    a.append_str(&out, ch)
    a.append_str(&out, "\">\n              <figure class=\"margin-none boost-character\">")
    a.append_str(&out, ch)
    a.append_str(&out, "</figure>\n              <span class=\"for-screen-reader\">")
    a.append_str(&out, name)
    a.append_str(&out, "</span>\n</button></form>")
}

// recents.html
fn recents(a: Allocator, inout out: Buf(u8), recent: Buf(Buf(u8)), base: []u8) void {
    for (recent) |r| {
    a.append_str(&out, "\n      <a class=\"align-center gap room btn txt-nowrap\" href=\"/searches?q=")
    search_query(a, &out, r)
    a.append_str(&out, "\">\n        <span class=\"overflow-ellipsis\">“")
    html.escape(a, &out, r)
    a.append_str(&out, "”</span>\n</a>")
    }
    if (@len(recent) > 0) {
    a.append_str(&out, "\n      <form class=\"button_to\" method=\"post\" action=\"")
    a.append_str(&out, base)
    a.append_str(&out, "/searches/clear\"><input type=\"hidden\" name=\"_method\" value=\"delete\" /><button class=\"btn searches__btn\" data-turbo-confirm=\"Are you sure you want to clear your recent searches?\" type=\"submit\">\n        <img aria-hidden=\"true\" src=\"/assets/broom-13d30a95.svg\" />\n        <span class=\"for-screen-reader\">Clear recent searches</span>\n</button></form>")
    }
}

// room.html
fn room_show(a: Allocator, inout out: Buf(u8), user: model.UserView, room: model.RoomView, messages: Buf(model.MessageView), base: []u8, vapid: []u8, logo_v: []u8, admin: bool, loaded_ms: i64, stream: []u8, invite: bool, join_code: []u8, inout frags: fragcache.Cache, inout cuts: Buf(i64)) void {
    layout_top(a, &out, room.display, user, vapid, logo_v)
    a.append_str(&out, "\n\n\n  <meta name=\"turbo-cache-control\" content=\"no-preview\">\n  <meta name=\"current-room-id\" content=\"")
    a.append_int(&out, room.id)
    a.append_str(&out, "\">  </head>\n\n  <body class=\"sidebar")
    if (admin) {
    a.append_str(&out, " admin")
    }
    a.append_str(&out, "\" data-controller=\"local-time lightbox\">\n    <a href=\"#main-content\" class=\"skip-navigation btn\">Skip to main content</a>\n\n    <nav id=\"nav\">\n\n\n  <span class=\"btn btn--reversed btn--faux room--current\">\n    <h1 class=\"room__contents txt-medium overflow-ellipsis\">")
    if (room.kind == "direct") {
    a.append_str(&out, "\n        <span class=\"for-screen-reader\">Ping with</span>")
    }
    a.append_str(&out, "\n\n      ")
    html.escape(a, &out, room.display)
    a.append_str(&out, "\n    </h1>\n</span>\n\n  <a class=\"btn\" style=\"view-transition-name: edit-room-")
    a.append_int(&out, room.id)
    a.append_str(&out, "\" data-room-id=\"")
    a.append_int(&out, room.id)
    a.append_str(&out, "\" href=\"/rooms/")
    a.append_str(&out, room.kind)
    a.append_str(&out, "s/")
    a.append_int(&out, room.id)
    a.append_str(&out, "/edit\">\n    <img aria-hidden=\"true\" src=\"/assets/menu-dots-horizontal-f6a5d793.svg\" width=\"20\" height=\"20\" />\n    <span class=\"for-screen-reader\">Settings for this ")
    if (room.kind == "direct") {
    a.append_str(&out, "Ping")
    } else {
    a.append_str(&out, "room")
    }
    a.append_str(&out, "</span>\n</a>\n\n  <span>\n  <span class=\"button_to_change_notifying\"\n      data-controller=\"notifications\" data-notifications-subscriptions-url-value=\"/users/me/push_subscriptions\" data-notifications-attention-class=\"btn--pulsing\">\n    <turbo-frame data-controller=\"turbo-frame\" data-action=\"notifications:ready@window-&gt;turbo-frame#load\" data-turbo-frame-url-param=\"/rooms/")
    a.append_int(&out, room.id)
    a.append_str(&out, "/involvement\" id=\"involvement_rooms_")
    a.append_str(&out, room.kind)
    a.append_str(&out, "_")
    a.append_int(&out, room.id)
    a.append_str(&out, "\">\n      <button class=\"btn\" data-action=\"click->notifications#attemptToSubscribe\" data-notifications-target=\"bell\">\n        <img aria-hidden=\"true\" src=\"/assets/notification-bell-loading-7533ce55.svg\" width=\"20\" height=\"20\" />\n        <img aria-hidden=\"true\" hidden=\"hidden\" src=\"/assets/notification-bell-alert-b467cde7.svg\" width=\"20\" height=\"20\" />\n        <span class=\"for-screen-reader\">Notification settings for this ")
    if (room.kind == "direct") {
    a.append_str(&out, "Ping")
    } else {
    a.append_str(&out, "room")
    }
    a.append_str(&out, "</span>\n      </button>\n</turbo-frame>\n    <dialog data-notifications-target=\"notAllowedNotice\" class=\"dialog pad center center-block border-radius border shadow\" style=\"--inline-space: var(--block-space)\">\n      <div class=\"flex flex-column txt-align-center\">\n        <span class=\"btn btn--faux center txt-x-large\">\n          <img aria-hidden=\"true\" src=\"/assets/notification-bell-alert-b467cde7.svg\" width=\"48\" height=\"48\" />\n          <span class=\"for-screen-reader\">Notifications alert</span>\n        </span>\n\n        <section>\n          <h1 class=\"txt-large margin-none\">Notifications aren’t allowed</h1>\n          <div class=\"txt-align-start margin-block-start\">\n              <details class=\"notifications-help\" data-notifications-target=\"details\">\n    <summary class=\"btn\">\n      <img aria-hidden=\"true\" src=\"/assets/external/web-24ffe636.svg\" width=\"20\" height=\"20\" />\n      <strong>Check your Mozilla settings</strong>\n      <img aria-hidden=\"true\" class=\"disclosure\" src=\"/assets/disclosure-26d63471.svg\" width=\"10\" height=\"10\" />\n    </summary>\n\n        <p>Ensure notifications are enabled for <em>")
    a.append_str(&out, base)
    a.append_str(&out, "/</em> in your web browser settings.</p>\n  </details>\n\n            <details class=\"notifications-help hide-in-browser\" data-notifications-target=\"details\">\n  <summary class=\"btn\">\n    <img aria-hidden=\"true\" src=\"/assets/external/gear-50e77d2b.svg\" width=\"20\" height=\"20\" />\n    <strong>Check your  settings</strong>\n    <img aria-hidden=\"true\" class=\"disclosure\" src=\"/assets/disclosure-26d63471.svg\" width=\"10\" height=\"10\" />\n  </summary>\n\n      <p>Ensure notifications are allowed for Mozilla in your system settings.</p>\n</details>\n\n              <details class=\"notifications-help pwa__instructions hide-in-pwa\" data-controller=\"pwa-install\" data-pwa-install-prompting-class=\"pwa--can-install\" data-notifications-target=\"details\">\n    <summary class=\"btn\">\n      <img aria-hidden=\"true\" src=\"/assets/external/install-f762b3be.svg\" width=\"20\" height=\"20\" />\n      <strong>Install Campfire as a web app.</strong>\n      <img aria-hidden=\"true\" class=\"disclosure\" src=\"/assets/disclosure-26d63471.svg\" width=\"10\" height=\"10\" />\n    </summary>\n\n        <p>Some platforms require you to install Campfire as a web app to receive push notifications.</p>\n\n    <div class=\"margin-block-start txt-align-center pwa__installer\">\n      <hr class=\"separator margin-block\">\n      <button class=\"btn btn--reversed center\" data-action=\"pwa-install#promptInstall\">\n        <img aria-hidden=\"true\" src=\"/assets/external/install-f762b3be.svg\" />\n        Install now\n      </button>\n    </div>\n  </details>\n\n          </div>\n        </section>\n\n        <form method=\"dialog\" class=\"flex align-center gap center\">\n          <button class=\"btn dialog__close\" autofocus=\"true\">\n            <span class=\"for-screen-reader\">Close</span>\n            <img aria-hidden=\"true\" src=\"/assets/remove-0e7a045d.svg\" width=\"20\" height=\"20\" />\n          </button>\n        </form>\n      </div>\n    </dialog>\n  </span>\n</span>    </nav>\n\n\n    <main id=\"main-content\">\n\n<div id=\"message-area\" class=\"message-area\" contents=\"true\" data-controller=\"messages presence drop-target\" data-action=\"turbo:before-stream-render@document-&gt;messages#beforeStreamRender keydown.up@document-&gt;messages#editMyLastMessage dragenter-&gt;drop-target#dragenter dragover-&gt;drop-target#dragover drop-&gt;drop-target#drop visibilitychange@document-&gt;presence#visibilityChanged\" data-messages-first-of-day-class=\"message--first-of-day\" data-messages-formatted-class=\"message--formatted\" data-messages-me-class=\"message--me\" data-messages-mentioned-class=\"message--mentioned\" data-messages-threaded-class=\"message--threaded\" data-messages-page-url-value=\"")
    a.append_str(&out, base)
    a.append_str(&out, "/rooms/")
    a.append_int(&out, room.id)
    a.append_str(&out, "/messages\">\n  <script type=\"text/template\" data-messages-target=\"template\">\n  <div class=\"message message--me $messageClasses$\"\n      id=\"message_$clientMessageId$\"\n      data-format-message-target=\"message\"\n      data-user-id=\"")
    a.append_int(&out, user.id)
    a.append_str(&out, "\"\n      data-message-timestamp=\"$messageTimestamp$\"\n      data-messages-target=\"message\">\n    <div class=\"message__day-separator\"><time class=\"message__timestamp\" datetime=\"$messageDatetime$\" data-local-time-target=\"date\"></time></div>\n\n    <figure class=\"avatar message__avatar\">\n      <a title=\"")
    html.escape(a, &out, user.title)
    a.append_str(&out, "\" class=\"btn avatar\" data-turbo-frame=\"_top\" href=\"/users/")
    a.append_int(&out, user.id)
    a.append_str(&out, "\"><img aria-hidden=\"true\" src=\"")
    html.escape(a, &out, user.avatar)
    a.append_str(&out, "\" width=\"48\" height=\"48\" /></a>\n    </figure>\n\n    <div class=\"message__body\">\n      <div class=\"message__body-content\">\n        <div class=\"message__meta\">\n          <h3 class=\"message__heading\">\n            <span class=\"message__author\"><strong>")
    html.escape(a, &out, user.name)
    a.append_str(&out, "</strong></span>\n            <span class=\"message__permalink\"><time class=\"message__timestamp\" datetime=\"$messageDatetime$\" data-local-time-target=\"time\"></time></span>\n          </h3>\n          <div class=\"message__actions\">\n            <div class=\"position-relative\">\n              <span class=\"btn message__action-btn message__options-btn\">\n                <img class=\"colorize--black\" aria-hidden=\"true\" src=\"/assets/menu-dots-horizontal-f6a5d793.svg\" />\n                <span class=\"for-screen-reader\">Message options</span>\n              </span>\n            </div class=\"position-relative\">\n          </div>\n        </div>\n        $body$\n      </div>\n    </div>\n  </div>\n</script>\n\n  <div id=\"messages_rooms_")
    a.append_str(&out, room.kind)
    a.append_str(&out, "_")
    a.append_int(&out, room.id)
    a.append_str(&out, "\" class=\"messages\" data-controller=\"maintain-scroll refresh-room\" data-action=\"turbo:before-stream-render@document-&gt;maintain-scroll#beforeStreamRender visibilitychange@document-&gt;refresh-room#visibilityChanged online@window-&gt;refresh-room#online\" data-messages-target=\"messages\" data-refresh-room-loaded-at-value=\"")
    a.append_int(&out, loaded_ms)
    a.append_str(&out, "\" data-refresh-room-url-value=\"")
    a.append_str(&out, base)
    a.append_str(&out, "/rooms/")
    a.append_int(&out, room.id)
    a.append_str(&out, "/refresh\">")
    if (invite) {
    a.append_str(&out, "\n    <div id=\"system_welcome\" class=\"message message--formatted txt-align-center center\">\n    <div class=\"message__body center\">\n      <div class=\"message__body-content position-relative\">\n        <figure class=\"account-logo avatar center margin-block-end txt-large\"><img alt=\"Account logo\" src=\"/account/logo?v=")
    a.append_str(&out, logo_v)
    a.append_str(&out, "\" width=\"300\" height=\"300\" /></figure>\n        <div class=\"flex align-center gap\">\n          <div class=\"system-welcome--translation\">\n            <details class=\"position-relative\" data-controller=\"popup\" data-action=\"keydown.esc-&gt;popup#close toggle-&gt;popup#toggle click@document-&gt;popup#closeOnClickOutside\" data-popup-orientation-top-class=\"popup-orientation-top\"><summary class=\"btn\" tabindex=\"-1\"><img aria-hidden=\"true\" class=\"color-icon\" src=\"/assets/globe-8c54d23b.svg\" width=\"20\" height=\"20\" /><span class=\"for-screen-reader\">Translate</span></summary><div class=\"language-list-menu shadow\" data-popup-target=\"menu\"><dl class=\"language-list\"><dt>🇺🇸</dt><dd class=\"margin-none\">Welcome to Campfire. To invite some people to chat with you, share the join link below.</dd><dt>🇪🇸</dt><dd class=\"margin-none\">Bienvenido a Campfire. Para invitar a algunas personas a chatear contigo, comparte el enlace de unión que se encuentra a continuación.</dd><dt>🇫🇷</dt><dd class=\"margin-none\">Bienvenue sur Campfire. Pour inviter des personnes à discuter avec vous, partagez le lien pour rejoindre ci-dessous.</dd><dt>🇮🇳</dt><dd class=\"margin-none\">Campfire में आपका स्वागत है। अधिक लोगों को चैट के लिए आमंत्रित करने के लिए, नीचे जुड़ने का लिंक साझा करें।</dd><dt>🇩🇪</dt><dd class=\"margin-none\">Willkommen bei Campfire. Um einige Personen zum Chatten einzuladen, teilen Sie den unten stehenden Beitrittslink.</dd><dt>🇧🇷</dt><dd class=\"margin-none\">Boas vindas ao Campfire. Para convidar pessoas para conversarem com você, compartilhe o link de convite abaixo.</dd><dt>🇯🇵</dt><dd class=\"margin-none\">Campfireへようこそ。他の人をチャットに招待するには、下記の参加リンクを共有してください。</dd></dl></div></details>\n          </div>\n          <p>\n            <strong>Welcome to Campfire</strong><br>\n            To invite people to chat, share the join link below.\n          </p>\n        </div>\n        ")
    invite_link(a, &out, base, join_code, admin)
    a.append_str(&out, "\n      </div>\n    </div>\n  </div>")
    }
    for (messages) |m| {
    a.append_str(&out, "\n    ")
    cached_message(a, &out, &frags, &cuts, m)
    }
    a.append_str(&out, "\n  </div>\n\n  <turbo-cable-stream-source channel=\"RoomMessagesChannel\" signed-stream-name=\"")
    a.append_str(&out, stream)
    a.append_str(&out, "\"></turbo-cable-stream-source>\n  <button class=\"message-area__return-to-latest btn\" data-action=\"messages#returnToLatest\" data-messages-target=\"latest\" hidden=\"hidden\"><img aria-hidden=\"true\" src=\"/assets/arrow-down-3f174d76.svg\" width=\"20\" height=\"20\" /><span class=\"for-screen-reader\">Jump to newest message</span></button>\n</div>\n      <footer id=\"footer\">\n<div class=\"composer flex align-end gap position-relative\"\n      data-controller=\"typing-notifications\" data-typing-notifications-active-class=\"typing-indicator--active\">\n    <a class=\"btn flex-item-no-shrink margin-block-end composer__context-btn\" style=\"view-transition-name: input-switcher\" href=\"/searches\">\n      <img aria-hidden=\"true\" src=\"/assets/search-5f29565f.svg\" width=\"20\" height=\"20\" />\n      <span class=\"for-screen-reader\">Search</span>\n</a>\n    <turbo-frame id=\"composer-frame\">\n      <form id=\"composer\" class=\"margin-block flex-item-grow contain\" data-controller=\"composer drop-target\" data-action=\"dragenter-&gt;drop-target#dragenter dragover-&gt;drop-target#dragover drop-&gt;drop-target#drop drop-target:drop@window-&gt;composer#dropFiles lexxy:file-accept-&gt;composer#preventAttachment refresh-room:online@window-&gt;composer#online typing-notifications#stop paste-&gt;composer#pasteFiles turbo:submit-end-&gt;composer#submitEnd refresh-room:offline@window-&gt;composer#offline\" data-composer-messages-outlet=\"#message-area\" data-composer-toolbar-class=\"composer--rich-text\" data-composer-room-id-value=\"")
    a.append_int(&out, room.id)
    a.append_str(&out, "\" action=\"/rooms/")
    a.append_int(&out, room.id)
    a.append_str(&out, "/messages\" accept-charset=\"UTF-8\" method=\"post\">\n        <fieldset data-composer-target=\"fields\" contents>\n          <div class=\"flex flex-column\">\n            <div class=\"composer__filelist flex flex--align-center gap flex-wrap\" data-composer-target=\"fileList\"></div>\n\n            <div class=\"flex composer__input input input--actor fill-white min-width\" style=\"--input-border-radius: 1.3rem\">\n              <div class=\"flex align-end gap full-width\">\n                <img aria-hidden=\"true\" class=\"composer__input-hint colorize--black\" style=\"view-transition-name: input-btn;\" src=\"/assets/messages-outlined-87ff0331.svg\" width=\"22\" height=\"22\" />\n\n                <div class=\"flex flex-column flex-item-grow min-width gap\">\n                  <lexxy-editor rows=\"1\" class=\"input lexxy-content\" style=\"order: -1\" aria-multiline=\"true\" aria-label=\"Write a message\" permitted-attachment-types=\"application/vnd.campfire.mention application/vnd.actiontext.opengraph-embed\" data-controller=\"unfurl\" data-action=\"lexxy:change-&gt;typing-notifications#start keydown-&gt;composer#submitByKeyboard:capture lexxy:change-&gt;composer#saveDraft lexxy:insert-link-&gt;unfurl#unfurl\" data-composer-target=\"text\" data-direct-upload-url=\"")
    a.append_str(&out, base)
    a.append_str(&out, "/rails/active_storage/direct_uploads\" data-blob-url-template=\"")
    a.append_str(&out, base)
    a.append_str(&out, "/rails/active_storage/blobs/redirect/:signed_id/:filename\" id=\"message_body\" input=\"message_body_trix_input_message\" name=\"message[body]\">\n                    <lexxy-prompt trigger=\"@\" name=\"mention\" src=\"/autocompletable/users?room_id=")
    a.append_int(&out, room.id)
    a.append_str(&out, "\" remote-filtering=\"true\" empty-results=\"No matches\"></lexxy-prompt>\n</lexxy-editor>                </div>\n\n                <label class=\"btn btn--borderless txt-small flex-item-no-shrink composer__attachment-btn input--file\">\n                  <img class=\"colorize--black\" aria-hidden=\"true\" src=\"/assets/attachment-8bcccab0.svg\" width=\"22\" height=\"22\" />\n                  <input type=\"file\" data-action=\"composer#filePicked\" multiple />\n                  <span class=\"for-screen-reader\">Attach a file</span>\n                </label>\n\n                <button class=\"btn btn--borderless txt-small flex-item-no-shrink composer__rich-text-btn\" type=\"button\" data-action=\"composer#toggleToolbar\">\n                  <img class=\"colorize--black\" aria-hidden=\"true\" src=\"/assets/text-options-055e0d16.svg\" width=\"20\" height=\"20\" />\n                  <span class=\"for-screen-reader\">Rich text</span>\n                </button>\n\n                <button name=\"send\" type=\"submit\" data-action=\"composer#submit\" class=\"btn btn--reversed flex-item-no-shrink txt-small\">\n                  <img aria-hidden=\"true\" src=\"/assets/arrow-up-f96b3895.svg\" width=\"20\" height=\"20\" />\n                  <span class=\"for-screen-reader\">Send Message</span>\n</button>              </div>\n            </div>\n          </div>\n        </fieldset>\n\n        <div class=\"typing-indicator gap txt-small align-center flex-inline\" data-typing-notifications-target=\"indicator\">\n          <div class=\"typing-indicator__author spinner\" data-typing-notifications-target=\"author\"></div>\n        </div>\n\n        <input data-composer-target=\"clientid\" type=\"hidden\" name=\"message[client_message_id]\" id=\"message_client_message_id\" />\n</form>    </turbo-frame>\n  </div>      </footer>\n    </main>\n\n    <aside id=\"sidebar\" data-controller=\"toggle-class\" data-toggle-class-toggle-class=\"open\">\n<turbo-frame data-turbo-permanent=\"true\" data-controller=\"rooms-list read-rooms turbo-frame\" data-rooms-list-unread-class=\"unread\" data-action=\"presence:present@window->rooms-list#read read-rooms:read->rooms-list#read turbo:frame-load->rooms-list#loaded refresh-room:visible@window->turbo-frame#reload\" id=\"user_sidebar\" src=\"/users/me/sidebar\" target=\"_top\"></turbo-frame>    </aside>\n\n")
    layout_bottom(a, &out)
}

// search.html
fn search_index(a: Allocator, inout out: Buf(u8), user: model.UserView, messages: Buf(model.MessageView), recent: Buf(Buf(u8)), has_query: bool, query: []u8, has_q: bool, q: []u8, return_room: i64, base: []u8, vapid: []u8, logo_v: []u8, admin: bool, inout frags: fragcache.Cache, inout cuts: Buf(i64)) void {
    layout_top(a, &out, "Search", user, vapid, logo_v)
    a.append_str(&out, "\n\n  </head>\n\n  <body class=\"sidebar searches")
    if (admin) {
    a.append_str(&out, " admin")
    }
    a.append_str(&out, "\" data-controller=\"local-time lightbox\">\n    <a href=\"#main-content\" class=\"skip-navigation btn\">Skip to main content</a>\n\n    <nav id=\"nav\">\n")
    if (has_query) {
    a.append_str(&out, "\n    <div class=\"searches__query flex align-center gap pad-block-start-half\">\n      <div class=\"btn btn--reversed btn--faux align-center gap txt-nowrap\">\n        <span class=\"overflow-ellipsis\">“")
    html.escape(a, &out, query)
    a.append_str(&out, "”</span>\n        <span class=\"flex-item-no-shrink\">")
    a.append_int(&out, @len(messages))
    a.append_str(&out, "</span>\n</div>    </div>")
    }
    a.append_str(&out, "\n\n  <div class=\"searches__recents align-center gap pad-block-half overflow-y overflow-hide-scrollbar\">\n    ")
    recents(a, &out, recent, base)
    a.append_str(&out, "\n  </div>    </nav>\n\n\n    <main id=\"main-content\">\n\n<div id=\"message-area\" class=\"message-area\">\n  <div class=\"message-area--empty min-width center\">\n    <figure class=\"center pad\">\n      <img aria-hidden=\"true\" class=\"colorize--black translucent\" src=\"/assets/search-5f29565f.svg\" />\n    </figure>\n  </div>\n\n  <div id=\"search-results\" class=\"messages searches__results\" data-controller=\"search-results\" data-search-results-target=\"messages\" data-search-results-me-class=\"message--me\" data-search-results-threaded-class=\"message--threaded\" data-search-results-mentioned-class=\"message--mentioned\" data-search-results-formatted-class=\"message--formatted\">")
    for (messages) |m| {
    a.append_str(&out, "\n    ")
    cached_message(a, &out, &frags, &cuts, m)
    }
    a.append_str(&out, "\n  </div></div>\n      <footer id=\"footer\">\n\n  <div class=\"composer flex align-end gap\">\n    <a class=\"btn flex-item-no-shrink margin-block-end\" style=\"view-transition-name: input-switcher; --btn-border-radius: 0.5em\" href=\"/rooms/")
    a.append_int(&out, return_room)
    a.append_str(&out, "\">\n      <img aria-hidden=\"true\" src=\"/assets/arrow-left-abe40556.svg\" />\n      <span class=\"for-screen-reader\">Exit search </span>\n</a>\n    <form class=\"margin-block flex-item-grow contain flex align-center gap\" data-controller=\"form\" data-action=\"keydown.esc-&gt;form#cancel\" action=\"/searches\" accept-charset=\"UTF-8\" method=\"post\">\n      <div class=\"composer__input flex align-center flex-item-grow gap full-width input input--actor min-width\">\n        <img aria-hidden=\"true\" class=\"composer__input-hint colorize--black\" style=\"view-transition-name: input-btn;\" src=\"/assets/search-5f29565f.svg\" width=\"20\" height=\"20\" />\n\n        <input")
    if (has_q) {
    a.append_str(&out, " value=\"")
    html.escape(a, &out, q)
    a.append_str(&out, "\"")
    }
    a.append_str(&out, " class=\"searches__input input flex-item-grow\" role=\"searchbox\" aria-label=\"search\" autofocus=\"autofocus\" required=\"required\" type=\"text\" name=\"q\" id=\"q\" />\n\n        <a data-form-target=\"cancel\" role=\"button\" class=\"searches__reset\" href=\"/searches\">\n          <img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/remove-0e7a045d.svg\" width=\"14\" height=\"14\" />\n          <span class=\"for-screen-reader\">Clear search field</span>\n</a>\n        <button name=\"button\" type=\"submit\" class=\"btn btn--reversed flex-item-no-shrink txt-small\" style=\"--btn-border-radius: 0.5em\">\n          <img aria-hidden=\"true\" src=\"/assets/arrow-up-f96b3895.svg\" />\n          <span class=\"for-screen-reader\">Search</span>\n</button>      </div>\n</form>  </div>      </footer>\n    </main>\n\n    <aside id=\"sidebar\" data-controller=\"toggle-class\" data-toggle-class-toggle-class=\"open\">\n\n  <div class=\"rooms position-relative flex flex-column gap overflow-y overflow-hide-scrollbar\">\n    ")
    recents(a, &out, recent, base)
    a.append_str(&out, "\n  </div>    </aside>\n\n")
    layout_bottom(a, &out)
}

// service_worker.html
fn service_worker(a: Allocator, inout out: Buf(u8)) void {
    a.append_str(&out, "self.addEventListener(\"push\", async (event) => {\n  const data = await event.data.json()\n  event.waitUntil(Promise.all([ showNotification(data), updateBadgeCount(data.options) ]))\n})\n\nasync function showNotification({ title, options }) {\n  return self.registration.showNotification(title, options)\n}\n\nasync function updateBadgeCount({ data: { badge } }) {\n  return self.navigator.setAppBadge?.(badge || 0)\n}\n\nself.addEventListener(\"notificationclick\", (event) => {\n  event.notification.close()\n\n  const url = new URL(event.notification.data.path, self.location.origin).href\n  event.waitUntil(openURL(url))\n})\n\nasync function openURL(url) {\n  const clients = await self.clients.matchAll({ type: \"window\" })\n  const focused = clients.find((client) => client.focused)\n\n  if (focused) {\n    await focused.navigate(url)\n  } else {\n    await self.clients.openWindow(url)\n  }\n}\n")
}

// sidebar.html
fn sidebar_show(a: Allocator, inout out: Buf(u8), user: model.UserView, sb: model.Sidebar, vapid: []u8, logo_v: []u8, admin: bool, can_create_rooms: bool, rooms_stream: []u8, user_stream: []u8) void {
    layout_top(a, &out, "Campfire", user, vapid, logo_v)
    a.append_str(&out, "\n\n  </head>\n\n  <body class=\"")
    if (admin) {
    a.append_str(&out, "admin")
    }
    a.append_str(&out, "\" data-controller=\"local-time lightbox\">\n    <a href=\"#main-content\" class=\"skip-navigation btn\">Skip to main content</a>\n\n    <nav id=\"nav\">\n    </nav>\n\n\n    <main id=\"main-content\">\n<turbo-frame data-turbo-permanent=\"true\" data-controller=\"rooms-list read-rooms turbo-frame\" data-rooms-list-unread-class=\"unread\" data-action=\"presence:present@window->rooms-list#read read-rooms:read->rooms-list#read turbo:frame-load->rooms-list#loaded refresh-room:visible@window->turbo-frame#reload\" id=\"user_sidebar\" target=\"_top\">\n  <turbo-cable-stream-source channel=\"Turbo::StreamsChannel\" signed-stream-name=\"")
    a.append_str(&out, rooms_stream)
    a.append_str(&out, "\"></turbo-cable-stream-source>\n  <turbo-cable-stream-source channel=\"Turbo::StreamsChannel\" signed-stream-name=\"")
    a.append_str(&out, user_stream)
    a.append_str(&out, "\"></turbo-cable-stream-source>\n\n  <div class=\"sidebar__container overflow-y overflow-hide-scrollbar\"\n      data-controller=\"badge-dot\"\n      data-badge-dot-unread-class=\"unread\"\n      data-action=\"rooms-list:unread@window->badge-dot#update rooms-list:read@window->badge-dot#update turbo:submit-start->turbo-frame#unpermanize\">\n    <turbo-frame id=\"direct_rooms_control\" target=\"_top\">\n      <div class=\"directs gap overflow-x overflow-hide-scrollbar\">\n        <a class=\"direct direct__new\" data-turbo-frame=\"_self\" href=\"/rooms/directs/new\">\n          <span class=\"avatar avatar--icon\">\n            <img aria-hidden=\"true\" class=\"colorize--black\" src=\"/assets/messages-add-d229e6c2.svg\" width=\"20\" height=\"20\" />\n          </span>\n\n          <span class=\"direct__author flex max-width min-width border-radius pad-inline-half\">\n            <span class=\"for-screen-reader\">New</span>\n            <span class=\"txt-small overflow-clip\">Ping</span>\n          </span>\n</a>\n        <div id=\"direct_rooms\" contents data-controller=\"sorted-list\" data-action=\"rooms-list:unread@window->sorted-list#updateItem\">\n          ")
    for (sb.directs) |d| {
    sidebar_direct(a, &out, d)
    }
    a.append_str(&out, "        </div>\n\n        <div contents>\n          ")
    for (sb.placeholders) |u| {
    sidebar_placeholder(a, &out, u)
    }
    a.append_str(&out, "        </div>\n      </div>\n    </turbo-frame>\n\n    <div class=\"rooms position-relative flex flex-column gap\">\n      <div id=\"shared_rooms\" contents data-controller=\"sorted-list\">\n")
    for (sb.rooms) |r| {
    sidebar_room(a, &out, r)
    }
    a.append_str(&out, "      </div>\n\n")
    if (can_create_rooms) {
    a.append_str(&out, "        <a class=\"rooms__new-btn btn room align-center gap txt-reversed\" aria-label=\"New Chat Room\" href=\"/rooms/opens/new\">\n          <img aria-hidden=\"true\" style=\"view-transition-name: new-room\" src=\"/assets/add-f232d8a6.svg\" width=\"20\" height=\"20\" />\n</a>")
    }
    a.append_str(&out, "    </div>\n\n    <button class=\"btn sidebar__toggle\" data-action=\"toggle-class#toggle\">\n      <img aria-hidden=\"true\" src=\"/assets/menu-5462dfd3.svg\" width=\"20\" height=\"20\" />\n      <span class=\"for-screen-reader\">Open menu</span>\n    </button>\n  </div>\n\n  <div class=\"flex align-end sidebar__tools gap justify-end\">\n    <a class=\"btn avatar flex-item-no-shrink sidebar__tool\" href=\"/users/me/profile\">\n      <img aria-hidden=\"true\" style=\"view-transition-name: avatar-")
    a.append_int(&out, user.id)
    a.append_str(&out, "\" src=\"")
    html.escape(a, &out, user.avatar)
    a.append_str(&out, "\" width=\"48\" height=\"48\" />\n      <span class=\"for-screen-reader\">My Settings</span>\n</a>\n    <a class=\"btn align-center gap txt-reversed sidebar__tool\" href=\"/account/edit\">\n      <img aria-hidden=\"true\" style=\"view-transition-name: account-settings\" src=\"/assets/settings-aee56972.svg\" width=\"20\" height=\"20\" />\n      <span class=\"for-screen-reader\">Account Settings</span>\n</a>  </div>\n</turbo-frame>\n      <footer id=\"footer\">\n      </footer>\n    </main>\n\n    <aside id=\"sidebar\" data-controller=\"toggle-class\" data-toggle-class-toggle-class=\"open\">\n    </aside>\n\n")
    layout_bottom(a, &out)
}

// sidebar_direct.html
fn sidebar_direct(a: Allocator, inout out: Buf(u8), d: model.SidebarDirect) void {
    a.append_str(&out, "\n  <a class=\"direct")
    if (d.unread) {
    a.append_str(&out, " unread")
    }
    a.append_str(&out, "\" id=\"list_rooms_direct_")
    a.append_int(&out, d.room_id)
    a.append_str(&out, "\" data-rooms-list-target=\"room\" data-room-id=\"")
    a.append_int(&out, d.room_id)
    a.append_str(&out, "\" data-badge-dot-target=\"unread\" data-sorted-list-target=\"item\" data-sorted-list-number=\"")
    a.append_int(&out, tf.epoch_ms(d.updated_ns))
    a.append_str(&out, "\" href=\"/rooms/")
    a.append_int(&out, d.room_id)
    a.append_str(&out, "\">\n")
    if (@len(d.members) > 1) {
    a.append_str(&out, "      <div class=\"avatar__group\">\n")
    var shown = 0
    for (d.members) |m| {
    if (shown < 4) {
    a.append_str(&out, "          <span class=\"avatar\">\n            <img aria-hidden=\"true\" src=\"")
    html.escape(a, &out, m.avatar)
    a.append_str(&out, "\" width=\"20\" height=\"20\" />\n          </span>\n")
    }
    shown = shown + 1
    }
    a.append_str(&out, "      </div>\n")
    } else {
    a.append_str(&out, "      <span class=\"avatar\">\n        <img aria-hidden=\"true\" src=\"")
    html.escape(a, &out, d.members[0].avatar)
    a.append_str(&out, "\" width=\"48\" height=\"48\" />\n      </span>\n")
    }
    a.append_str(&out, "\n    <span class=\"direct__author flex align-center gap max-width min-width border-radius txt-small\">\n      <span class=\"txt-nowrap overflow-ellipsis\">\n        <span class=\"for-screen-reader\">Ping with</span>\n")
    if (@len(d.members) > 1) {
    a.append_str(&out, "          ")
    initials(a, &out, d.members)
    a.append_str(&out, "\n")
    } else {
    a.append_str(&out, "          ")
    first_name(a, &out, d.members[0].name)
    a.append_str(&out, "\n")
    }
    a.append_str(&out, "      </span>\n    </span>\n</a>")
}

// sidebar_placeholder.html
fn sidebar_placeholder(a: Allocator, inout out: Buf(u8), u: model.UserView) void {
    a.append_str(&out, "<form class=\"button_to\" method=\"post\" action=\"/rooms/directs?user_ids%5B%5D=")
    a.append_int(&out, u.id)
    a.append_str(&out, "\"><button class=\"direct borderless fill-transparent unpad\" type=\"submit\">\n  <span class=\"avatar\">\n    <img aria-hidden=\"true\" src=\"")
    html.escape(a, &out, u.avatar)
    a.append_str(&out, "\" />\n  </span>\n\n  <span class=\"direct__author flex align-center gap max-width min-width border-radius txt-small\">\n    <span class=\"txt-nowrap overflow-ellipsis\">\n      <span class=\"for-screen-reader\">Start a ping with</span>\n      ")
    first_name(a, &out, u.name)
    a.append_str(&out, "\n    </span>\n  </span>\n</button></form>")
}

// sidebar_room.html
fn sidebar_room(a: Allocator, inout out: Buf(u8), r: model.SidebarRoom) void {
    a.append_str(&out, "          <a id=\"list_rooms_")
    a.append_str(&out, r.kind)
    a.append_str(&out, "_")
    a.append_int(&out, r.id)
    a.append_str(&out, "\" data-rooms-list-target=\"room\" data-room-id=\"")
    a.append_int(&out, r.id)
    a.append_str(&out, "\" data-badge-dot-target=\"unread\" data-sorted-list-target=\"item\" data-sorted-list-name=\"")
    html.escape(a, &out, r.name)
    a.append_str(&out, "\" style=\"--column-gap: 0.5em\" class=\"align-center gap room btn txt-nowrap")
    if (r.unread) {
    a.append_str(&out, " unread")
    }
    a.append_str(&out, "\" href=\"/rooms/")
    a.append_int(&out, r.id)
    a.append_str(&out, "\">\n  <span class=\"overflow-ellipsis\">")
    html.escape(a, &out, r.name)
    a.append_str(&out, "</span>\n</a>")
}
