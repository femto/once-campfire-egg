// Generated by script/templates.rb from templates/. Do not edit.
uses alloc

const html = @import("html.egg")
const tf = @import("timefmt.egg")
const model = @import("model.egg")
const static_head = @import("static_head.egg")

// The quick boosts of the message menu: the character, then its title.
const QUICK_BOOSTS = "👍Thumbs up|👏Clapping|👋Waving hand|💪Muscle|❤️Red heart|😂Face with tears of joy|🎉Party popper|🔥Fire"

// Where the item of QUICK_BOOSTS starting at from ends.
fn bar_at(s: []u8, from: i64) i64 {
    var i = from
    while (i < @len(s) and s[i] != '|') {
        i = i + 1
    }
    return i
}

// Where an item's title starts: its first capital letter.
fn first_letter(item: []u8) i64 {
    var i = 0
    while (i < @len(item) and !(item[i] >= 'A' and item[i] <= 'Z')) {
        i = i + 1
    }
    return i
}

// The quick boost forms of a message's menu.
fn quick_boosts(a: Allocator, inout out: Buf(u8), m: model.MessageView) void {
    var at = 0
    while (at < @len(QUICK_BOOSTS)) {
        const bar = bar_at(QUICK_BOOSTS, at)
        const split = at + first_letter(QUICK_BOOSTS[at..bar])
        quick_boost(a, &out, m, QUICK_BOOSTS[at..split], QUICK_BOOSTS[split..bar])
        at = bar + 1
    }
}

// The first word of a name (name.split(' ')[0]), HTML-escaped.
fn first_name(a: Allocator, inout out: Buf(u8), name: []u8) void {
    var start = 0
    while (start < @len(name) and name[start] == ' ') {
        start = start + 1
    }
    var end = start
    while (end < @len(name) and name[end] != ' ') {
        end = end + 1
    }
    html.escape(a, &out, name[start..end])
}

// Each member's initials, from the first three words of the name, as a
// sentence ("J+K", "J, K, and J").
fn initials(a: Allocator, inout out: Buf(u8), members: Buf(model.UserView)) void {
    var i = 0
    while (i < @len(members)) {
        if (i > 0) {
            if (@len(members) == 2) {
                a.append_str(&out, "+")
            } else if (i == @len(members) - 1) {
                a.append_str(&out, ", and ")
            } else {
                a.append_str(&out, ", ")
            }
        }
        const name = members[i].name[0..]
        var words = 0
        var k = 0
        while (k < @len(name) and words < 3) {
            if (name[k] != ' ' and (k == 0 or name[k - 1] == ' ')) {
                var c = name[k]
                if (c >= 'a' and c <= 'z') {
                    c = c - 32
                }
                // The first character: a whole UTF-8 sequence.
                var end = k + 1
                while (end < @len(name) and name[end] >= 0x80 and name[end] < 0xC0) {
                    end = end + 1
                }
                var one: Buf(u8) = .empty
                defer a.free(one)
                a.push(&one, c)
                a.append_str(&one, name[k + 1..end])
                html.escape(a, &out, one)
                words = words + 1
            }
            k = k + 1
        }
        i = i + 1
    }
}

// boost.html
fn boost(a: Allocator, inout out: Buf(u8), b: model.BoostView, message_id: i64) void {
    a.append_str(&out, "\n      <div id=\"boost_")
    a.append_int(&out, b.id)
    a.append_str(&out, "\"\n      class=\"boost boost-item flex-inline postion--relative max-width align-center fill-white gap\"\n      data-controller=\"boost-delete\" data-boost-delete-perform-class=\"boost--deleting\" data-boost-delete-reveal-class=\"expanded\" data-boost-delete-booster-id-value=\"")
    a.append_int(&out, b.booster.id)
    a.append_str(&out, "\">\n    <figure class=\"avatar boost__avatar flex-item-no-shrink\">\n      <a title=\"")
    html.escape(a, &out, b.booster.title)
    a.append_str(&out, "\" class=\"btn avatar\" data-turbo-frame=\"_top\" href=\"/users/")
    a.append_int(&out, b.booster.id)
    a.append_str(&out, "\"><img aria-label=\"")
    html.escape(a, &out, b.booster.name)
    a.append_str(&out, " boosted ")
    html.escape(a, &out, b.content)
    a.append_str(&out, "\" src=\"")
    html.escape(a, &out, b.booster.avatar)
    a.append_str(&out, "\" width=\"48\" height=\"48\" /></a>\n    </figure>\n\n    <span role=\"button\" class=\"txt-small")
    if (b.all_emoji) {
    a.append_str(&out, " txt-medium")
    }
    a.append_str(&out, "\" data-action=\"click-&gt;boost-delete#reveal keydown.enter-&gt;boost-delete#reveal:prevent\" data-boost-delete-target=\"content\">")
    html.escape(a, &out, b.content)
    a.append_str(&out, "</span>\n\n    <form class=\"button_to\" method=\"post\" action=\"/messages/")
    a.append_int(&out, message_id)
    a.append_str(&out, "/boosts/")
    a.append_int(&out, b.id)
    a.append_str(&out, "\"><input type=\"hidden\" name=\"_method\" value=\"delete\" /><button data-action=\"boost-delete#perform\" data-boost-delete-target=\"button\" class=\"btn btn--negative flex-item-justify-end boost__delete\" type=\"submit\">\n      <img aria-hidden=\"true\" src=\"/assets/minus-b31a1093.svg\" width=\"20\" height=\"20\" />\n      <span class=\"for-screen-reader\">Delete this boost</span>\n</button></form>  </div>\n  <span id=\"delete_boost_accessible_label\" class=\"for-screen-reader\">Press enter to delete this boost</span>")
}

