// Routing, and what one worker keeps between requests.
uses alloc, fs, net, rand, thread, time

const http = @import("http.egg")
const html = @import("html.egg")
const sqlite = @import("sqlite.egg")
const codec = @import("codec.egg")
const cookie = @import("cookie.egg")
const session = @import("session.egg")
const model = @import("model.egg")
const views = @import("views.egg")
const signed_id = @import("signed_id.egg")
const turbo = @import("turbo.egg")
const tf = @import("timefmt.egg")
const text = @import("std/text")
const public_pages = @import("public_pages.egg")
const respcache = @import("respcache.egg")
const filecache = @import("filecache.egg")
const fragcache = @import("fragcache.egg")
const splice = @import("splice.egg")
const ws = @import("ws.egg")
const cable = @import("cable.egg")
const json = @import("json.egg")
const crypto = @import("crypto.egg")
const gzip = @import("gzip.egg")
const platform = @import("platform.egg")
const push = @import("push.egg")
const flash = @import("flash.egg")
const uploads = @import("uploads.egg")
const sanitize = @import("sanitize.egg")
const richtext = @import("richtext.egg")
const media = @import("media.egg")
const bot_hooks = @import("webhook.egg")
const webhook_http = @import("webhook_http.egg")
const qrcode = @import("qr.egg")

// What main reads from the environment for the workers.
const Config = struct {
    db_path: str
    secret: str
    vapid: str
    push_private: str
    push_subject: str
    push_allow_local: bool
    // Active Storage's root, and the precompiled assets.
    files: str
    assets: str
    // Keep messages' HTML and gzip, and whole responses unless
    // response_cache is off (by default; CAMPFIRE_CACHE=0 turns them all off,
    // CAMPFIRE_RESPONSE_CACHE=0 only whole responses).
    cache: bool
    response_cache: bool
}

const Context = owned struct {
    db: sqlite.Db
    // Keys derived from SECRET_KEY_BASE once: signed cookies, signed ids
    // (avatar URLs) and signed stream names.
    key: Buf(u8)
    flash_key: Buf(u8)
    mention_key: Buf(u8)
    sid_key: Buf(u8)
    stream_key: Buf(u8)
    vapid: Buf(u8)
    push_private: Buf(u8)
    push_subject: str
    push_allow_local: bool
    clock: Clock
    rng: Random
    fs: Fs
    files: str
    assets: str
    cache: respcache.Cache
    files_sent: filecache.Cache
    frags: fragcache.Cache
    pieces: splice.Store
    // The write token: take it, write, hand it back (see main).
    lock_rx: Receiver(bool)
    lock_tx: Sender(bool)
    // Where a WebSocket goes once signed in, and what is broadcast to
    // them (see cable).
    cable: Sender(cable.Upgrade)
    hub: Sender(cable.Cmd)

    fn close(sink self: Context, a: Allocator) void {
        self.db.close()
        self.lock_rx.close()
        self.lock_tx.close()
        self.cable.close()
        self.hub.close()
        self.cache.close(a)
        self.files_sent.close(a)
        self.frags.close(a)
        self.pieces.close(a)
        a.free(self.key)
        a.free(self.flash_key)
        a.free(self.mention_key)
        a.free(self.sid_key)
        a.free(self.stream_key)
        a.free(self.push_private)
        a.free(self.vapid)
        @forget(self)
    }
}

fn open(a: Allocator, cfg: Config, clock: Clock, rng: Random, files: Fs, sink lock_rx: Receiver(bool), sink lock_tx: Sender(bool), sink cable_tx: Sender(cable.Upgrade), sink hub_tx: Sender(cable.Cmd)) !Context {
    const db = sqlite.open(a, cfg.db_path) catch |e| {
        lock_rx.close()
        lock_tx.close()
        cable_tx.close()
        hub_tx.close()
        return e
    }
    const cache = respcache.open(a, cfg.db_path, cfg.cache, cfg.cache and cfg.response_cache) catch |e| {
        db.close()
        lock_rx.close()
        lock_tx.close()
        cable_tx.close()
        hub_tx.close()
        return e
    }
    const secret = cfg.secret
    return Context{
        .db = db,
        .key = cookie.key(a, secret),
        .flash_key = flash.key(a, secret),
        .mention_key = bot_hooks.key(a, secret),
        .sid_key = signed_id.key(a, secret),
        .stream_key = turbo.key(a, secret),
        .vapid = a.concat(cfg.vapid, ""),
        .push_private = a.concat(cfg.push_private, ""),
        .push_subject = cfg.push_subject,
        .push_allow_local = cfg.push_allow_local,
        .clock = clock,
        .rng = rng,
        .fs = files,
        .files = cfg.files,
        .assets = cfg.assets,
        .cache = cache,
        .files_sent = filecache.open(),
        .frags = fragcache.open(cfg.cache),
        .pieces = splice.open(cfg.cache),
        .lock_rx = lock_rx,
        .lock_tx = lock_tx,
        .cable = cable_tx,
        .hub = hub_tx,
    }
}

const HTML = "Content-Type: text/html; charset=utf-8\r\n"

const SIGN_IN = "<!DOCTYPE html><html><head><title>Campfire</title></head><body><form action=\"/session\" method=\"post\"><input type=\"email\" name=\"email_address\" required autofocus><input type=\"password\" name=\"password\" required><button type=\"submit\">Sign in</button></form></body></html>"

// Answers req; whether c goes on serving HTTP (not after a WebSocket
// handshake).
fn handle(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !bool {
    if (req.method == "GET" and req.path == "/cable") {
        return cable_open(c, a, &ctx, req)
    }
    try dispatch(c, a, &ctx, req)
    return true
}

// The Action Cable subprotocol the client asks for first of those there
// are, as the client lists them; null if none.
fn cable_protocol(asked: []u8) ?str {
    var i = 0
    while (i < @len(asked)) {
        const end = text.find_from(asked, ",", i) orelse @len(asked)
        var lo = i
        var hi = end
        while (lo < hi and asked[lo] == ' ') {
            lo = lo + 1
        }
        while (hi > lo and asked[hi - 1] == ' ') {
            hi = hi - 1
        }
        if (asked[lo..hi] == "actioncable-v1-json") {
            return "actioncable-v1-json"
        } else if (asked[lo..hi] == "actioncable-unsupported") {
            return "actioncable-unsupported"
        }
        i = end + 1
    }
    return null
}

// GET /cable: a WebSocket handshake from this app's own origin, as Action
// Cable allows by default, or the 404 page. Once switched, the connection
// signs in with its session cookie after all, as ApplicationCable::Connection
// does: if it cannot, it is told so and closed; if it can, cable takes it.
fn cable_open(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !bool {
    const base = a.concat("http://", req.host)
    defer a.free(base)
    if (!req.upgrade or req.origin != base or req.ws_version != "13" or !ws.valid_key(a, req.ws_key)) {
        try not_found(c, a, req)
        return true
    }
    var head: Buf(u8) = .empty
    defer a.free(head)
    a.append_str(&head, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: upgrade\r\nSec-WebSocket-Accept: ")
    const key = ws.accept(a, req.ws_key)
    defer a.free(key)
    a.append_str(&head, key)
    a.append_str(&head, "\r\n")
    if (cable_protocol(req.ws_protocol)) |p| {
        a.append_str(&head, "Sec-WebSocket-Protocol: ")
        a.append_str(&head, p)
        a.append_str(&head, "\r\n")
    }
    a.append_str(&head, "\r\n")
    try c.write(head)
    const user = try session.cable_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        var bye = ws.text_frame(a, cable.UNAUTHORIZED)
        defer a.free(bye)
        const close = ws.close_frame(a, 1000)
        defer a.free(close)
        a.append_str(&bye, close)
        try c.write(bye)
        return false
    }
    // A quiet client is fine; a client that stops reading is let go.
    try c.set_timeout(60000)
    ctx.cable.send(cable.upgrade(try c.clone(), user))
    return false
}

fn dispatch(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    if (req.method == "GET" and req.path == "/up") {
        return http.respond(c, a, req, "200 OK", HTML, "<!DOCTYPE html><html><body style=\"background-color: green\"></body></html>")
    }
    if (req.method == "GET" and req.path == "/session/new") {
        if (!try model.users_exist(ctx.db)) {
            return redirect(c, a, req, "/first_run")
        }
        return http.respond(c, a, req, "200 OK", HTML, SIGN_IN)
    }
    if (req.method == "GET" and req.path == "/account/logo") {
        return account_logo(c, a, &ctx, req)
    }
    if (req.method == "GET" and req.path == "/webmanifest.json") {
        return web_manifest(c, a, &ctx, req)
    }
    if (req.method == "GET" and req.path == "/service-worker.js") {
        return service_worker(c, a, req)
    }
    if (req.method == "GET" and text.starts_with(req.path, "/qr_code/")) {
        return qr_code(c, a, req)
    }
    if (req.method == "GET" and req.path == "/first_run") {
        return first_run_page(c, a, &ctx, req)
    }
    if (req.method == "GET" and req.path == "/") {
        return welcome(c, a, &ctx, req)
    }
    if ((req.method == "POST" or req.method == "PATCH" or req.method == "PUT" or req.method == "DELETE") and !same_origin(a, req)) {
        return http.respond(c, a, req, "422 Unprocessable Content", "Content-Type: text/html; charset=UTF-8\r\n", public_pages.UNPROCESSABLE)
    }
    if (req.method == "POST" and req.path == "/session") {
        if (http.field(a, req, "_method")) |method| {
            defer a.free(method)
            if (method == "delete" or method == "DELETE") { return sign_out(c, a, &ctx, req) }
        }
        return sign_in(c, a, &ctx, req)
    }
    if (req.method == "DELETE" and req.path == "/session") {
        if (!same_origin(a, req)) {
            return http.respond(c, a, req, "422 Unprocessable Content", HTML, public_pages.UNPROCESSABLE)
        }
        return sign_out(c, a, &ctx, req)
    }
    if (req.method == "POST" and req.path == "/first_run") {
        return first_run(c, a, &ctx, req)
    }
    if (text.starts_with(req.path, "/join/")) {
        return join_account(c, a, &ctx, req)
    }
    if (req.method == "POST" and text.starts_with(req.path, "/rooms/") and text.ends_with(req.path, "/messages")) {
        const rest = req.path[@len("/rooms/")..@len(req.path) - @len("/messages")]
        if (text.find(rest, "/")) |slash| {
            if (text.parse_int(rest[0..slash])) |room| {
                return bot_message(c, a, &ctx, req, room, rest[slash + 1..])
            }
        }
    }
    if (text.starts_with(req.path, "/session/transfers/")) {
        return session_transfer(c, a, &ctx, req)
    }
    if (req.method == "POST" and text.starts_with(req.path, "/rooms/") and text.ends_with(req.path, "/messages")) {
        if (text.parse_int(req.path[@len("/rooms/")..@len(req.path) - @len("/messages")])) |room| {
            return create_message(c, a, &ctx, req, room)
        }
    }
    if (req.method == "GET" and text.starts_with(req.path, "/assets/")) {
        return asset(c, a, &ctx, req)
    }
    if (req.method == "GET" and text.starts_with(req.path, "/users/") and text.ends_with(req.path, "/avatar")) {
        return avatar(c, a, &ctx, req, req.path[@len("/users/")..@len(req.path) - @len("/avatar")])
    }
    if (req.method == "GET" and req.path == "/searches") {
        return search_page(c, a, &ctx, req)
    }
    if (req.method == "GET" and req.path == "/users/me/sidebar") {
        return sidebar_page(c, a, &ctx, req)
    }
    if (req.path == "/users/me/profile") {
        if (req.method == "GET") {
            return profile_page(c, a, &ctx, req)
        }
        return update_profile(c, a, &ctx, req)
    }
    if (req.path == "/account/edit" and req.method == "GET") {
        return account_page(c, a, &ctx, req, false)
    }
    if (req.path == "/account" and (req.method == "POST" or req.method == "PATCH" or req.method == "PUT")) {
        return account_update(c, a, &ctx, req, false)
    }
    if (req.path == "/account/join_code" and req.method == "POST") {
        return reset_join_code(c, a, &ctx, req)
    }
    if (req.path == "/account/custom_styles/edit" and req.method == "GET") {
        return account_page(c, a, &ctx, req, true)
    }
    if (req.path == "/account/custom_styles" and (req.method == "POST" or req.method == "PATCH" or req.method == "PUT")) {
        return account_update(c, a, &ctx, req, true)
    }
    if (req.path == "/account/bots" and req.method == "GET") { return bots_page(c, a, &ctx, req, 0, false) }
    if (req.path == "/account/bots/new" and req.method == "GET") { return bots_page(c, a, &ctx, req, 0, true) }
    if (req.path == "/account/bots" and req.method == "POST") { return save_bot(c, a, &ctx, req, 0) }
    if (text.starts_with(req.path, "/account/bots/")) {
        const rest = req.path[@len("/account/bots/")..]
        if (text.ends_with(rest, "/edit")) {
            if (text.parse_int(rest[0..@len(rest) - @len("/edit")])) |id| {
                if (req.method == "GET") { return bots_page(c, a, &ctx, req, id, true) }
            }
        }
        if (text.parse_int(rest)) |id| {
            if (req.method == "POST" or req.method == "PATCH" or req.method == "PUT") {
                return save_bot(c, a, &ctx, req, id)
            }
        }
    }
    if (req.path == "/rooms/opens/new" and req.method == "GET") {
        return open_room_form(c, a, &ctx, req, 0)
    }
    if (req.path == "/rooms/directs/new" and req.method == "GET") { return direct_room_new(c, a, &ctx, req) }
    if (req.path == "/rooms/directs" and req.method == "POST") { return create_direct_room(c, a, &ctx, req) }
    if (req.method == "GET" and text.starts_with(req.path, "/attachments/")) { return download_attachment(c, a, &ctx, req) }
    if (req.method == "GET" and req.path == "/flash") { return flash_notice(c, a, &ctx, req) }
    if (text.starts_with(req.path, "/users/me/push_subscriptions")) { return push_subscriptions(c, a, &ctx, req) }
    if (req.method == "POST" and req.path == "/unfurl_link") { return unfurl_link(c, a, &ctx, req) }
    if (req.path == "/autocompletable/users" and req.method == "GET") { return autocompletable_users(c, a, &ctx, req) }
    if (req.path == "/rooms/opens" and req.method == "POST") {
        return create_open_room(c, a, &ctx, req)
    }
    if (text.starts_with(req.path, "/rooms/opens/")) {
        const rest = req.path[@len("/rooms/opens/")..]
        if (text.ends_with(rest, "/edit")) {
            if (text.parse_int(rest[0..@len(rest) - @len("/edit")])) |id| {
                if (req.method == "GET") { return open_room_form(c, a, &ctx, req, id) }
            }
        }
        if (text.parse_int(rest)) |id| {
            if (req.method == "POST" or req.method == "PATCH" or req.method == "PUT") {
                return update_open_room(c, a, &ctx, req, id)
            }
        }
    }
    if (text.starts_with(req.path, "/rooms/")) {
        if (text.ends_with(req.path, "/involvement")) {
            if (text.parse_int(req.path[@len("/rooms/")..@len(req.path) - @len("/involvement")])) |room| {
                return involvement(c, a, &ctx, req, room)
            }
        }
        // /rooms/:room_id/messages/:id, and /edit
        var room = 0
        var id = 0
        var edit = false
        if (message_path(req.path[@len("/rooms/")..], &room, &id, &edit)) {
            if (req.method == "GET" and edit) {
                return edit_message(c, a, &ctx, req, room, id)
            } else if (req.method == "GET") {
                return show_message(c, a, &ctx, req, room, id)
            } else if ((req.method == "POST" or req.method == "PATCH" or req.method == "PUT" or req.method == "DELETE") and !edit) {
                return change_message(c, a, &ctx, req, room, id)
            }
        }
    }
    if (req.method == "GET" and text.starts_with(req.path, "/rooms/")) {
        const rest = req.path[@len("/rooms/")..]
        if (text.parse_int(rest)) |room| {
            return room_page(c, a, &ctx, req, room)
        }
        if (text.ends_with(rest, "/messages")) {
            if (text.parse_int(rest[0..@len(rest) - @len("/messages")])) |room| {
                return messages_page(c, a, &ctx, req, room)
            }
        }
        if (text.ends_with(rest, "/refresh")) {
            if (text.parse_int(rest[0..@len(rest) - @len("/refresh")])) |room| {
                return room_refresh(c, a, &ctx, req, room)
            }
        }
    }
    return not_found(c, a, req)
}

fn not_found(c: TcpConn, a: Allocator, req: http.Request) !void {
    return http.respond(c, a, req, "404 Not Found", "Content-Type: text/html; charset=UTF-8\r\n", public_pages.NOT_FOUND)
}

// A room the user cannot see: back to the start, as the Rust app does.
fn to_root(c: TcpConn, a: Allocator, req: http.Request) !void {
    var headers: Buf(u8) = .empty
    defer a.free(headers)
    a.append_str(&headers, "Location: http://")
    a.append_str(&headers, req.host)
    a.append_str(&headers, "/\r\n")
    a.append_str(&headers, HTML)
    return http.respond(c, a, req, "302 Found", headers, "")
}

// 302 to this host's path.
fn redirect(c: TcpConn, a: Allocator, req: http.Request, path: []u8) !void {
    var headers: Buf(u8) = .empty
    defer a.free(headers)
    a.append_str(&headers, "Location: http://")
    a.append_str(&headers, req.host)
    a.append_str(&headers, path)
    a.append_str(&headers, "\r\n")
    a.append_str(&headers, HTML)
    return http.respond(c, a, req, "302 Found", headers, "")
}

fn to_sign_in(c: TcpConn, a: Allocator, req: http.Request) !void {
    var headers: Buf(u8) = .empty
    defer a.free(headers)
    a.append_str(&headers, "Location: http://")
    a.append_str(&headers, req.host)
    a.append_str(&headers, "/session/new\r\n")
    a.append_str(&headers, HTML)
    return http.respond(c, a, req, "302 Found", headers, "")
}

// Whether the user is an administrator (role 1), and the account's logo
// stamp, ?v= of its URL.
fn administrator(db: sqlite.Db, user: i64) !bool {
    var st = try db.prepare("SELECT role FROM users WHERE id = ?")
    defer st.finalize()
    try st.bind_int(1, user)
    return try st.next() and st.int(0) == 1
}

fn logo_stamp(a: Allocator, inout out: Buf(u8), db: sqlite.Db) !void {
    var st = try db.prepare("SELECT updated_at FROM accounts ORDER BY id LIMIT 1")
    defer st.finalize()
    if (try st.next()) {
        const t = st.text(a, 0)
        defer a.free(t)
        tf.number_stamp(a, &out, tf.parse_db(t) orelse 0)
    }
}

fn custom_css(a: Allocator, db: sqlite.Db) !Buf(u8) {
    var st = try db.prepare("SELECT custom_styles FROM accounts ORDER BY id LIMIT 1")
    defer st.finalize()
    if (try st.next() and !st.is_null(0)) { return st.text(a, 0) }
    return a.concat("", "")
}

// The cache's key for this response: the route, the user, and all the
// request carries that a page can depend on (target, host, encoding and
// cookies, the session's among them).
fn cache_key(a: Allocator, route: str, user: i64, req: http.Request) Buf(u8) {
    var k: Buf(u8) = .empty
    a.append_str(&k, route)
    a.append_str(&k, "\n")
    a.append_int(&k, user)
    a.append_str(&k, "\n")
    a.append_str(&k, req.path)
    a.append_str(&k, "?")
    a.append_str(&k, req.query)
    a.append_str(&k, "\n")
    a.append_str(&k, req.host)
    a.append_str(&k, if (req.gzip) "\ngzip\n" else "\nidentity\n")
    a.append_str(&k, req.cookie)
    a.append_str(&k, "\n")
    a.append_str(&k, req.user_agent)
    return k
}

// Send a cached response for key if there is one of generation gen; own
// are this request's own headers. Whether it did.
fn cached(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, gen: i64, key: []u8, own: []u8) !bool {
    const i = try ctx.cache.find(a, gen, key, ctx.clock.now())
    if (i < 0) {
        return false
    }
    try ctx.cache.send(c, a, i, own, req)
    return true
}

// Send a page as HTML (gzipped if asked), and keep it for key.
fn page_out(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, gen: i64, key: []u8, own: []u8, body: []u8, cuts: Buf(i64)) !void {
    // The fragments this page kept are of gen only if nothing committed.
    ctx.frags.finish(a, try ctx.cache.generation_now(a))
    if (req.gzip and ctx.pieces.on and @len(cuts) > 0) {
        if (splice.gzip(a, &ctx.pieces, body, cuts)) |z| {
            defer a.free(z)
            const headers = a.concat(HTML, "Content-Encoding: gzip\r\nVary: Accept-Encoding\r\n")
            defer a.free(headers)
            try http.conditional(c, a, req, own, headers, z)
            return ctx.cache.put(a, gen, key, headers, z, ctx.clock.now())
        }
    }
    const e = http.encode(a, req, HTML, body)
    defer e.deinit(a)
    try http.conditional(c, a, req, own, e.headers, e.body)
    try ctx.cache.put(a, gen, key, e.headers, e.body, ctx.clock.now())
}

// GET /rooms/:id: the newest page of the room's messages.
fn room_page(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, id: i64) !void {
    // Before signing in: see respcache.
    const gen = try ctx.cache.generation_now(a)
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    const room = try model.room_for(a, ctx.db, user_id, id) orelse {
        return to_root(c, a, req)
    }
    defer room.deinit(a)
    // cookies.permanent[:last_room], when it changes: the request's own,
    // never cached.
    var own: Buf(u8) = .empty
    defer a.free(own)
    var id_text: Buf(u8) = .empty
    defer a.free(id_text)
    a.append_int(&id_text, room.id)
    var same = false
    if (codec.cookie_value(a, req.cookie, "last_room")) |v| {
        same = v == id_text
        a.free(v)
    }
    if (!same) {
        a.append_str(&own, "Set-Cookie: last_room=")
        a.append_str(&own, id_text)
        a.append_str(&own, "; path=/; expires=")
        tf.http_date(a, &own, tf.add_years(ctx.clock.now(), 20))
        a.append_str(&own, "; samesite=lax\r\n")
    }
    const key = cache_key(a, "rooms#show", user_id, req)
    defer a.free(key)
    if (try cached(c, a, &ctx, req, gen, key, own)) {
        return
    }
    const user = try model.find_user(a, ctx.db, ctx.sid_key, user_id) orelse {
        return to_sign_in(c, a, req)
    }
    defer user.deinit(a)
    // Messages name their room as anyone sees it.
    const others = try model.display_name(a, ctx.db, room.id, room.kind == "direct", room.name, 0)
    defer a.free(others)
    const messages = try model.page(a, ctx.db, ctx.sid_key, room.id, 0, others)
    defer a.free(messages)
    const admin = try administrator(ctx.db, user_id)
    var logo: Buf(u8) = .empty
    defer a.free(logo)
    try logo_stamp(a, &logo, ctx.db)
    var class: Buf(u8) = .empty
    defer a.free(class)
    a.append_str(&class, "Rooms::")
    a.push(&class, room.kind[0] - 32)
    a.append_str(&class, room.kind[1..])
    var stream: Buf(u8) = .empty
    defer a.free(stream)
    turbo.record_stream(a, &stream, ctx.stream_key, class, room.id, "messages")
    const base = a.concat("http://", req.host)
    defer a.free(base)
    var body: Buf(u8) = .empty
    defer a.free(body)
    var cuts: Buf(i64) = .empty
    defer a.free(cuts)
    ctx.frags.begin(a, gen)
    var join_code: Buf(u8) = .empty
    defer a.free(join_code)
    const invite = try model.invitation(a, &join_code, ctx.db, room.id)
    const css = try custom_css(a, ctx.db)
    defer a.free(css)
    views.room_show(a, &body, user, room, messages, base, platform.browser(req.user_agent), platform.operating_system(req.user_agent), ctx.vapid, logo, css, admin, tf.epoch_ms(room.updated_ns), stream, invite, join_code, &ctx.frags, &cuts)
    return page_out(c, a, &ctx, req, gen, key, own, body, cuts)
}

fn sign_in(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    _ = ctx.lock_rx.recv()
    const allowed = session.allow_login(ctx.db, ctx.clock, req.peer_ip) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    ctx.lock_tx.send(true)
    if (!allowed) {
        return http.respond(c, a, req, "429 Too Many Requests", HTML, SIGN_IN)
    }
    const email = codec.form_value(a, req.body, "email_address") orelse a.concat("", "")
    defer a.free(email)
    const password = codec.form_value(a, req.body, "password") orelse a.concat("", "")
    defer a.free(password)
    const user = try session.authenticate(a, ctx.db, email, password) orelse {
        return http.respond(c, a, req, "401 Unauthorized", HTML, SIGN_IN)
    }
    _ = ctx.lock_rx.recv()
    const token = session.start(a, ctx.db, ctx.clock, ctx.rng, user, req.peer_ip, req.user_agent) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    ctx.lock_tx.send(true)
    defer a.free(token)
    var headers: Buf(u8) = .empty
    defer a.free(headers)
    a.append_str(&headers, "Location: /\r\n")
    session.set_cookie(a, &headers, ctx.key, ctx.clock, token)
    a.append_str(&headers, HTML)
    return http.respond(c, a, req, "302 Found", headers, "")
}

fn sign_out(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    const user = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse { return to_sign_in(c, a, req) }
    const endpoint = http.field(a, req, "push_subscription_endpoint") orelse a.concat("", "")
    defer a.free(endpoint)
    _ = ctx.lock_rx.recv()
    session.terminate(a, ctx.db, ctx.key, ctx.clock, req.cookie, user, endpoint) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    ctx.lock_tx.send(true)
    return http.respond(c, a, req, "302 Found", "Location: /\r\nSet-Cookie: session_token=; path=/; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT; httponly; samesite=lax\r\n", "")
}

fn session_transfer(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    if (req.method == "GET") {
        var body: Buf(u8) = .empty
        defer a.free(body)
        a.append_str(&body, "<!DOCTYPE html><html><head><title>Campfire</title></head><body><form id=\"transfer\" action=\"")
        html.escape(a, &body, req.path)
        a.append_str(&body, "\" method=\"post\" data-controller=\"auto-submit\"><input type=\"hidden\" name=\"_method\" value=\"put\"></form><script>document.getElementById('transfer').submit()</script></body></html>")
        return http.respond(c, a, req, "200 OK", HTML, body)
    }
    if (req.method != "POST" and req.method != "PUT") {
        return not_found(c, a, req)
    }
    const token = req.path[@len("/session/transfers/")..]
    const user = signed_id.verify_transfer(a, ctx.sid_key, token, ctx.clock.now()) orelse {
        return http.respond(c, a, req, "400 Bad Request", "", "")
    }
    var st = try ctx.db.prepare("SELECT 1 FROM users WHERE id = ? AND status = 0 LIMIT 1")
    defer st.finalize()
    try st.bind_int(1, user)
    if (!try st.next()) {
        return http.respond(c, a, req, "400 Bad Request", "", "")
    }
    _ = ctx.lock_rx.recv()
    const session_token = session.start(a, ctx.db, ctx.clock, ctx.rng, user, req.peer_ip, req.user_agent) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    ctx.lock_tx.send(true)
    defer a.free(session_token)
    var headers: Buf(u8) = .empty
    defer a.free(headers)
    a.append_str(&headers, "Location: /\r\n")
    session.set_cookie(a, &headers, ctx.key, ctx.clock, session_token)
    a.append_str(&headers, HTML)
    return http.respond(c, a, req, "302 Found", headers, "")
}

fn qr_code(c: TcpConn, a: Allocator, req: http.Request) !void {
    var url: Buf(u8) = .empty
    defer a.free(url)
    if (!codec.base64_decode(a, &url, req.path[@len("/qr_code/")..])) {
        return http.respond(c, a, req, "422 Unprocessable Content", "", "")
    }
    const image = qrcode.svg(a, url) orelse {
        return http.respond(c, a, req, "422 Unprocessable Content", "", "")
    }
    defer a.free(image)
    return http.respond(c, a, req, "200 OK", "Content-Type: image/svg+xml; charset=utf-8\r\n", image)
}

// Whether rest (after /rooms/) is :room_id/messages/:id or that and /edit.
fn message_path(rest: []u8, inout room: i64, inout id: i64, inout edit: bool) bool {
    const slash = text.find(rest, "/messages/") orelse {
        return false
    }
    room = text.parse_int(rest[0..slash]) orelse 0
    const tail = rest[slash + @len("/messages/")..]
    edit = text.ends_with(tail, "/edit")
    const cut = if (edit) @len(tail) - @len("/edit") else @len(tail)
    id = text.parse_int(tail[0..cut]) orelse 0
    return room > 0 and id > 0
}

// The signed-in user's room's message for /rooms/:room_id/messages/:id:
// its view (room name as anyone sees it), or a 404 sent and false.
fn room_message(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, user_id: i64, room_id: i64, id: i64, inout found: Buf(model.MessageView)) !bool {
    const room = try model.room_for(a, ctx.db, user_id, room_id) orelse {
        try not_found(c, a, req)
        return false
    }
    defer room.deinit(a)
    if (try model.message_creator(ctx.db, room.id, id) == 0) {
        try not_found(c, a, req)
        return false
    }
    const others = try model.display_name(a, ctx.db, room.id, room.kind == "direct", room.name, 0)
    defer a.free(others)
    a.free(@replace(&found, try model.find_message(a, ctx.db, ctx.sid_key, id, others)))
    return @len(found) == 1
}

// head :forbidden unless Current.user.can_administer?(@message)
fn can_administer(db: sqlite.Db, user: i64, room: i64, id: i64) !bool {
    return try model.message_creator(db, room, id) == user or try administrator(db, user)
}

// A page in the application layout around content, with no nav.
fn plain_page(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, user_id: i64, content: []u8) !void {
    const user = try model.find_user(a, ctx.db, ctx.sid_key, user_id) orelse {
        return to_sign_in(c, a, req)
    }
    defer user.deinit(a)
    var logo: Buf(u8) = .empty
    defer a.free(logo)
    try logo_stamp(a, &logo, ctx.db)
    var body: Buf(u8) = .empty
    defer a.free(body)
    const css = try custom_css(a, ctx.db)
    defer a.free(css)
    views.app_top(a, &body, "Campfire", user, ctx.vapid, logo, css, "", try administrator(ctx.db, user_id), "", "")
    a.append_str(&body, content)
    views.app_bottom(a, &body, "", "")
    return http.respond(c, a, req, "200 OK", HTML, body)
}

// GET /rooms/:room_id/messages/:id: the message alone.
fn show_message(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, room_id: i64, id: i64) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    var found: Buf(model.MessageView) = .empty
    defer a.free(found)
    if (!try room_message(c, a, &ctx, req, user_id, room_id, id, &found)) {
        return
    }
    var content: Buf(u8) = .empty
    defer a.free(content)
    views.message(a, &content, found[0])
    a.append_str(&content, "\n")
    return plain_page(c, a, &ctx, req, user_id, content)
}

// GET /rooms/:room_id/messages/:id/edit: the message's editor.
fn edit_message(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, room_id: i64, id: i64) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    var found: Buf(model.MessageView) = .empty
    defer a.free(found)
    if (!try room_message(c, a, &ctx, req, user_id, room_id, id, &found)) {
        return
    }
    if (!try can_administer(ctx.db, user_id, room_id, id)) {
        return http.respond(c, a, req, "403 Forbidden", HTML, "")
    }
    const editable = try model.stored_body(a, ctx.db, id)
    defer a.free(editable)
    const base = a.concat("http://", req.host)
    defer a.free(base)
    var content: Buf(u8) = .empty
    defer a.free(content)
    views.message_edit(a, &content, found[0], editable, base)
    return plain_page(c, a, &ctx, req, user_id, content)
}

// PATCH (or POST with _method) /rooms/:room_id/messages/:id: the new body,
// replaced in every open room page, then back to the message; DELETE: the
// message gone, from every page too.
fn change_message(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, room_id: i64, id: i64) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    var method: Buf(u8) = .empty
    defer a.free(method)
    a.append_str(&method, req.method)
    if (req.method == "POST") {
        if (http.field(a, req, "_method")) |m| {
            a.resize(&method, 0, 0)
            for (m) |ch| {
                a.push(&method, if (ch >= 'a' and ch <= 'z') ch - 32 else ch)
            }
            a.free(m)
        }
    }
    if (method != "PATCH" and method != "PUT" and method != "DELETE") {
        return not_found(c, a, req)
    }
    var found: Buf(model.MessageView) = .empty
    defer a.free(found)
    if (!try room_message(c, a, &ctx, req, user_id, room_id, id, &found)) {
        return
    }
    if (!try can_administer(ctx.db, user_id, room_id, id)) {
        return http.respond(c, a, req, "403 Forbidden", HTML, "")
    }
    var stream: Buf(u8) = .empty
    defer a.free(stream)
    const kind = try model.room_kind(a, ctx.db, room_id)
    defer a.free(kind)
    turbo.gid(a, &stream, room_class(kind), room_id)
    a.append_str(&stream, ":messages")
    if (method == "DELETE") {
        _ = ctx.lock_rx.recv()
        model.destroy_message(a, ctx.db, ctx.clock, room_id, id) catch |e| {
            ctx.lock_tx.send(true)
            return e
        }
        ctx.lock_tx.send(true)
        var out: Buf(u8) = .empty
        defer a.free(out)
        a.append_str(&out, "<turbo-stream action=\"remove\" target=\"message_")
        html.escape(a, &out, found[0].client_id)
        a.append_str(&out, "\"></turbo-stream>")
        var frame: Buf(u8) = .empty
        defer a.free(frame)
        json.encode_string(a, &frame, out)
        cable.broadcast(a, ctx.hub, stream, frame)
        return http.respond(c, a, req, "200 OK", "Content-Type: text/vnd.turbo-stream.html; charset=utf-8\r\n", out)
    }
    if (http.field(a, req, "message[body]")) |body| {
        defer a.free(body)
        _ = ctx.lock_rx.recv()
        model.update_body(a, ctx.db, ctx.clock, room_id, id, body) catch |e| {
            ctx.lock_tx.send(true)
            return e
        }
        ctx.lock_tx.send(true)
    }
    var now: Buf(model.MessageView) = .empty
    defer a.free(now)
    if (!try room_message(c, a, &ctx, req, user_id, room_id, id, &now)) {
        return
    }
    var out: Buf(u8) = .empty
    defer a.free(out)
    a.append_str(&out, "<turbo-stream maintain_scroll=\"true\" action=\"replace\" target=\"presentation_message_")
    html.escape(a, &out, now[0].client_id)
    a.append_str(&out, "\"><template>")
    views.presentation(a, &out, now[0])
    a.append_str(&out, "</template></turbo-stream>")
    var frame: Buf(u8) = .empty
    defer a.free(frame)
    json.encode_string(a, &frame, out)
    cable.broadcast(a, ctx.hub, stream, frame)
    var path: Buf(u8) = .empty
    defer a.free(path)
    a.append_str(&path, "/rooms/")
    a.append_int(&path, room_id)
    a.append_str(&path, "/messages/")
    a.append_int(&path, id)
    return redirect(c, a, req, path)
}

// GET /: the room last visited, or the first; signed out, sign in.
fn welcome(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    var last_room = 0
    if (codec.cookie_value(a, req.cookie, "last_room")) |v| {
        last_room = text.parse_int(v) orelse 0
        a.free(v)
    }
    const room = try model.return_room(ctx.db, user_id, last_room)
    if (room == 0) {
        return not_found(c, a, req)
    }
    var path: Buf(u8) = .empty
    defer a.free(path)
    a.append_str(&path, "/rooms/")
    a.append_int(&path, room)
    return redirect(c, a, req, path)
}

// GET /first_run: setting up, until there is an account.
fn first_run_page(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    if (try model.account_exists(ctx.db)) {
        return to_root(c, a, req)
    }
    var body: Buf(u8) = .empty
    defer a.free(body)
    views.first_run_show(a, &body, ctx.vapid, "/account/logo")
    return http.respond(c, a, req, "200 OK", HTML, body)
}

// POST /first_run: the account, its administrator, signed in, and All
// Talk; back to the start if someone was first.
fn first_run(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    if (try model.account_exists(ctx.db)) {
        return to_root(c, a, req)
    }
    const name = http.field(a, req, "user[name]") orelse {
        return error.MissingName
    }
    defer a.free(name)
    const email = http.field(a, req, "user[email_address]") orelse a.concat("", "")
    defer a.free(email)
    const password = http.field(a, req, "user[password]") orelse a.concat("", "")
    defer a.free(password)
    const digest = crypto.bcrypt_hash(a, ctx.rng, password) orelse {
        return error.Bcrypt
    }
    defer a.free(digest)
    _ = ctx.lock_rx.recv()
    // RecordNotUnique: another request set up first.
    const taken = model.account_exists(ctx.db) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    if (taken) {
        ctx.lock_tx.send(true)
        return to_root(c, a, req)
    }
    const user = model.first_run(a, ctx.db, ctx.clock, ctx.rng, name, email, digest) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    const token = session.start(a, ctx.db, ctx.clock, ctx.rng, user, req.peer_ip, req.user_agent) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    ctx.lock_tx.send(true)
    defer a.free(token)
    var headers: Buf(u8) = .empty
    defer a.free(headers)
    a.append_str(&headers, "Location: http://")
    a.append_str(&headers, req.host)
    a.append_str(&headers, "/\r\n")
    session.set_cookie(a, &headers, ctx.key, ctx.clock, token)
    a.append_str(&headers, HTML)
    return http.respond(c, a, req, "302 Found", headers, "")
}

// GET /rooms/:id/messages?before=:message_id: the page before that message,
// as bare HTML; 204 when there is none.
fn messages_page(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, id: i64) !void {
    const gen = try ctx.cache.generation_now(a)
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    const room = try model.room_for(a, ctx.db, user_id, id) orelse {
        return not_found(c, a, req)
    }
    defer room.deinit(a)
    const key = cache_key(a, "messages#index", user_id, req)
    defer a.free(key)
    if (try cached(c, a, &ctx, req, gen, key, "")) {
        return
    }
    var before = 0
    if (codec.form_value(a, req.query, "before")) |b| {
        defer a.free(b)
        before = text.parse_int(b) orelse 0
        if (before <= 0 or !try model.in_room(ctx.db, room.id, before)) {
            return not_found(c, a, req)
        }
    }
    // Messages name their room as anyone sees it.
    const others = try model.display_name(a, ctx.db, room.id, room.kind == "direct", room.name, 0)
    defer a.free(others)
    const messages = try model.page(a, ctx.db, ctx.sid_key, room.id, before, others)
    defer a.free(messages)
    if (@len(messages) == 0) {
        return http.respond(c, a, req, "204 No Content", "", "")
    }
    var body: Buf(u8) = .empty
    defer a.free(body)
    var cuts: Buf(i64) = .empty
    defer a.free(cuts)
    ctx.frags.begin(a, gen)
    views.messages_index(a, &body, messages, &ctx.frags, &cuts)
    return page_out(c, a, &ctx, req, gen, key, "", body, cuts)
}

// GET /users/me/sidebar: the room list, as a whole page.
fn sidebar_page(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    const gen = try ctx.cache.generation_now(a)
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    const key = cache_key(a, "users/sidebars#show", user_id, req)
    defer a.free(key)
    if (try cached(c, a, &ctx, req, gen, key, "")) {
        return
    }
    const user = try model.find_user(a, ctx.db, ctx.sid_key, user_id) orelse {
        return to_sign_in(c, a, req)
    }
    defer user.deinit(a)
    const sb = try model.sidebar(a, ctx.db, ctx.sid_key, user_id)
    defer sb.deinit(a)
    const admin = try administrator(ctx.db, user_id)
    const can_create = admin or !try model.rooms_restricted(a, ctx.db)
    var logo: Buf(u8) = .empty
    defer a.free(logo)
    try logo_stamp(a, &logo, ctx.db)
    var rooms_stream: Buf(u8) = .empty
    defer a.free(rooms_stream)
    turbo.sign(a, &rooms_stream, ctx.stream_key, "rooms")
    var user_stream: Buf(u8) = .empty
    defer a.free(user_stream)
    turbo.record_stream(a, &user_stream, ctx.stream_key, "User", user_id, "rooms")
    var body: Buf(u8) = .empty
    defer a.free(body)
    const css = try custom_css(a, ctx.db)
    defer a.free(css)
    views.sidebar_show(a, &body, user, sb, ctx.vapid, logo, css, admin, can_create, rooms_stream, user_stream)
    const none: Buf(i64) = .empty
    defer a.free(none)
    return page_out(c, a, &ctx, req, gen, key, "", body, none)
}

fn profile_page(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    const user = try model.find_user(a, ctx.db, ctx.sid_key, user_id) orelse {
        return to_sign_in(c, a, req)
    }
    defer user.deinit(a)
    var st = try ctx.db.prepare("SELECT email_address, bio FROM users WHERE id = ?")
    defer st.finalize()
    try st.bind_int(1, user_id)
    if (!try st.next()) {
        return not_found(c, a, req)
    }
    const has_email = !st.is_null(0)
    const email = if (has_email) st.text(a, 0) else a.concat("", "")
    defer a.free(email)
    const bio = if (!st.is_null(1)) st.text(a, 1) else a.concat("", "")
    defer a.free(bio)
    const shared = try model.profile_memberships(a, ctx.db, user_id, false)
    defer a.free(shared)
    const direct = try model.profile_memberships(a, ctx.db, user_id, true)
    defer a.free(direct)
    var logo: Buf(u8) = .empty
    defer a.free(logo)
    try logo_stamp(a, &logo, ctx.db)
    const admin = try administrator(ctx.db, user_id)
    var token: Buf(u8) = .empty
    defer a.free(token)
    signed_id.transfer(a, &token, ctx.sid_key, user_id, ctx.clock.now())
    var transfer_url: Buf(u8) = .empty
    defer a.free(transfer_url)
    a.append_str(&transfer_url, "http://")
    a.append_str(&transfer_url, req.host)
    a.append_str(&transfer_url, "/session/transfers/")
    a.append_str(&transfer_url, token)
    var qr: Buf(u8) = .empty
    defer a.free(qr)
    codec.base64url_encode(a, &qr, transfer_url)
    var nav: Buf(u8) = .empty
    defer a.free(nav)
    views.profile_nav(a, &nav, "/")
    var body: Buf(u8) = .empty
    defer a.free(body)
    const css = try custom_css(a, ctx.db)
    defer a.free(css)
    views.app_top(a, &body, user.name, user, ctx.vapid, logo, css, "", admin, "", nav)
    views.profile(a, &body, user, has_email, email, bio, shared, direct, transfer_url, qr)
    views.app_bottom(a, &body, "", "")
    return http.respond(c, a, req, "200 OK", HTML, body)
}

fn account_page(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, styles: bool) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    const admin = try administrator(ctx.db, user_id)
    if (styles and !admin) {
        return http.respond(c, a, req, "403 Forbidden", HTML, "")
    }
    const user = try model.find_user(a, ctx.db, ctx.sid_key, user_id) orelse {
        return to_sign_in(c, a, req)
    }
    defer user.deinit(a)
    var st = try ctx.db.prepare("SELECT name, join_code, custom_styles FROM accounts ORDER BY id LIMIT 1")
    defer st.finalize()
    if (!try st.next()) { return not_found(c, a, req) }
    const name = st.text(a, 0)
    defer a.free(name)
    const code = st.text(a, 1)
    defer a.free(code)
    const css = if (st.is_null(2)) a.concat("", "") else st.text(a, 2)
    defer a.free(css)
    var logo: Buf(u8) = .empty
    defer a.free(logo)
    try logo_stamp(a, &logo, ctx.db)
    var invite: Buf(u8) = .empty
    defer a.free(invite)
    a.append_str(&invite, "http://")
    a.append_str(&invite, req.host)
    a.append_str(&invite, "/join/")
    a.append_str(&invite, code)
    var nav: Buf(u8) = .empty
    defer a.free(nav)
    views.profile_nav(a, &nav, if (styles) "/account/edit" else "/")
    if (!styles and admin) {
        a.append_str(&nav, "<div class=\"flex align-center gap flex-item-justify-end\"><a class=\"btn\" href=\"/account/bots\">Set up chat bots</a><a class=\"btn\" href=\"/account/custom_styles/edit\">Custom styles</a></div>")
    }
    var body: Buf(u8) = .empty
    defer a.free(body)
    if (styles) {
        views.app_top(a, &body, "Custom CSS", user, ctx.vapid, logo, css, "", admin, "", nav)
    } else {
        views.app_top(a, &body, name, user, ctx.vapid, logo, css, "", admin, "", nav)
    }
    if (styles) { views.custom_styles(a, &body, css) } else { views.account_edit(a, &body, name, invite, code, admin, logo) }
    views.app_bottom(a, &body, "", "")
    return http.respond(c, a, req, "200 OK", HTML, body)
}

fn reset_join_code(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse { return to_sign_in(c, a, req) }
    if (!try administrator(ctx.db, user_id)) { return http.respond(c, a, req, "403 Forbidden", HTML, "") }
    const code = model.join_code(a, ctx.rng)
    defer a.free(code)
    _ = ctx.lock_rx.recv()
    var st = ctx.db.prepare("UPDATE accounts SET join_code = ?, updated_at = STRFTIME('%Y-%m-%d %H:%M:%f', 'NOW')") catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    defer st.finalize()
    try st.bind(1, code)
    while (try st.next()) {}
    ctx.lock_tx.send(true)
    return redirect(c, a, req, "/account/edit")
}

fn join_account(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    const code = req.path[@len("/join/")..]
    var st = try ctx.db.prepare("SELECT name FROM accounts WHERE join_code = ? LIMIT 1")
    defer st.finalize()
    try st.bind(1, code)
    if (!try st.next()) { return not_found(c, a, req) }
    const account = st.text(a, 0)
    defer a.free(account)
    if (try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie)) |signed_in| {
        _ = signed_in
        return to_root(c, a, req)
    }
    if (req.method == "GET") {
        var body: Buf(u8) = .empty
        defer a.free(body)
        views.join_page(a, &body, code, account)
        return http.respond(c, a, req, "200 OK", HTML, body)
    }
    if (req.method != "POST") { return not_found(c, a, req) }
    const name = http.field(a, req, "user[name]") orelse { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
    defer a.free(name)
    const email = http.field(a, req, "user[email_address]") orelse { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
    defer a.free(email)
    const password = http.field(a, req, "user[password]") orelse { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
    defer a.free(password)
    if (@len(name) == 0 or @len(email) == 0 or @len(password) == 0) { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
    const digest = crypto.bcrypt_hash(a, ctx.rng, password) orelse { return error.Bcrypt }
    defer a.free(digest)
    _ = ctx.lock_rx.recv()
    const user_id = write_join(a, ctx.db, ctx.clock, name, email, digest) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    const token = session.start(a, ctx.db, ctx.clock, ctx.rng, user_id, req.peer_ip, req.user_agent) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    ctx.lock_tx.send(true)
    defer a.free(token)
    var headers: Buf(u8) = .empty
    defer a.free(headers)
    a.append_str(&headers, "Location: /\r\n")
    session.set_cookie(a, &headers, ctx.key, ctx.clock, token)
    a.append_str(&headers, HTML)
    return http.respond(c, a, req, "302 Found", headers, "")
}

fn write_join(a: Allocator, db: sqlite.Db, clock: Clock, name: []u8, email: []u8, digest: []u8) !i64 {
    var now: Buf(u8) = .empty
    defer a.free(now)
    tf.db_time(a, &now, clock.now())
    try db.exec("BEGIN IMMEDIATE")
    const id = insert_join(db, now, name, email, digest) catch |e| {
        db.exec("ROLLBACK") catch {}
        return e
    }
    try db.exec("COMMIT")
    return id
}

fn insert_join(db: sqlite.Db, now: []u8, name: []u8, email: []u8, digest: []u8) !i64 {
    var st = try db.prepare("INSERT INTO users (bio, bot_token, created_at, email_address, name, password_digest, role, status, updated_at) VALUES (NULL, NULL, ?, ?, ?, ?, 0, 0, ?) RETURNING id")
    defer st.finalize()
    try st.bind(1, now)
    try st.bind(2, email)
    try st.bind(3, name)
    try st.bind(4, digest)
    try st.bind(5, now)
    if (!try st.next()) { return error.Sql }
    const id = st.int(0)
    while (try st.next()) {}
    var grants = try db.prepare("INSERT INTO memberships (created_at, involvement, room_id, updated_at, user_id) SELECT ?, 'mentions', id, ?, ? FROM rooms WHERE type = 'Rooms::Open'")
    defer grants.finalize()
    try grants.bind(1, now)
    try grants.bind(2, now)
    try grants.bind_int(3, id)
    while (try grants.next()) {}
    return id
}

fn account_update(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, styles: bool) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    if (!try administrator(ctx.db, user_id)) {
        return http.respond(c, a, req, "403 Forbidden", HTML, "")
    }
    if (!styles) {
        if (http.file(a, req, "account[logo]")) |upload| {
            defer upload.deinit(a)
            const account = try account_id(ctx.db)
            return upload_picture(c, a, &ctx, req, upload, "Account", account, "logo", "/account/edit")
        }
    }
    const entry = (if (styles) http.field(a, req, "account[custom_styles]") else http.field(a, req, "account[name]")) orelse {
        return http.respond(c, a, req, "422 Unprocessable Content", HTML, "")
    }
    defer a.free(entry)
    if (!styles and @len(entry) == 0) { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
    _ = ctx.lock_rx.recv()
    var st = ctx.db.prepare(if (styles) "UPDATE accounts SET custom_styles = ?, updated_at = STRFTIME('%Y-%m-%d %H:%M:%f', 'NOW')" else "UPDATE accounts SET name = ?, updated_at = STRFTIME('%Y-%m-%d %H:%M:%f', 'NOW')") catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    defer st.finalize()
    try st.bind(1, entry)
    while (try st.next()) {}
    ctx.lock_tx.send(true)
    return redirect_notice(c, a, &ctx, req, if (styles) "/account/custom_styles/edit" else "/account/edit", "Account updated")
}

fn bots_page(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, id: i64, form: bool) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse { return to_sign_in(c, a, req) }
    if (!try administrator(ctx.db, user_id)) { return http.respond(c, a, req, "403 Forbidden", HTML, "") }
    const user = try model.find_user(a, ctx.db, ctx.sid_key, user_id) orelse { return to_sign_in(c, a, req) }
    defer user.deinit(a)
    var bot_name: Buf(u8) = .empty
    defer a.free(bot_name)
    var webhook: Buf(u8) = .empty
    defer a.free(webhook)
    if (id > 0) {
        var st = try ctx.db.prepare("SELECT users.name, webhooks.url FROM users LEFT JOIN webhooks ON webhooks.user_id = users.id WHERE users.id = ? AND users.role = 2 AND users.status = 0 LIMIT 1")
        defer st.finalize()
        try st.bind_int(1, id)
        if (!try st.next()) { return not_found(c, a, req) }
        const found_name = st.text(a, 0)
        defer a.free(found_name)
        a.append_str(&bot_name, found_name)
        if (!st.is_null(1)) {
            const found_webhook = st.text(a, 1)
            defer a.free(found_webhook)
            a.append_str(&webhook, found_webhook)
        }
    }
    const css = try custom_css(a, ctx.db)
    defer a.free(css)
    var logo: Buf(u8) = .empty
    defer a.free(logo)
    try logo_stamp(a, &logo, ctx.db)
    var nav: Buf(u8) = .empty
    defer a.free(nav)
    views.profile_nav(a, &nav, if (form) "/account/bots" else "/account/edit")
    var body: Buf(u8) = .empty
    defer a.free(body)
    views.app_top(a, &body, "Chat bots", user, ctx.vapid, logo, css, "", true, "", nav)
    if (form) {
        views.bot_form(a, &body, id, bot_name, webhook)
    } else {
        const bots = try model.bots(a, ctx.db)
        defer a.free(bots)
        const base = a.concat("http://", req.host)
        defer a.free(base)
        views.bots_index(a, &body, bots, base)
    }
    views.app_bottom(a, &body, "", "")
    return http.respond(c, a, req, "200 OK", HTML, body)
}

fn save_bot(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, id: i64) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse { return to_sign_in(c, a, req) }
    if (!try administrator(ctx.db, user_id)) { return http.respond(c, a, req, "403 Forbidden", HTML, "") }
    if (id != 0) {
        var bot = try ctx.db.prepare("SELECT 1 FROM users WHERE id = ? AND role = 2 AND status = 0")
        defer bot.finalize()
        try bot.bind_int(1, id)
        if (!try bot.next()) { return not_found(c, a, req) }
    }
    const name = http.field(a, req, "user[name]") orelse { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
    defer a.free(name)
    if (@len(name) == 0) { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
    const webhook = http.field(a, req, "user[webhook_url]") orelse a.concat("", "")
    defer a.free(webhook)
    _ = ctx.lock_rx.recv()
    if (id == 0) {
        const token = session.base58(a, ctx.rng, 12)
        defer a.free(token)
        write_bot(a, ctx.db, ctx.clock, name, webhook, token) catch |e| {
            ctx.lock_tx.send(true)
            return e
        }
    } else {
        update_bot(ctx.db, id, name, webhook) catch |e| {
            ctx.lock_tx.send(true)
            return e
        }
    }
    ctx.lock_tx.send(true)
    return redirect(c, a, req, "/account/bots")
}

fn write_bot(a: Allocator, db: sqlite.Db, clock: Clock, name: []u8, webhook: []u8, token: []u8) !void {
    var now: Buf(u8) = .empty
    defer a.free(now)
    tf.db_time(a, &now, clock.now())
    try db.exec("BEGIN IMMEDIATE")
    insert_bot(db, name, webhook, token, now) catch |e| {
        db.exec("ROLLBACK") catch {}
        return e
    }
    try db.exec("COMMIT")
}

fn insert_bot(db: sqlite.Db, name: []u8, webhook: []u8, token: []u8, now: []u8) !void {
    var st = try db.prepare("INSERT INTO users (bio, bot_token, created_at, email_address, name, password_digest, role, status, updated_at) VALUES (NULL, ?, ?, NULL, ?, NULL, 2, 0, ?) RETURNING id")
    defer st.finalize()
    try st.bind(1, token)
    try st.bind(2, now)
    try st.bind(3, name)
    try st.bind(4, now)
    if (!try st.next()) { return error.Sql }
    const id = st.int(0)
    while (try st.next()) {}
    var grants = try db.prepare("INSERT INTO memberships (created_at, involvement, room_id, updated_at, user_id) SELECT ?, 'mentions', id, ?, ? FROM rooms WHERE type = 'Rooms::Open'")
    defer grants.finalize()
    try grants.bind(1, now)
    try grants.bind(2, now)
    try grants.bind_int(3, id)
    while (try grants.next()) {}
    if (@len(webhook) > 0) {
        var wh = try db.prepare("INSERT INTO webhooks (created_at, updated_at, url, user_id) VALUES (?, ?, ?, ?)")
        defer wh.finalize()
        try wh.bind(1, now)
        try wh.bind(2, now)
        try wh.bind(3, webhook)
        try wh.bind_int(4, id)
        while (try wh.next()) {}
    }
}

fn update_bot(db: sqlite.Db, id: i64, name: []u8, webhook: []u8) !void {
    try db.exec("BEGIN IMMEDIATE")
    update_bot_rows(db, id, name, webhook) catch |e| {
        db.exec("ROLLBACK") catch {}
        return e
    }
    try db.exec("COMMIT")
}

fn update_bot_rows(db: sqlite.Db, id: i64, name: []u8, webhook: []u8) !void {
    var st = try db.prepare("UPDATE users SET name = ?, updated_at = STRFTIME('%Y-%m-%d %H:%M:%f', 'NOW') WHERE id = ? AND role = 2 AND status = 0")
    defer st.finalize()
    try st.bind(1, name)
    try st.bind_int(2, id)
    while (try st.next()) {}
    if (@len(webhook) == 0) {
        var remove = try db.prepare("DELETE FROM webhooks WHERE user_id = ?")
        defer remove.finalize()
        try remove.bind_int(1, id)
        while (try remove.next()) {}
        return
    }
    var add = try db.prepare("INSERT INTO webhooks (created_at, updated_at, url, user_id) SELECT STRFTIME('%Y-%m-%d %H:%M:%f', 'NOW'), STRFTIME('%Y-%m-%d %H:%M:%f', 'NOW'), ?, ? WHERE NOT EXISTS (SELECT 1 FROM webhooks WHERE user_id = ?)")
    defer add.finalize()
    try add.bind(1, webhook)
    try add.bind_int(2, id)
    try add.bind_int(3, id)
    while (try add.next()) {}
    var wh = try db.prepare("UPDATE webhooks SET url = ?, updated_at = STRFTIME('%Y-%m-%d %H:%M:%f', 'NOW') WHERE user_id = ?")
    defer wh.finalize()
    try wh.bind(1, webhook)
    try wh.bind_int(2, id)
    while (try wh.next()) {}
}

fn bot_message(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, room: i64, key: []u8) !void {
    const dash = text.find(key, "-") orelse { return http.respond(c, a, req, "401 Unauthorized", "", "") }
    const bot = text.parse_int(key[0..dash]) orelse { return http.respond(c, a, req, "401 Unauthorized", "", "") }
    var st = try ctx.db.prepare("SELECT 1 FROM users JOIN memberships ON memberships.user_id = users.id WHERE users.id = ? AND users.bot_token = ? AND users.role = 2 AND users.status = 0 AND memberships.room_id = ? LIMIT 1")
    defer st.finalize()
    try st.bind_int(1, bot)
    try st.bind(2, key[dash + 1..])
    try st.bind_int(3, room)
    if (!try st.next()) { return http.respond(c, a, req, "401 Unauthorized", "", "") }
    const trimmed = text.trim(a, req.body)
    defer a.free(trimmed)
    if (@len(trimmed) == 0) { return http.respond(c, a, req, "422 Unprocessable Content", "", "") }
    _ = ctx.lock_rx.recv()
    const id = model.create_message_notify(a, ctx.db, ctx.clock, ctx.rng, room, bot, true, req.body, "", ctx.mention_key) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    ctx.lock_tx.send(true)
    const room_view = try model.room_for(a, ctx.db, bot, room) orelse { return not_found(c, a, req) }
    defer room_view.deinit(a)
    const messages = try model.find_message(a, ctx.db, ctx.sid_key, id, room_view.name)
    defer a.free(messages)
    var markup: Buf(u8) = .empty
    defer a.free(markup)
    views.create_stream(a, &markup, room_view, messages)
    var stream: Buf(u8) = .empty
    defer a.free(stream)
    turbo.gid(a, &stream, room_class(room_view.kind), room)
    a.append_str(&stream, ":messages")
    var frame: Buf(u8) = .empty
    defer a.free(frame)
    json.encode_string(a, &frame, markup)
    cable.broadcast(a, ctx.hub, stream, frame)
    var unread: Buf(u8) = .empty
    defer a.free(unread)
    a.append_str(&unread, "{\"roomId\":")
    a.append_int(&unread, room)
    a.append_str(&unread, "}")
    var members = try ctx.db.prepare("SELECT user_id FROM memberships WHERE room_id = ?")
    defer members.finalize()
    try members.bind_int(1, room)
    while (try members.next()) {
        var to: Buf(u8) = .empty
        defer a.free(to)
        a.append_str(&to, "user_")
        a.append_int(&to, members.int(0))
        a.append_str(&to, "_unreads")
        cable.broadcast(a, ctx.hub, to, unread)
    }
    var headers: Buf(u8) = .empty
    defer a.free(headers)
    a.append_str(&headers, "Location: /messages/")
    a.append_int(&headers, id)
    a.append_str(&headers, "\r\n")
    return http.respond(c, a, req, "201 Created", headers, "")
}

fn can_edit_room(db: sqlite.Db, user: i64, room: i64) !bool {
    if (try administrator(db, user)) { return true }
    var st = try db.prepare("SELECT 1 FROM rooms WHERE id = ? AND creator_id = ? LIMIT 1")
    defer st.finalize()
    try st.bind_int(1, room)
    try st.bind_int(2, user)
    return st.next()
}

fn open_room_form(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, id: i64) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    if (id == 0 and !try administrator(ctx.db, user_id) and try model.rooms_restricted(a, ctx.db)) {
        return http.respond(c, a, req, "403 Forbidden", HTML, "")
    }
    var name: Buf(u8) = .empty
    defer a.free(name)
    if (id > 0) {
        const room = try model.room_for(a, ctx.db, user_id, id) orelse { return to_root(c, a, req) }
        defer room.deinit(a)
        if (room.kind != "open") { return not_found(c, a, req) }
        a.append_str(&name, room.name)
    } else {
        a.append_str(&name, "New room")
    }
    const user = try model.find_user(a, ctx.db, ctx.sid_key, user_id) orelse { return to_sign_in(c, a, req) }
    defer user.deinit(a)
    const css = try custom_css(a, ctx.db)
    defer a.free(css)
    var logo: Buf(u8) = .empty
    defer a.free(logo)
    try logo_stamp(a, &logo, ctx.db)
    var nav: Buf(u8) = .empty
    defer a.free(nav)
    views.profile_nav(a, &nav, if (id == 0) "/" else "/")
    var body: Buf(u8) = .empty
    defer a.free(body)
    views.app_top(a, &body, if (id == 0) "New room" else "Room settings", user, ctx.vapid, logo, css, "", try administrator(ctx.db, user_id), "", nav)
    views.room_form(a, &body, id, name)
    views.app_bottom(a, &body, "", "")
    return http.respond(c, a, req, "200 OK", HTML, body)
}

fn create_open_room(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse { return to_sign_in(c, a, req) }
    if (!try administrator(ctx.db, user_id) and try model.rooms_restricted(a, ctx.db)) {
        return http.respond(c, a, req, "403 Forbidden", HTML, "")
    }
    const name = http.field(a, req, "room[name]") orelse { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
    defer a.free(name)
    if (@len(name) == 0) { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
    _ = ctx.lock_rx.recv()
    const id = write_open_room(a, ctx.db, ctx.clock, user_id, name) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    ctx.lock_tx.send(true)
    broadcast_open_room(a, &ctx, id, name, false)
    var path: Buf(u8) = .empty
    defer a.free(path)
    a.append_str(&path, "/rooms/")
    a.append_int(&path, id)
    return redirect(c, a, req, path)
}

fn write_open_room(a: Allocator, db: sqlite.Db, clock: Clock, user: i64, name: []u8) !i64 {
    var now: Buf(u8) = .empty
    defer a.free(now)
    tf.db_time(a, &now, clock.now())
    try db.exec("BEGIN IMMEDIATE")
    const id = insert_open_room(db, user, name, now) catch |e| {
        db.exec("ROLLBACK") catch {}
        return e
    }
    try db.exec("COMMIT")
    return id
}

fn insert_open_room(db: sqlite.Db, user: i64, name: []u8, now: []u8) !i64 {
    var st = try db.prepare("INSERT INTO rooms (created_at, creator_id, name, type, updated_at) VALUES (?, ?, ?, 'Rooms::Open', ?) RETURNING id")
    defer st.finalize()
    try st.bind(1, now)
    try st.bind_int(2, user)
    try st.bind(3, name)
    try st.bind(4, now)
    if (!try st.next()) { return error.Sql }
    const id = st.int(0)
    while (try st.next()) {}
    var grants = try db.prepare("INSERT INTO memberships (created_at, involvement, room_id, updated_at, user_id) SELECT ?, 'mentions', ?, ?, id FROM users WHERE status = 0")
    defer grants.finalize()
    try grants.bind(1, now)
    try grants.bind_int(2, id)
    try grants.bind(3, now)
    while (try grants.next()) {}
    return id
}

fn update_open_room(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, id: i64) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse { return to_sign_in(c, a, req) }
    const room = try model.room_for(a, ctx.db, user_id, id) orelse { return to_root(c, a, req) }
    defer room.deinit(a)
    if (room.kind != "open" or !try can_edit_room(ctx.db, user_id, id)) { return http.respond(c, a, req, "403 Forbidden", HTML, "") }
    const name = http.field(a, req, "room[name]") orelse { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
    defer a.free(name)
    if (@len(name) == 0) { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
    _ = ctx.lock_rx.recv()
    var st = ctx.db.prepare("UPDATE rooms SET name = ?, updated_at = STRFTIME('%Y-%m-%d %H:%M:%f', 'NOW') WHERE id = ? AND type = 'Rooms::Open'") catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    defer st.finalize()
    try st.bind(1, name)
    try st.bind_int(2, id)
    while (try st.next()) {}
    ctx.lock_tx.send(true)
    broadcast_open_room(a, &ctx, id, name, true)
    var path: Buf(u8) = .empty
    defer a.free(path)
    a.append_str(&path, "/rooms/")
    a.append_int(&path, id)
    return redirect(c, a, req, path)
}

fn broadcast_open_room(a: Allocator, inout ctx: Context, id: i64, name: []u8, replace: bool) void {
    const view = model.open_sidebar_room(a, id, name)
    defer view.deinit(a)
    var frame: Buf(u8) = .empty
    defer a.free(frame)
    a.append_str(&frame, "<turbo-stream action=\"")
    a.append_str(&frame, if (replace) "replace\" target=\"list_rooms_open_" else "prepend\" target=\"shared_rooms")
    if (replace) { a.append_int(&frame, id) }
    a.append_str(&frame, "\"><template>")
    views.sidebar_room(a, &frame, view)
    a.append_str(&frame, "</template></turbo-stream>")
    var message: Buf(u8) = .empty
    defer a.free(message)
    json.encode_string(a, &message, frame)
    cable.broadcast(a, ctx.hub, "rooms", message)
}

fn direct_room_new(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse { return to_sign_in(c, a, req) }
    _ = user_id
    var body: Buf(u8) = .empty
    defer a.free(body)
    views.direct_new(a, &body)
    return http.respond(c, a, req, "200 OK", HTML, body)
}

fn autocompletable_users(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse { return to_sign_in(c, a, req) }
    _ = user_id
    const query = codec.form_value(a, req.query, "query") orelse a.concat("", "")
    defer a.free(query)
    const pattern = a.concat("%", query, "%")
    defer a.free(pattern)
    var st = try ctx.db.prepare("SELECT id FROM users WHERE status = 0 AND name LIKE ? ORDER BY LOWER(name) LIMIT 20")
    defer st.finalize()
    try st.bind(1, pattern)
    var body: Buf(u8) = .empty
    defer a.free(body)
    a.push(&body, '[')
    var first = true
    while (try st.next()) {
        const user = try model.find_user(a, ctx.db, ctx.sid_key, st.int(0)) orelse { continue }
        defer user.deinit(a)
        if (!first) { a.push(&body, ',') }
        first = false
        a.append_str(&body, "{\"name\":")
        var safe: Buf(u8) = .empty
        defer a.free(safe)
        html.escape(a, &safe, user.name)
        json.encode_string(a, &body, safe)
        a.append_str(&body, ",\"value\":")
        a.append_int(&body, user.id)
        a.append_str(&body, ",\"avatar_url\":")
        const base = a.concat("http://", req.host, user.avatar)
        defer a.free(base)
        json.encode_string(a, &body, base)
        a.append_str(&body, ",\"sgid\":")
        var sgid: Buf(u8) = .empty
        defer a.free(sgid)
        bot_hooks.mention_id(a, &sgid, ctx.mention_key, user.id)
        _ = ctx.lock_rx.recv()
        uploads.register_user(ctx.db, sgid, user.id) catch |e| {
            ctx.lock_tx.send(true)
            return e
        }
        ctx.lock_tx.send(true)
        json.encode_plain(a, &body, sgid)
        a.push(&body, '}')
    }
    a.push(&body, ']')
    return http.respond(c, a, req, "200 OK", "Content-Type: application/json; charset=utf-8\r\n", body)
}

fn create_direct_room(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse { return to_sign_in(c, a, req) }
    const selected = http.fields(a, req, "user_ids[]")
    defer a.free(selected)
    var users: Buf(i64) = .empty
    defer a.free(users)
    a.push(&users, user_id)
    var valid = try ctx.db.prepare("SELECT 1 FROM users WHERE id = ? AND status = 0 LIMIT 1")
    defer valid.finalize()
    var selected_index = 0
    while (selected_index < @len(selected)) {
        const candidate = text.parse_int(selected[selected_index]) orelse { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
        var duplicate = false
        for (users) |member| { if (member == candidate) { duplicate = true } }
        selected_index = selected_index + 1
        if (duplicate) { continue }
        valid.reset()
        try valid.bind_int(1, candidate)
        if (!try valid.next()) { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
        a.push(&users, candidate)
    }
    if (@len(users) < 2) { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
    _ = ctx.lock_rx.recv()
    const id = write_direct_room(a, ctx.db, ctx.clock, user_id, users) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    ctx.lock_tx.send(true)
    var member_index = 0
    while (member_index < @len(users)) {
        try broadcast_direct_room(a, &ctx, id, users[member_index])
        member_index = member_index + 1
    }
    var path: Buf(u8) = .empty
    defer a.free(path)
    a.append_str(&path, "/rooms/")
    a.append_int(&path, id)
    return redirect(c, a, req, path)
}

fn broadcast_direct_room(a: Allocator, inout ctx: Context, room: i64, user: i64) !void {
    const sb = try model.sidebar(a, ctx.db, ctx.sid_key, user)
    defer sb.deinit(a)
    for (sb.directs) |d| {
        if (d.room_id == room) {
            var markup: Buf(u8) = .empty
            defer a.free(markup)
            a.append_str(&markup, "<turbo-stream action=\"prepend\" target=\"direct_rooms\"><template>")
            views.sidebar_direct(a, &markup, d)
            a.append_str(&markup, "</template></turbo-stream>")
            var stream: Buf(u8) = .empty
            defer a.free(stream)
            turbo.gid(a, &stream, "User", user)
            a.append_str(&stream, ":rooms")
            var frame: Buf(u8) = .empty
            defer a.free(frame)
            json.encode_string(a, &frame, markup)
            cable.broadcast(a, ctx.hub, stream, frame)
            break
        }
    }
}

fn write_direct_room(a: Allocator, db: sqlite.Db, clock: Clock, user: i64, users: Buf(i64)) !i64 {
    var sql: Buf(u8) = .empty
    defer a.free(sql)
    a.append_str(&sql, "SELECT rooms.id FROM rooms JOIN memberships ON memberships.room_id = rooms.id WHERE rooms.type = 'Rooms::Direct' GROUP BY rooms.id HAVING COUNT(*) = ")
    a.append_int(&sql, @len(users))
    a.append_str(&sql, " AND SUM(memberships.user_id IN (")
    var first = true
    for (users) |member| {
        if (!first) { a.push(&sql, ',') }
        first = false
        a.append_int(&sql, member)
    }
    a.append_str(&sql, ")) = ")
    a.append_int(&sql, @len(users))
    a.append_str(&sql, " ORDER BY rooms.id LIMIT 1")
    var exists = try db.prepare_text(sql)
    defer exists.finalize()
    if (try exists.next()) { return exists.int(0) }
    var now: Buf(u8) = .empty
    defer a.free(now)
    tf.db_time(a, &now, clock.now())
    try db.exec("BEGIN IMMEDIATE")
    const id = insert_direct_room(db, now, user, users) catch |e| {
        db.exec("ROLLBACK") catch {}
        return e
    }
    try db.exec("COMMIT")
    return id
}

fn insert_direct_room(db: sqlite.Db, now: []u8, user: i64, users: Buf(i64)) !i64 {
    var st = try db.prepare("INSERT INTO rooms (created_at, creator_id, name, type, updated_at) VALUES (?, ?, NULL, 'Rooms::Direct', ?) RETURNING id")
    defer st.finalize()
    try st.bind(1, now)
    try st.bind_int(2, user)
    try st.bind(3, now)
    if (!try st.next()) { return error.Sql }
    const id = st.int(0)
    while (try st.next()) {}
    var grants = try db.prepare("INSERT INTO memberships (created_at, involvement, room_id, updated_at, user_id) VALUES (?, 'everything', ?, ?, ?)")
    defer grants.finalize()
    for (users) |member| {
        grants.reset()
        try grants.bind(1, now)
        try grants.bind_int(2, id)
        try grants.bind(3, now)
        try grants.bind_int(4, member)
        while (try grants.next()) {}
    }
    return id
}

fn update_profile(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    if (req.method != "POST" and req.method != "PATCH" and req.method != "PUT") {
        return not_found(c, a, req)
    }
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    if (http.file(a, req, "user[avatar]")) |upload| {
        defer upload.deinit(a)
        return upload_picture(c, a, &ctx, req, upload, "User", user_id, "avatar", "/users/me/profile")
    }
    const name = http.field(a, req, "user[name]") orelse {
        return http.respond(c, a, req, "422 Unprocessable Content", HTML, "")
    }
    defer a.free(name)
    const email = http.field(a, req, "user[email_address]") orelse a.concat("", "")
    defer a.free(email)
    const bio = http.field(a, req, "user[bio]") orelse a.concat("", "")
    defer a.free(bio)
    const password = http.field(a, req, "user[password]") orelse a.concat("", "")
    defer a.free(password)
    if (@len(name) == 0 or @len(bio) > 200 or @len(password) > 72) {
        return http.respond(c, a, req, "422 Unprocessable Content", HTML, "")
    }
    const digest = if (@len(password) > 0) crypto.bcrypt_hash(a, ctx.rng, password) orelse a.concat("", "") else a.concat("", "")
    defer a.free(digest)
    _ = ctx.lock_rx.recv()
    var st = ctx.db.prepare(if (@len(password) > 0) "UPDATE users SET name = ?, email_address = ?, bio = ?, password_digest = ?, updated_at = STRFTIME('%Y-%m-%d %H:%M:%f', 'NOW') WHERE id = ?" else "UPDATE users SET name = ?, email_address = ?, bio = ?, updated_at = STRFTIME('%Y-%m-%d %H:%M:%f', 'NOW') WHERE id = ?") catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    defer st.finalize()
    try st.bind(1, name)
    try st.bind(2, email)
    try st.bind(3, bio)
    if (@len(password) > 0) {
        try st.bind(4, digest)
        try st.bind_int(5, user_id)
    } else {
        try st.bind_int(4, user_id)
    }
    while (try st.next()) {}
    ctx.lock_tx.send(true)
    return redirect_notice(c, a, &ctx, req, "/users/me/profile", "Profile updated")
}

fn involvement(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, room_id: i64) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    const room = try model.room_for(a, ctx.db, user_id, room_id) orelse {
        return to_root(c, a, req)
    }
    defer room.deinit(a)
    if (req.method == "POST" or req.method == "PUT") {
        const next = codec.form_value(a, req.query, "involvement") orelse {
            return http.respond(c, a, req, "422 Unprocessable Content", HTML, "")
        }
        defer a.free(next)
        if (next != "mentions" and next != "everything" and next != "nothing" and next != "invisible") {
            return http.respond(c, a, req, "422 Unprocessable Content", HTML, "")
        }
        var old_st = try ctx.db.prepare("SELECT involvement FROM memberships WHERE room_id = ? AND user_id = ?")
        defer old_st.finalize()
        try old_st.bind_int(1, room_id)
        try old_st.bind_int(2, user_id)
        if (!try old_st.next()) { return not_found(c, a, req) }
        const old = old_st.text(a, 0)
        defer a.free(old)
        _ = ctx.lock_rx.recv()
        var change = ctx.db.prepare("UPDATE memberships SET involvement = ?, updated_at = STRFTIME('%Y-%m-%d %H:%M:%f', 'NOW') WHERE room_id = ? AND user_id = ?") catch |e| {
            ctx.lock_tx.send(true)
            return e
        }
        defer change.finalize()
        try change.bind(1, next)
        try change.bind_int(2, room_id)
        try change.bind_int(3, user_id)
        while (try change.next()) {}
        ctx.lock_tx.send(true)
        if (room.kind != "direct" and (old == "invisible" or next == "invisible") and old != next) {
            broadcast_involvement(a, &ctx, user_id, room, next == "invisible")
        }
        var path: Buf(u8) = .empty
        defer a.free(path)
        a.append_str(&path, "/rooms/")
        a.append_int(&path, room_id)
        a.append_str(&path, "/involvement")
        return redirect(c, a, req, path)
    }
    if (req.method != "GET") {
        return not_found(c, a, req)
    }
    var st = try ctx.db.prepare("SELECT involvement FROM memberships WHERE room_id = ? AND user_id = ?")
    defer st.finalize()
    try st.bind_int(1, room_id)
    try st.bind_int(2, user_id)
    if (!try st.next()) {
        return not_found(c, a, req)
    }
    const setting = st.text(a, 0)
    defer a.free(setting)
    var body: Buf(u8) = .empty
    defer a.free(body)
    views.involvement_frame(a, &body, room_id, room.kind, setting)
    return http.respond(c, a, req, "200 OK", HTML, body)
}

fn broadcast_involvement(a: Allocator, inout ctx: Context, user: i64, room: model.RoomView, hidden: bool) void {
    var markup: Buf(u8) = .empty
    defer a.free(markup)
    a.append_str(&markup, if (hidden) "<turbo-stream action=\"remove\" target=\"list_rooms_" else "<turbo-stream action=\"prepend\" target=\"shared_rooms\"><template>")
    if (hidden) {
        a.append_str(&markup, if (room.kind == "closed") "closed_" else "open_")
        a.append_int(&markup, room.id)
        a.append_str(&markup, "\"></turbo-stream>")
    } else {
        const view = model.sidebar_room_view(a, room.id, room.name, room.kind)
        defer view.deinit(a)
        views.sidebar_room(a, &markup, view)
        a.append_str(&markup, "</template></turbo-stream>")
    }
    var stream: Buf(u8) = .empty
    defer a.free(stream)
    turbo.gid(a, &stream, "User", user)
    a.append_str(&stream, ":rooms")
    var frame: Buf(u8) = .empty
    defer a.free(frame)
    json.encode_string(a, &frame, markup)
    cable.broadcast(a, ctx.hub, stream, frame)
}

// Whether the code point is in [[:word:]] (letter, mark, decimal digit or
// connector punctuation), approximately outside ASCII: Latin-1's symbols,
// general and CJK punctuation, arrows, symbols and emoji are not.
fn word_char(c: i64) bool {
    if (c < 0x80) {
        return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'
    }
    if (c < 0xC0) {
        return c == 0xAA or c == 0xB5 or c == 0xBA
    }
    if (c == 0xD7 or c == 0xF7) {
        return false
    }
    if (c >= 0x2000 and c <= 0x2BFF) {
        return c == 0x203F or c == 0x2040 or c == 0x2054 or (c >= 0x2070 and c <= 0x209F and c != 0x207A and c != 0x207B and c != 0x207C and c != 0x207D and c != 0x207E and c != 0x208A and c != 0x208B and c != 0x208C and c != 0x208D and c != 0x208E) or (c >= 0x20D0 and c <= 0x20FF) or (c >= 0x2100 and c <= 0x214F and (c == 0x2102 or c == 0x2107 or (c >= 0x210A and c <= 0x2113) or c == 0x2115 or (c >= 0x2119 and c <= 0x211D) or c == 0x2124 or c == 0x2126 or c == 0x2128 or (c >= 0x212A and c <= 0x212D) or (c >= 0x212F and c <= 0x2139) or (c >= 0x213C and c <= 0x213F) or (c >= 0x2145 and c <= 0x2149) or c == 0x214E))
    }
    if ((c >= 0x3000 and c <= 0x3004) or (c >= 0x3008 and c <= 0x3020) or c == 0x3030 or (c >= 0xFF01 and c <= 0xFF0F) or (c >= 0xFF1A and c <= 0xFF20)) {
        return false
    }
    return !(c >= 0x1F000 and c <= 0x1FAFF)
}

// params[:q]&.gsub(/[^[:word:]]/, " "): each character outside [[:word:]]
// becomes one space.
fn sanitize_query(a: Allocator, q: []u8) Buf(u8) {
    var out: Buf(u8) = .empty
    var i = 0
    while (i < @len(q)) {
        const b = @as(i64, q[i])
        var n = 1
        var c = b
        if (b >= 0xF0) {
            n = 4
            c = b & 0x07
        } else if (b >= 0xE0) {
            n = 3
            c = b & 0x0F
        } else if (b >= 0xC0) {
            n = 2
            c = b & 0x1F
        }
        if (i + n > @len(q)) {
            n = @len(q) - i
        }
        var k = 1
        while (k < n) {
            c = c * 64 + (@as(i64, q[i + k]) & 0x3F)
            k = k + 1
        }
        if (word_char(c)) {
            a.append_str(&out, q[i..i + n])
        } else {
            a.push(&out, ' ')
        }
        i = i + n
    }
    return out
}

// GET /searches?q=: the user's messages matching q, and recent searches.
fn search_page(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    const gen = try ctx.cache.generation_now(a)
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    const key = cache_key(a, "searches#index", user_id, req)
    defer a.free(key)
    if (try cached(c, a, &ctx, req, gen, key, "")) {
        return
    }
    const user = try model.find_user(a, ctx.db, ctx.sid_key, user_id) orelse {
        return to_sign_in(c, a, req)
    }
    defer user.deinit(a)
    var has_q = false
    var q: Buf(u8) = .empty
    defer a.free(q)
    if (codec.form_value(a, req.query, "q")) |v| {
        has_q = true
        a.free(@replace(&q, v))
    }
    const query = sanitize_query(a, q)
    defer a.free(query)
    const blank = text.trim(a, query)
    defer a.free(blank)
    const has_query = has_q and @len(blank) > 0
    var messages: Buf(model.MessageView) = .empty
    defer a.free(messages)
    if (has_query) {
        a.free(@replace(&messages, try model.search(a, ctx.db, ctx.sid_key, user_id, query)))
    }
    const recent = try model.recent_searches(a, ctx.db, user_id)
    defer a.free(recent)
    var last_room = 0
    if (codec.cookie_value(a, req.cookie, "last_room")) |v| {
        last_room = text.parse_int(v) orelse 0
        a.free(v)
    }
    const back = try model.return_room(ctx.db, user_id, last_room)
    const admin = try administrator(ctx.db, user_id)
    var logo: Buf(u8) = .empty
    defer a.free(logo)
    try logo_stamp(a, &logo, ctx.db)
    const base = a.concat("http://", req.host)
    defer a.free(base)
    var body: Buf(u8) = .empty
    defer a.free(body)
    var cuts: Buf(i64) = .empty
    defer a.free(cuts)
    ctx.frags.begin(a, gen)
    const css = try custom_css(a, ctx.db)
    defer a.free(css)
    views.search_index(a, &body, user, messages, recent, has_query, query, has_q, q, back, base, ctx.vapid, logo, css, admin, &ctx.frags, &cuts)
    return page_out(c, a, &ctx, req, gen, key, "", body, cuts)
}

// The Content-Type header of a file, by its extension.
fn content_type(path: []u8) str {
    if (text.ends_with(path, ".css")) {
        return "Content-Type: text/css\r\n"
    } else if (text.ends_with(path, ".js")) {
        return "Content-Type: text/javascript\r\n"
    } else if (text.ends_with(path, ".svg")) {
        return "Content-Type: image/svg+xml\r\n"
    } else if (text.ends_with(path, ".png")) {
        return "Content-Type: image/png\r\n"
    } else if (text.ends_with(path, ".gif")) {
        return "Content-Type: image/gif\r\n"
    } else if (text.ends_with(path, ".webp")) {
        return "Content-Type: image/webp\r\n"
    } else if (text.ends_with(path, ".mp3")) {
        return "Content-Type: audio/mpeg\r\n"
    } else if (text.ends_with(path, ".json") or text.ends_with(path, ".map")) {
        return "Content-Type: application/json\r\n"
    }
    return "Content-Type: application/octet-stream\r\n"
}

// GET /assets/<digested path>: a precompiled asset, cached for 30 days.
fn asset(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    const name = req.path[@len("/assets/")..]
    if (@len(name) == 0 or text.contains(name, "..") or text.contains(name, "//")) {
        return not_found(c, a, req)
    }
    const path = a.concat(ctx.assets, "/", name)
    defer a.free(path)
    const key = filecache.key_for(a, path, req)
    defer a.free(key)
    const i = ctx.files_sent.find(key)
    if (i >= 0) {
        return ctx.files_sent.send(c, a, i, req)
    }
    const body = ctx.fs.read(a, path) catch {
        return not_found(c, a, req)
    }
    defer a.free(body)
    var headers: Buf(u8) = .empty
    defer a.free(headers)
    a.append_str(&headers, content_type(name))
    a.append_str(&headers, "Cache-Control: public, max-age=2592000\r\n")
    return send_file(c, a, &ctx, req, key, headers, body)
}

// A file's 200 response, kept under key for the next request.
fn send_file(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, key: []u8, headers: []u8, body: []u8) !void {
    const e = http.encode(a, req, headers, body)
    defer e.deinit(a)
    ctx.files_sent.put(a, key, e.headers, e.body)
    return http.conditional(c, a, req, "", e.headers, e.body)
}

// ActiveStorage's digest of the :square variant (resize_to_limit
// [512, 512], format :webp).
const SQUARE = "6gwfjNKv9eUy9jNUtEZvQFLU0hQ="

// GET /users/<signed id>/avatar: the avatar's processed :square variant.
fn avatar(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, token: []u8) !void {
    _ = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    const user = signed_id.verify(a, ctx.sid_key, token, "user/avatar") orelse {
        return http.respond(c, a, req, "404 Not Found", HTML, "")
    }
    var st = try ctx.db.prepare("SELECT b.key, b.content_type FROM users u JOIN active_storage_attachments ua ON ua.record_type = 'User' AND ua.record_id = u.id AND ua.name = 'avatar' JOIN active_storage_variant_records v ON v.blob_id = ua.blob_id AND v.variation_digest = ? JOIN active_storage_attachments va ON va.record_type = 'ActiveStorage::VariantRecord' AND va.record_id = v.id AND va.name = 'image' JOIN active_storage_blobs b ON b.id = va.blob_id WHERE u.id = ?")
    defer st.finalize()
    try st.bind(1, SQUARE)
    try st.bind_int(2, user)
    if (!try st.next()) {
        return uploaded_avatar(c, a, &ctx, req, user)
    }
    const key = st.text(a, 0)
    defer a.free(key)
    if (@len(key) < 4) {
        return not_found(c, a, req)
    }
    const kind = st.text(a, 1)
    defer a.free(kind)
    const path = a.concat(ctx.files, "/", key[0..2], "/", key[2..4], "/", key)
    defer a.free(path)
    const sent = filecache.key_for(a, path, req)
    defer a.free(sent)
    const i = ctx.files_sent.find(sent)
    if (i >= 0) {
        return ctx.files_sent.send(c, a, i, req)
    }
    const body = ctx.fs.read(a, path) catch {
        return not_found(c, a, req)
    }
    defer a.free(body)
    var headers: Buf(u8) = .empty
    defer a.free(headers)
    a.append_str(&headers, "Content-Type: ")
    a.append_str(&headers, kind)
    a.append_str(&headers, "\r\nContent-Disposition: inline; filename=\"")
    a.append_str(&headers, key)
    a.append_str(&headers, "\"; filename*=UTF-8''")
    a.append_str(&headers, key)
    a.append_str(&headers, "\r\nCache-Control: max-age=1800, public, stale-while-revalidate=604800\r\n")
    return send_file(c, a, &ctx, req, sent, headers, body)
}

// Users::AvatarsHelper::AVATAR_COLORS, 18 of 7 bytes each.
const AVATAR_COLORS = "#AF2E1B#CC6324#3B4B59#BFA07A#ED8008#ED3F1C#BF1B1B#736B1E#D07B53#736356#AD1D1D#BF7C2A#C09C6F#698F9C#7C956B#5D618F#3B3633#67695E"

// A user without an uploaded avatar: a bot's stock picture, or an SVG of
// the initials on a color picked by Zlib.crc32 of the id.
fn drawn_avatar(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, user: i64) !void {
    var st = try ctx.db.prepare("SELECT name, role FROM users WHERE id = ?")
    defer st.finalize()
    try st.bind_int(1, user)
    if (!try st.next()) {
        return not_found(c, a, req)
    }
    if (st.int(1) == 2) {
        return stock_file(c, a, &ctx, req, "default-bot-avatar-de1d12f7.svg", "Content-Type: image/svg+xml\r\nContent-Disposition: inline; filename=\"default-bot-avatar.svg\"; filename*=UTF-8''default-bot-avatar.svg\r\nCache-Control: max-age=1800, public, stale-while-revalidate=604800\r\n")
    }
    const name = st.text(a, 0)
    defer a.free(name)
    const letters = initials(a, name)
    defer a.free(letters)
    var id: Buf(u8) = .empty
    defer a.free(id)
    a.append_int(&id, user)
    var body: Buf(u8) = .empty
    defer a.free(body)
    const color = gzip.checksum(id) % 18 * 7
    views.avatar_svg(a, &body, AVATAR_COLORS[color..color + 7], letters, @len(letters) >= 3)
    return http.respond(c, a, req, "200 OK", "Content-Type: image/svg+xml; charset=utf-8\r\nCache-Control: max-age=1800, public, stale-while-revalidate=604800\r\n", body)
}

// User#initials, name.scan(/\b\w/).join: an ASCII word character that
// starts a word (any non-ASCII byte counts as part of a word, as Ruby's \b
// sees Unicode letters).
fn initials(a: Allocator, name: []u8) Buf(u8) {
    var out: Buf(u8) = .empty
    var prev_word = false
    for (name) |ch| {
        const ascii_word = (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_'
        if (ascii_word and !prev_word) {
            a.push(&out, ch)
        }
        prev_word = ascii_word or ch >= 128
    }
    return out
}

// A file of the precompiled assets under its own headers, kept like an
// asset's response.
fn stock_file(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, name: str, headers: str) !void {
    const path = a.concat(ctx.assets, "/", name)
    defer a.free(path)
    const key = filecache.key_for(a, path, req)
    defer a.free(key)
    const i = ctx.files_sent.find(key)
    if (i >= 0) {
        return ctx.files_sent.send(c, a, i, req)
    }
    const body = ctx.fs.read(a, path) catch {
        return not_found(c, a, req)
    }
    defer a.free(body)
    return send_file(c, a, &ctx, req, key, headers, body)
}

// GET /account/logo: the stock app icon, public so it can be the PWA's
// icon (an uploaded logo is not served yet).
fn account_logo(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    var logo = try ctx.db.prepare("SELECT b.key, b.content_type, p.key FROM active_storage_blobs b LEFT JOIN egg_blob_previews p ON p.blob_id=b.id JOIN active_storage_attachments a ON a.blob_id=b.id AND a.record_type='Account' AND a.name='logo' JOIN accounts ac ON ac.id=a.record_id ORDER BY ac.id LIMIT 1")
    defer logo.finalize()
    if (try logo.next()) {
        const key = logo.text(a, 0)
        defer a.free(key)
        const mime = logo.text(a, 1)
        defer a.free(mime)
        const small = logo.text(a, 2)
        defer a.free(small)
        const selected = if (text.contains(req.query, "size=small") and @len(small) > 0) a.concat(small, "") else a.concat(key, "")
        defer a.free(selected)
        return picture_file(c, a, &ctx, req, selected, mime)
    }
    var small = false
    if (codec.form_value(a, req.query, "size")) |v| {
        small = v == "small"
        a.free(v)
    }
    if (small) {
        return stock_file(c, a, &ctx, req, "logos/app-icon-192-646b105a.png", "Content-Type: image/png\r\nContent-Disposition: inline; filename=\"app-icon-192.png\"; filename*=UTF-8''app-icon-192.png\r\nCache-Control: max-age=300, public, stale-while-revalidate=604800\r\n")
    }
    return stock_file(c, a, &ctx, req, "logos/app-icon-a6fa894e.png", "Content-Type: image/png\r\nContent-Disposition: inline; filename=\"app-icon.png\"; filename*=UTF-8''app-icon.png\r\nCache-Control: max-age=300, public, stale-while-revalidate=604800\r\n")
}

// GET /webmanifest.json
fn web_manifest(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    var name: Buf(u8) = .empty
    defer a.free(name)
    var stamp: Buf(u8) = .empty
    defer a.free(stamp)
    var st = try ctx.db.prepare("SELECT name, updated_at FROM accounts ORDER BY id LIMIT 1")
    defer st.finalize()
    if (try st.next()) {
        const n = st.text(a, 0)
        defer a.free(n)
        json.encode_plain(a, &name, n)
        const t = st.text(a, 1)
        defer a.free(t)
        a.append_str(&stamp, "v=")
        tf.number_stamp(a, &stamp, tf.parse_db(t) orelse 0)
    } else {
        a.append_str(&name, "\"Campfire\"")
    }
    var small: Buf(u8) = .empty
    defer a.free(small)
    var large: Buf(u8) = .empty
    defer a.free(large)
    a.append_str(&small, "/account/logo?size=small")
    a.append_str(&large, "/account/logo")
    if (@len(stamp) > 0) {
        a.append_str(&small, "&")
        a.append_str(&small, stamp)
        a.append_str(&large, "?")
        a.append_str(&large, stamp)
    }
    var small_json: Buf(u8) = .empty
    defer a.free(small_json)
    json.encode_plain(a, &small_json, small)
    var large_json: Buf(u8) = .empty
    defer a.free(large_json)
    json.encode_plain(a, &large_json, large)
    const base = a.concat("http://", req.host)
    defer a.free(base)
    var body: Buf(u8) = .empty
    defer a.free(body)
    views.manifest(a, &body, name, small_json, large_json, base)
    return http.respond(c, a, req, "200 OK", "Content-Type: application/json; charset=utf-8\r\n", body)
}

// GET /service-worker.js
fn service_worker(c: TcpConn, a: Allocator, req: http.Request) !void {
    var body: Buf(u8) = .empty
    defer a.free(body)
    views.service_worker(a, &body)
    return http.respond(c, a, req, "200 OK", "Content-Type: text/javascript; charset=utf-8\r\n", body)
}

// verify_authenticity_token as the Rust app does it, by headers instead of
// tokens: an Origin must be this app's, and Sec-Fetch-Site same-origin or
// same-site, or absent (this is plain HTTP).
fn same_origin(a: Allocator, req: http.Request) bool {
    if (@len(req.origin) > 0) {
        const base = a.concat("http://", req.host)
        defer a.free(base)
        if (req.origin != base) {
            return false
        }
    }
    return @len(req.fetch_site) == 0 or req.fetch_site == "same-origin" or req.fetch_site == "same-site"
}

// POST /rooms/:id/messages: the message, and a turbo-stream appending it to
// the room's messages.
fn create_message(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, id: i64) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    const room = try model.room_for(a, ctx.db, user_id, id) orelse {
        return not_found(c, a, req)
    }
    defer room.deinit(a)
    if (http.file(a, req, "message[attachment]")) |upload| {
        defer upload.deinit(a)
        return upload_message(c, a, &ctx, req, room, user_id, upload)
    }
    var has_body = false
    var body: Buf(u8) = .empty
    defer a.free(body)
    if (http.field(a, req, "message[body]")) |v| {
        has_body = true
        a.free(@replace(&body, v))
    }
    var client_id: Buf(u8) = .empty
    defer a.free(client_id)
    if (http.field(a, req, "message[client_message_id]")) |v| {
        a.free(@replace(&client_id, v))
    }
    _ = ctx.lock_rx.recv()
    const message_id = model.create_message_notify(a, ctx.db, ctx.clock, ctx.rng, room.id, user_id, has_body, body, client_id, ctx.mention_key) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    ctx.lock_tx.send(true)
    return send_created_message(c, a, &ctx, req, room, message_id)
}

fn send_created_message(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, room: model.RoomView, message_id: i64) !void {
    const others = try model.display_name(a, ctx.db, room.id, room.kind == "direct", room.name, 0)
    defer a.free(others)
    const messages = try model.find_message(a, ctx.db, ctx.sid_key, message_id, others)
    defer a.free(messages)
    var out: Buf(u8) = .empty
    defer a.free(out)
    views.create_stream(a, &out, room, messages)
    // message.broadcast_create: the same turbo-stream, appended for everyone
    // on the room's messages stream.
    var stream: Buf(u8) = .empty
    defer a.free(stream)
    turbo.gid(a, &stream, room_class(room.kind), room.id)
    a.append_str(&stream, ":messages")
    var message: Buf(u8) = .empty
    defer a.free(message)
    json.encode_string(a, &message, out)
    cable.broadcast(a, ctx.hub, stream, message)
    // broadcast_unread_room: each member's unread stream hears of the room.
    var unread: Buf(u8) = .empty
    defer a.free(unread)
    a.append_str(&unread, "{\"roomId\":")
    a.append_int(&unread, room.id)
    a.append_str(&unread, "}")
    var st = try ctx.db.prepare("SELECT user_id FROM memberships WHERE room_id = ?")
    defer st.finalize()
    try st.bind_int(1, room.id)
    while (try st.next()) {
        var to: Buf(u8) = .empty
        defer a.free(to)
        a.append_str(&to, "user_")
        a.append_int(&to, st.int(0))
        a.append_str(&to, "_unreads")
        cable.broadcast(a, ctx.hub, to, unread)
    }
    return http.respond(c, a, req, "200 OK", "Content-Type: text/vnd.turbo-stream.html; charset=utf-8\r\n", out)
}

// String#to_i: an optional sign and the digits that follow, else 0; held
// within what a time in nanoseconds can hold (about 1677 to 2262), which
// keeps a crafted value from overflowing and finds the same messages.
fn to_i_ms(s: []u8) i64 {
    var i = 0
    while (i < @len(s) and (s[i] == ' ' or s[i] == '\t' or s[i] == '\n')) {
        i = i + 1
    }
    var negative = false
    if (i < @len(s) and (s[i] == '-' or s[i] == '+')) {
        negative = s[i] == '-'
        i = i + 1
    }
    const limit = 9000000000000
    var n = 0
    while (i < @len(s) and s[i] >= '0' and s[i] <= '9') {
        if (n < limit) {
            n = n * 10 + @as(i64, s[i] - '0')
        }
        i = i + 1
    }
    if (n > limit) {
        n = limit
    }
    return if (negative) -n else n
}

// GET /rooms/:id/refresh?since=<ms>: what changed in the room since the
// page loaded (Rooms::RefreshesController), for a page that was away: the
// messages made since, appended, and those changed since, each replaced.
fn room_refresh(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, id: i64) !void {
    const user_id = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse {
        return to_sign_in(c, a, req)
    }
    const room = try model.room_for(a, ctx.db, user_id, id) orelse {
        return not_found(c, a, req)
    }
    defer room.deinit(a)
    var since_ms = 0
    if (codec.form_value(a, req.query, "since")) |v| {
        since_ms = to_i_ms(v)
        a.free(v)
    }
    var since: Buf(u8) = .empty
    defer a.free(since)
    tf.db_time(a, &since, since_ms * 1000000)
    const others = try model.display_name(a, ctx.db, room.id, room.kind == "direct", room.name, 0)
    defer a.free(others)
    const created = try model.page_created_since(a, ctx.db, ctx.sid_key, room.id, since, others)
    defer a.free(created)
    const updated = try model.page_updated_since(a, ctx.db, ctx.sid_key, room.id, since, others)
    defer a.free(updated)
    // rooms/refreshes/show.turbo_stream.erb, as Erubi renders it.
    var out: Buf(u8) = .empty
    defer a.free(out)
    if (@len(created) > 0) {
        a.append_str(&out, "<turbo-stream action=\"append\" target=\"messages_rooms_")
        a.append_str(&out, room.kind)
        a.append_str(&out, "_")
        a.append_int(&out, room.id)
        a.append_str(&out, "\"><template>\n  ")
        for (created) |m| {
            views.message(a, &out, m)
        }
        a.append_str(&out, "\n</template></turbo-stream>")
    }
    a.append_str(&out, "\n")
    for (updated) |m| {
        a.append_str(&out, "  <turbo-stream action=\"replace\" target=\"message_")
        html.escape(a, &out, m.client_id)
        a.append_str(&out, "\"><template>")
        views.message(a, &out, m)
        a.append_str(&out, "</template></turbo-stream>\n")
    }
    return http.respond(c, a, req, "200 OK", "Content-Type: text/vnd.turbo-stream.html; charset=utf-8\r\n", out)
}

// A room's class, for its GlobalID, from its kind.
fn room_class(kind: []u8) str {
    if (kind == "closed") {
        return "Rooms::Closed"
    } else if (kind == "direct") {
        return "Rooms::Direct"
    }
    return "Rooms::Open"
}

// A single delivery thread reads the durable outbox. HTTP workers never wait
// for remote services; database writes still use their shared write token.
fn deliver_webhook(a: Allocator, inout ctx: Context) !bool {
    const next = try bot_hooks.next_job(a, ctx.db) orelse { return false }
    defer next.deinit(a)
    const job = next.id
    const room = next.room
    const bot = next.bot
    if (!try bot_hooks.active_bot(ctx.db, bot, room, next.message)) {
        try finish_webhook_locked(&ctx, job)
        return true
    }
    const reply = try webhook_http.post(a, next.url, next.payload)
    defer reply.deinit(a)
    var body: Buf(u8) = .empty
    defer a.free(body)
    if (reply.code == 28) {
        a.append_str(&body, "Failed to respond within ")
        a.append_int(&body, reply.timeout)
        a.append_str(&body, " seconds")
    } else if (reply.code != 0) {
        try finish_webhook_locked(&ctx, job)
        return error.WebhookTransport
    } else if (reply.status == 200 and (reply.content_type == "text/plain" or reply.content_type == "text/html")) {
        a.append_str(&body, reply.body)
    } else if (@len(reply.content_type) > 0) {
        // Binary replies are stored as message attachments below.
        return deliver_webhook_attachment(a, &ctx, job, room, bot, reply)
    }
    if (@len(body) > 0) {
        _ = ctx.lock_rx.recv()
        const id = write_webhook_text(a, &ctx, job, room, bot, body) catch |e| {
            ctx.lock_tx.send(true)
            return e
        }
        ctx.lock_tx.send(true)
        try broadcast_bot_reply(a, &ctx, room, bot, id)
    } else {
        try finish_webhook_locked(&ctx, job)
    }
    return true
}
fn finish_webhook_locked(inout ctx: Context, job: i64) !void {
    _ = ctx.lock_rx.recv()
    finish_webhook(ctx.db, job) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    ctx.lock_tx.send(true)
}
fn finish_webhook(db: sqlite.Db, job: i64) !void {
    var st = try db.prepare("DELETE FROM egg_webhook_jobs WHERE id=?")
    defer st.finalize()
    try st.bind_int(1, job)
    while (try st.next()) {}
}
fn broadcast_bot_reply(a: Allocator, inout ctx: Context, room: i64, bot: i64, id: i64) !void {
    const view = try model.room_for(a, ctx.db, bot, room) orelse { return }
    defer view.deinit(a)
    const messages = try model.find_message(a, ctx.db, ctx.sid_key, id, view.name)
    defer a.free(messages)
    var markup: Buf(u8) = .empty
    defer a.free(markup)
    views.create_stream(a, &markup, view, messages)
    var stream: Buf(u8) = .empty
    defer a.free(stream)
    turbo.gid(a, &stream, room_class(view.kind), room)
    a.append_str(&stream, ":messages")
    var frame: Buf(u8) = .empty
    defer a.free(frame)
    json.encode_string(a, &frame, markup)
    cable.broadcast(a, ctx.hub, stream, frame)
    var unread: Buf(u8) = .empty
    defer a.free(unread)
    a.append_str(&unread, "{\"roomId\":")
    a.append_int(&unread, room)
    a.push(&unread, '}')
    var members = try ctx.db.prepare("SELECT user_id FROM memberships WHERE room_id=?")
    defer members.finalize()
    try members.bind_int(1, room)
    while (try members.next()) {
        var to: Buf(u8) = .empty
        defer a.free(to)
        a.append_str(&to, "user_")
        a.append_int(&to, members.int(0))
        a.append_str(&to, "_unreads")
        cable.broadcast(a, ctx.hub, to, unread)
    }
}

fn deliver_webhook_attachment(a: Allocator, inout ctx: Context, job: i64, room: i64, bot: i64, reply: webhook_http.Reply) !bool {
    const key = session.base58(a, ctx.rng, 28)
    defer a.free(key)
    const type = safe_attachment_type(a, reply.content_type)
    defer a.free(type)
    const filename = if (type == "image/png") "attachment.png" else if (type == "image/jpeg") "attachment.jpg" else if (type == "application/pdf") "attachment.pdf" else if (type == "text/plain") "attachment.txt" else "attachment.bin"
    const dir = a.concat(ctx.files, "/", key[0..2], "/", key[2..4])
    defer a.free(dir)
    var i = 1
    while (i <= @len(dir)) {
        if (i == @len(dir) or dir[i] == '/') { ctx.fs.make_dir(dir[0..i]) catch {} }
        i = i + 1
    }
    const path = a.concat(dir, "/", key)
    defer a.free(path)
    try ctx.fs.write(path, reply.body)
    var body: Buf(u8) = .empty
    defer a.free(body)
    a.append_str(&body, "<a href=\"/attachments/")
    a.append_str(&body, key)
    a.append_str(&body, "\">")
    a.append_str(&body, filename)
    a.append_str(&body, "</a>")
    _ = ctx.lock_rx.recv()
    const id = write_webhook_attachment(a, &ctx, job, room, bot, key, filename, type, reply.body, body) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    ctx.lock_tx.send(true)
    try broadcast_bot_reply(a, &ctx, room, bot, id)
    return true
}
fn safe_attachment_type(a: Allocator, mime: []u8) Buf(u8) {
    const end = text.find(mime, ";") orelse @len(mime)
    const type = mime[0..end]
    for (type) |c| {
        if (!((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '/' or c == '-' or c == '+' or c == '.' or c == '_')) { return a.concat("application/octet-stream", "") }
    }
    if (!text.contains(type, "/")) { return a.concat("application/octet-stream", "") }
    return a.concat(type, "")
}
fn write_webhook_attachment(a: Allocator, inout ctx: Context, job: i64, room: i64, bot: i64, key: []u8, filename: str, type: []u8, data: []u8, body: []u8) !i64 {
    try ctx.db.exec("BEGIN IMMEDIATE")
    const id = insert_webhook_attachment(a, &ctx, job, room, bot, key, filename, type, data, body) catch |e| {
        ctx.db.exec("ROLLBACK") catch {}
        return e
    }
    try ctx.db.exec("COMMIT")
    return id
}
fn insert_webhook_attachment(a: Allocator, inout ctx: Context, job: i64, room: i64, bot: i64, key: []u8, filename: str, type: []u8, data: []u8, body: []u8) !i64 {
    const client = model.uuid(a, ctx.rng)
    defer a.free(client)
    const id = try model.write_message(a, ctx.db, ctx.clock, room, bot, true, body, client)
    var stamp: Buf(u8) = .empty
    defer a.free(stamp)
    tf.db_time(a, &stamp, ctx.clock.now())
    const digest = crypto.md5(a, data)
    defer a.free(digest)
    var checksum: Buf(u8) = .empty
    defer a.free(checksum)
    codec.base64_encode(a, &checksum, digest)
    var st = try ctx.db.prepare("INSERT INTO active_storage_blobs (key, filename, content_type, metadata, service_name, byte_size, created_at, checksum) VALUES (?, ?, ?, '{}', 'local', ?, ?, ?)")
    defer st.finalize()
    try st.bind(1, key)
    try st.bind(2, filename)
    try st.bind(3, type)
    try st.bind_int(4, @len(data))
    try st.bind(5, stamp)
    try st.bind(6, checksum)
    while (try st.next()) {}
    const blob = ctx.db.last_id()
    var attach = try ctx.db.prepare("INSERT INTO active_storage_attachments (name, record_type, record_id, blob_id, created_at) VALUES ('attachment', 'Message', ?, ?, ?)")
    defer attach.finalize()
    try attach.bind_int(1, id)
    try attach.bind_int(2, blob)
    try attach.bind(3, stamp)
    while (try attach.next()) {}
    try push.queue(ctx.db, id)
    try finish_webhook(ctx.db, job)
    return id
}
fn download_attachment(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    const user = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse { return to_sign_in(c, a, req) }
    const key = req.path[@len("/attachments/")..]
    if (@len(key) < 4 or text.contains(key, "/") or text.contains(key, ".")) { return not_found(c, a, req) }
    var st = try ctx.db.prepare("SELECT b.content_type, p.key, b.filename FROM active_storage_blobs b JOIN active_storage_attachments att ON att.blob_id=b.id AND att.record_type='Message' JOIN messages m ON m.id=att.record_id JOIN memberships ms ON ms.room_id=m.room_id AND ms.user_id=? LEFT JOIN egg_blob_previews p ON p.blob_id=b.id WHERE b.key=? AND ms.involvement!='invisible' LIMIT 1")
    defer st.finalize()
    try st.bind_int(1, user)
    try st.bind(2, key)
    if (!try st.next()) { return not_found(c, a, req) }
    const raw_type = st.text(a, 0)
    defer a.free(raw_type)
    const preview = st.text(a, 1)
    defer a.free(preview)
    const want_preview = text.contains(req.query, "preview=1")
    if (want_preview and @len(preview) == 0) { return not_found(c, a, req) }
    const type = if (want_preview) a.concat("image/webp", "") else safe_attachment_type(a, raw_type)
    defer a.free(type)
    const path = if (want_preview) uploads.path(a, ctx.files, preview) else uploads.path(a, ctx.files, key)
    defer a.free(path)
    const data = ctx.fs.read(a, path) catch { return not_found(c, a, req) }
    defer a.free(data)
    const inline = want_preview or (text.contains(req.query, "inline=1") and (type == "image/png" or type == "image/jpeg" or type == "image/gif" or type == "image/webp" or text.starts_with(type, "video/") or text.starts_with(type, "audio/")))
    const filename = st.text(a, 2)
    defer a.free(filename)
    var escaped: Buf(u8) = .empty
    defer a.free(escaped)
    codec.escape(a, &escaped, filename)
    var encoded: Buf(u8) = .empty
    defer a.free(encoded)
    for (escaped) |ch| {
        if (ch == '+') { a.append_str(&encoded, "%20") } else { a.push(&encoded, ch) }
    }
    const headers = a.concat("Content-Type: ", type, "\r\nContent-Disposition: ", if (inline) "inline" else "attachment", "; filename*=UTF-8''", encoded, "\r\nX-Content-Type-Options: nosniff\r\nCache-Control: private\r\n")
    defer a.free(headers)
    return http.file_response(c, a, req, headers, data)
}

fn write_webhook_text(a: Allocator, inout ctx: Context, job: i64, room: i64, bot: i64, body: []u8) !i64 {
    const client = model.uuid(a, ctx.rng)
    defer a.free(client)
    try ctx.db.exec("BEGIN IMMEDIATE")
    const id = model.write_message(a, ctx.db, ctx.clock, room, bot, true, body, client) catch |e| {
        ctx.db.exec("ROLLBACK") catch {}
        return e
    }
    push.queue(ctx.db, id) catch |e| {
        ctx.db.exec("ROLLBACK") catch {}
        return e
    }
    finish_webhook(ctx.db, job) catch |e| {
        ctx.db.exec("ROLLBACK") catch {}
        return e
    }
    try ctx.db.exec("COMMIT")
    return id
}

fn account_id(db: sqlite.Db) !i64 {
    var st = try db.prepare("SELECT id FROM accounts ORDER BY id LIMIT 1")
    defer st.finalize()
    if (!try st.next()) { return error.Sql }
    return st.int(0)
}
fn upload_picture(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, upload: http.Upload, record: str, id: i64, name: str, location: str) !void {
    var picture = uploads.picture(a, ctx.fs, ctx.rng, ctx.files, upload.data) catch {
        return http.respond(c, a, req, "422 Unprocessable Content", HTML, "Please choose a valid PNG, JPEG, GIF or WebP image.")
    }
    defer a.free(picture)
    var small_key: Buf(u8) = .empty
    defer a.free(small_key)
    if (record == "Account") {
        const small = try uploads.icon(a, ctx.fs, ctx.rng, ctx.files, picture, 192)
        defer a.free(small)
        a.free(@replace(&small_key, try uploads.write(a, ctx.fs, ctx.rng, ctx.files, small)))
        const large = try uploads.icon(a, ctx.fs, ctx.rng, ctx.files, picture, 512)
        a.free(@replace(&picture, large))
    }
    const key = try uploads.write(a, ctx.fs, ctx.rng, ctx.files, picture)
    defer a.free(key)
    _ = ctx.lock_rx.recv()
    uploads.replace_picture(a, ctx.db, ctx.clock, record, id, name, key, picture, small_key) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    ctx.lock_tx.send(true)
    return redirect_notice(c, a, &ctx, req, location, "Image updated")
}
fn uploaded_avatar(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, user: i64) !void {
    var st = try ctx.db.prepare("SELECT b.key FROM active_storage_blobs b JOIN active_storage_attachments att ON att.blob_id=b.id WHERE att.record_type='User' AND att.record_id=? AND att.name='avatar' LIMIT 1")
    defer st.finalize()
    try st.bind_int(1, user)
    if (!try st.next()) { return drawn_avatar(c, a, &ctx, req, user) }
    const key = st.text(a, 0)
    defer a.free(key)
    return picture_file(c, a, &ctx, req, key, "image/webp")
}
fn picture_file(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, key: []u8, mime: []u8) !void {
    const path = uploads.path(a, ctx.files, key)
    defer a.free(path)
    const data = ctx.fs.read(a, path) catch { return not_found(c, a, req) }
    defer a.free(data)
    const headers = a.concat("Content-Type: ", mime, "\r\nCache-Control: public, max-age=300\r\nX-Content-Type-Options: nosniff\r\n")
    defer a.free(headers)
    return http.respond(c, a, req, "200 OK", headers, data)
}
fn upload_message(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, room: model.RoomView, user: i64, upload: http.Upload) !void {
    if (@len(upload.data) == 0 or @len(upload.filename) == 0 or @len(upload.filename) > 255) { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "Invalid attachment") }
    const key = try uploads.write(a, ctx.fs, ctx.rng, ctx.files, upload.data)
    defer a.free(key)
    var preview: Buf(u8) = .empty
    defer a.free(preview)
    if (media.image_format(upload.data)) |format| {
        _ = format
        const picture = uploads.picture(a, ctx.fs, ctx.rng, ctx.files, upload.data) catch { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "Invalid image") }
        defer a.free(picture)
        a.free(@replace(&preview, try uploads.write(a, ctx.fs, ctx.rng, ctx.files, picture)))
    }
    if (media.video_format(upload.data)) |format| {
        const original = uploads.path(a, ctx.files, key)
        defer a.free(original)
        const thumbnail = a.concat(original, ".png")
        defer a.free(thumbnail)
        defer ctx.fs.remove_file(thumbnail) catch {}
        media.video(a, original, thumbnail, format) catch {}
        const picture = ctx.fs.read(a, thumbnail) catch a.concat("", "")
        defer a.free(picture)
        if (@len(picture) > 0) {
            const webp = try uploads.picture(a, ctx.fs, ctx.rng, ctx.files, picture)
            defer a.free(webp)
            a.free(@replace(&preview, try uploads.write(a, ctx.fs, ctx.rng, ctx.files, webp)))
        }
    }
    const body = http.field(a, req, "message[body]") orelse attachment_caption(a, upload.filename)
    defer a.free(body)
    const client = http.field(a, req, "message[client_message_id]") orelse model.uuid(a, ctx.rng)
    defer a.free(client)
    const mime = safe_attachment_type(a, upload.content_type)
    defer a.free(mime)
    _ = ctx.lock_rx.recv()
    const id = write_user_attachment(a, &ctx, room.id, user, upload, key, preview, mime, body, client) catch |e| {
        ctx.lock_tx.send(true)
        return e
    }
    ctx.lock_tx.send(true)
    return send_created_message(c, a, &ctx, req, room, id)
}
fn write_user_attachment(a: Allocator, inout ctx: Context, room: i64, user: i64, upload: http.Upload, key: []u8, preview: []u8, mime: []u8, body: []u8, client: []u8) !i64 {
    try ctx.db.exec("BEGIN IMMEDIATE")
    const id = insert_user_attachment(a, &ctx, room, user, upload, key, preview, mime, body, client) catch |e| {
        ctx.db.exec("ROLLBACK") catch {}
        return e
    }
    try ctx.db.exec("COMMIT")
    return id
}
fn insert_user_attachment(a: Allocator, inout ctx: Context, room: i64, user: i64, upload: http.Upload, key: []u8, preview: []u8, mime: []u8, body: []u8, client: []u8) !i64 {
    const id = try model.write_message(a, ctx.db, ctx.clock, room, user, true, body, client)
    const blob = try uploads.blob(a, ctx.db, ctx.clock, key, upload.filename, mime, upload.data)
    try uploads.attach(ctx.db, "Message", id, "attachment", blob)
    if (@len(preview) > 0) {
        var st = try ctx.db.prepare("INSERT INTO egg_blob_previews (blob_id, key) VALUES (?, ?)")
        defer st.finalize()
        try st.bind_int(1, blob)
        try st.bind(2, preview)
        while (try st.next()) {}
    }
    try bot_hooks.enqueue(a, ctx.db, ctx.mention_key, id)
    try push.queue(ctx.db, id)
    return id
}

fn redirect_notice(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request, location: []u8, notice: str) !void {
    var headers: Buf(u8) = .empty
    defer a.free(headers)
    a.append_str(&headers, "Location: ")
    a.append_str(&headers, location)
    a.append_str(&headers, "\r\n")
    flash.set(a, &headers, ctx.flash_key, ctx.rng, ctx.clock, notice)
    return http.respond(c, a, req, "302 Found", headers, "")
}
fn flash_notice(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    const message = flash.consume(a, ctx.flash_key, req.cookie, ctx.clock)
    defer a.free(message)
    var body: Buf(u8) = .empty
    defer a.free(body)
    json.encode_plain(a, &body, message)
    return http.respond(c, a, req, "200 OK", "Content-Type: application/json\r\nCache-Control: no-store\r\nSet-Cookie: campfire_flash=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0\r\n", body)
}
// One round of the push worker: queued messages made into notifications
// and a batch of due notifications sent, reading and sending outside the
// write lock, then all of it written in one turn at the lock. False if
// there was nothing to do.
fn deliver_push(a: Allocator, inout ctx: Context) !bool {
    var ids: Buf(i64) = .empty
    defer a.free(ids)
    try push.queued(a, ctx.db, &ids)
    var planned: Buf(push.Planned) = .empty
    defer a.free(planned)
    var k = 0
    while (k < @len(ids)) {
        try push.plan(a, ctx.db, ctx.mention_key, ids[k], &planned)
        k = k + 1
    }
    var jobs: Buf(push.Job) = .empty
    defer a.free(jobs)
    try push.next_jobs(a, ctx.db, ctx.clock, &jobs)
    if (@len(ids) == 0 and @len(jobs) == 0) { return false }
    var statuses: Buf(i64) = .empty
    defer a.free(statuses)
    var j = 0
    while (j < @len(jobs)) {
        var public_bytes: Buf(u8) = .empty
        defer a.free(public_bytes)
        var auth: Buf(u8) = .empty
        defer a.free(auth)
        var status: i64 = 400
        if (jobs[j].valid_source and @len(jobs[j].endpoint) > 0 and codec.base64_decode(a, &public_bytes, jobs[j].public_key) and codec.base64_decode(a, &auth, jobs[j].auth)) {
            status = push.send(a, ctx.clock, jobs[j].endpoint, public_bytes, auth, jobs[j].payload, ctx.push_private, ctx.vapid, ctx.push_subject, ctx.push_allow_local) catch 400
        }
        a.push(&statuses, status)
        j = j + 1
    }
    _ = ctx.lock_rx.recv()
    push_round(ctx.db, ctx.clock, ids, planned, jobs, statuses) catch |e| {
        ctx.db.exec("ROLLBACK") catch {}
        ctx.lock_tx.send(true)
        return e
    }
    ctx.lock_tx.send(true)
    return true
}
fn push_round(db: sqlite.Db, clock: Clock, ids: Buf(i64), planned: Buf(push.Planned), jobs: Buf(push.Job), statuses: Buf(i64)) !void {
    try db.exec("BEGIN IMMEDIATE")
    try push.store(db, ids, planned)
    var i = 0
    while (i < @len(jobs)) {
        try push.finish(db, clock, jobs[i].id, jobs[i].subscription, statuses[i], jobs[i].attempts)
        i = i + 1
    }
    try db.exec("COMMIT")
}
fn push_subscriptions(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    const user = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse { return to_sign_in(c, a, req) }
    const prefix = "/users/me/push_subscriptions"
    if (req.path == prefix and req.method == "POST") {
        const root = json.member(a, req.body, "push_subscription") orelse a.concat(req.body, "")
        defer a.free(root)
        const endpoint = json.member(a, root, "endpoint") orelse { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
        defer a.free(endpoint)
        const public_key = json.member(a, root, "p256dh_key") orelse { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
        defer a.free(public_key)
        const auth_key = json.member(a, root, "auth_key") orelse { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
        defer a.free(auth_key)
        var public_bytes: Buf(u8) = .empty
        defer a.free(public_bytes)
        var auth: Buf(u8) = .empty
        defer a.free(auth)
        if (!codec.base64_decode(a, &public_bytes, public_key) or !codec.base64_decode(a, &auth, auth_key) or !push.valid(a, endpoint, public_bytes, auth, ctx.push_allow_local)) { return http.respond(c, a, req, "422 Unprocessable Content", HTML, "") }
        _ = ctx.lock_rx.recv()
        save_push(ctx.db, user, endpoint, public_key, auth_key, req.user_agent) catch |e| { ctx.lock_tx.send(true)
            return e }
        ctx.lock_tx.send(true)
        return http.respond(c, a, req, "200 OK", "Content-Type: text/vnd.turbo-stream.html\r\n", "")
    }
    if (text.starts_with(req.path, "/users/me/push_subscriptions/")) {
        const rest = req.path[@len(prefix) + 1..]
        const slash = text.find(rest, "/") orelse @len(rest)
        const id = text.parse_int(rest[0..slash]) orelse { return not_found(c, a, req) }
        var own = try ctx.db.prepare("SELECT 1 FROM push_subscriptions WHERE id=? AND user_id=?")
        defer own.finalize()
        try own.bind_int(1, id)
        try own.bind_int(2, user)
        if (!try own.next()) { return not_found(c, a, req) }
        if (slash < @len(rest) and rest[slash..] == "/test_notifications" and req.method == "POST") {
            _ = ctx.lock_rx.recv()
            enqueue_test_push(ctx.db, id) catch |e| { ctx.lock_tx.send(true)
                return e }
            ctx.lock_tx.send(true)
            return redirect_notice(c, a, &ctx, req, prefix, "Test notification queued")
        }
        if (slash == @len(rest) and (req.method == "DELETE" or req.method == "POST")) {
            _ = ctx.lock_rx.recv()
            remove_push(ctx.db, user, id) catch |e| { ctx.lock_tx.send(true)
                return e }
            ctx.lock_tx.send(true)
            return redirect_notice(c, a, &ctx, req, prefix, "Notification subscription removed")
        }
        return not_found(c, a, req)
    }
    if (req.method != "GET") { return not_found(c, a, req) }
    const view = try model.find_user(a, ctx.db, ctx.sid_key, user) orelse { return to_sign_in(c, a, req) }
    defer view.deinit(a)
    var body: Buf(u8) = .empty
    defer a.free(body)
    var logo: Buf(u8) = .empty
    defer a.free(logo)
    try logo_stamp(a, &logo, ctx.db)
    const css = try custom_css(a, ctx.db)
    defer a.free(css)
    views.app_top(a, &body, "Notifications", view, ctx.vapid, logo, css, "", try administrator(ctx.db, user), "", "<a href=\"/users/me/profile\">Profile</a>")
    a.append_str(&body, "<section class=\"panel\"><h1>Notifications</h1>")
    var subscriptions = try ctx.db.prepare("SELECT id, user_agent FROM push_subscriptions WHERE user_id=? ORDER BY id")
    defer subscriptions.finalize()
    try subscriptions.bind_int(1, user)
    while (try subscriptions.next()) {
        const agent = subscriptions.text(a, 1)
        defer a.free(agent)
        a.append_str(&body, "<div><p>")
        html.escape(a, &body, agent)
        a.append_str(&body, "</p><form method=\"post\" action=\"/users/me/push_subscriptions/")
        a.append_int(&body, subscriptions.int(0))
        a.append_str(&body, "/test_notifications\"><button class=\"btn\">Send test notification</button></form><form method=\"post\" action=\"/users/me/push_subscriptions/")
        a.append_int(&body, subscriptions.int(0))
        a.append_str(&body, "\"><input type=\"hidden\" name=\"_method\" value=\"delete\" /><button class=\"btn\">Remove</button></form></div>")
    }
    a.append_str(&body, "</section>")
    views.app_bottom(a, &body, "", "")
    return http.respond(c, a, req, "200 OK", HTML, body)
}
fn save_push(db: sqlite.Db, user: i64, endpoint: []u8, public_key: []u8, auth: []u8, agent: []u8) !void {
    var existing = try db.prepare("SELECT id FROM push_subscriptions WHERE user_id=? AND endpoint=? AND p256dh_key=? AND auth_key=? LIMIT 1")
    defer existing.finalize()
    try existing.bind_int(1, user)
    try existing.bind(2, endpoint)
    try existing.bind(3, public_key)
    try existing.bind(4, auth)
    if (try existing.next()) { return }
    var st = try db.prepare("INSERT INTO push_subscriptions (user_id, endpoint, p256dh_key, auth_key, user_agent, created_at, updated_at) VALUES (?, ?, ?, ?, ?, STRFTIME('%Y-%m-%d %H:%M:%f','NOW'), STRFTIME('%Y-%m-%d %H:%M:%f','NOW'))")
    defer st.finalize()
    try st.bind_int(1, user)
    try st.bind(2, endpoint)
    try st.bind(3, public_key)
    try st.bind(4, auth)
    try st.bind(5, agent)
    while (try st.next()) {}
}
fn remove_push(db: sqlite.Db, user: i64, id: i64) !void {
    var st = try db.prepare("DELETE FROM push_subscriptions WHERE user_id=? AND id=?")
    defer st.finalize()
    try st.bind_int(1, user)
    try st.bind_int(2, id)
    while (try st.next()) {}
}
fn enqueue_test_push(db: sqlite.Db, id: i64) !void {
    var st = try db.prepare("INSERT INTO egg_push_jobs (subscription_id, payload) VALUES (?, '{\"title\":\"Campfire Test\",\"options\":{\"body\":\"Notifications enabled\",\"data\":{\"path\":\"/users/me/push_subscriptions\",\"badge\":0}}}')")
    defer st.finalize()
    try st.bind_int(1, id)
    while (try st.next()) {}
}

fn unfurl_link(c: TcpConn, a: Allocator, inout ctx: Context, req: http.Request) !void {
    _ = try session.current_user(a, ctx.db, ctx.key, ctx.clock, req.cookie) orelse { return to_sign_in(c, a, req) }
    const url = json.member(a, req.body, "url") orelse (http.field(a, req, "url") orelse { return http.respond(c, a, req, "204 No Content", "", "") })
    defer a.free(url)
    if (@len(url) > 2048 or (!text.starts_with(url, "https://") and !text.starts_with(url, "http://"))) { return http.respond(c, a, req, "204 No Content", "", "") }
    const fetched = try webhook_http.get(a, url)
    defer fetched.deinit(a)
    if (fetched.code != 0 or fetched.status != 200 or !text.starts_with(fetched.content_type, "text/html")) { return http.respond(c, a, req, "204 No Content", "", "") }
    var title = uploads.metadata(a, fetched.body, "og:title")
    defer a.free(title)
    if (@len(title) == 0) {
        const begin = text.find(fetched.body, "<title>") orelse -1
        if (begin >= 0) {
            const end = text.find_from(fetched.body, "</title>", begin) orelse begin
            if (end > begin) { a.free(@replace(&title, richtext.plain_text(a, fetched.body[begin + 7..end]))) }
        }
    }
    if (@len(title) == 0) { return http.respond(c, a, req, "204 No Content", "", "") }
    const description = uploads.metadata(a, fetched.body, "og:description")
    defer a.free(description)
    var body: Buf(u8) = .empty
    defer a.free(body)
    a.append_str(&body, "{\"title\":")
    json.encode_plain(a, &body, title)
    a.append_str(&body, ",\"url\":")
    json.encode_plain(a, &body, url)
    a.append_str(&body, ",\"description\":")
    json.encode_plain(a, &body, description)
    a.append_str(&body, ",\"image\":null}")
    return http.respond(c, a, req, "200 OK", "Content-Type: application/json\r\n", body)
}

fn attachment_caption(a: Allocator, filename: []u8) Buf(u8) {
    var out: Buf(u8) = .empty
    html.escape(a, &out, filename)
    return out
}
